+import { expect, test } from "vitest";
+import { resolveAgentTabLabel } from "./agent-tab-label";
+test("live attached tasks have a stable title before any generated title exists", () => {
+  for (const title of [null, undefined, "", "  ", "New agent"])
+    expect(resolveAgentTabLabel(title, "gentle-live")).toBe("Live Gentle Shell");
+  expect(resolveAgentTabLabel("My task", "gentle-live")).toBe("My task");
+  expect(resolveAgentTabLabel(null, "pi")).toBeNull();

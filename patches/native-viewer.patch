index 0000000000000000000000000000000000000000..3e3e19437ded47363b2dae2dfa82a331bbcf6f4b
--- /dev/null
+++ b/packages/app/src/terminal/runtime/terminal-mobile-font-preset.test.ts
@@ -0,0 +1,122 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  loadTerminalMobileFontPreset,
+  resolveTerminalMobileFontPresetTransition,
+  resolveTerminalMobileFontSize,
+  saveTerminalMobileFontPreset,
+  TERMINAL_MOBILE_FONT_PRESET_STORAGE_KEY,
+  type TerminalMobileFontPresetStorage,
+} from "./terminal-mobile-font-preset";
+
+function createStorage(initialValue: string | null = null): TerminalMobileFontPresetStorage & {
+  values: Map<string, string>;
+} {
+  const values = new Map<string, string>();
+  if (initialValue !== null) {
+    values.set(TERMINAL_MOBILE_FONT_PRESET_STORAGE_KEY, initialValue);
+  }
+  return {
+    values,
+    async getItem(key) {
+      return values.get(key) ?? null;
+    },
+    async setItem(key, value) {
+      values.set(key, value);
+    },
+  };
+}
+
+describe("mobile terminal font presets", () => {
+  it("uses the configured code size for the readable/reset preset (issue #1)", () => {
+    expect(
+      resolveTerminalMobileFontSize({
+        preset: "readable",
+        baseFontSize: 14,
+        viewportWidth: 430,
+        viewportHeight: 932,
+        keyboardInset: 0,
+      }),
+    ).toBe(14);
+  });
+
+  it("fits more columns at a readable floor in iPhone portrait", () => {
+    expect(
+      resolveTerminalMobileFontSize({
+        preset: "fit",
+        baseFontSize: 14,
+        viewportWidth: 430,
+        viewportHeight: 932,
+        keyboardInset: 0,
+      }),
+    ).toBe(9);
+  });
+
+  it("keeps portrait fit stable while the software keyboard reduces usable height", () => {
+    expect(
+      resolveTerminalMobileFontSize({
+        preset: "fit",
+        baseFontSize: 14,
+        viewportWidth: 430,
+        viewportHeight: 560,
+        keyboardInset: 372,
+      }),
+    ).toBe(9);
+  });
+
+  it("uses the more readable fit size in landscape", () => {
+    expect(
+      resolveTerminalMobileFontSize({
+        preset: "fit",
+        baseFontSize: 14,
+        viewportWidth: 932,
+        viewportHeight: 430,
+        keyboardInset: 0,
+      }),
+    ).toBe(10);
+  });
+
+  it("claims the active device size only for a real preset change (issue #4)", () => {
+    expect(
+      resolveTerminalMobileFontPresetTransition({
+        currentPreset: "readable",
+        nextPreset: "fit",
+        canClaimSize: true,
+      }),
+    ).toEqual({ changed: true, shouldClaimSize: true });
+    expect(
+      resolveTerminalMobileFontPresetTransition({
+        currentPreset: "readable",
+        nextPreset: "fit",
+        canClaimSize: false,
+      }),
+    ).toEqual({ changed: true, shouldClaimSize: false });
+    expect(
+      resolveTerminalMobileFontPresetTransition({
+        currentPreset: "fit",
+        nextPreset: "fit",
+        canClaimSize: true,
+      }),
+    ).toEqual({ changed: false, shouldClaimSize: false });
+  });
+
+  it("retains the selected preset in device-local storage", async () => {
+    const storage = createStorage();
+
+    expect(await loadTerminalMobileFontPreset(storage)).toBe("readable");
+    await saveTerminalMobileFontPreset("fit", storage);
+    expect(await loadTerminalMobileFontPreset(storage)).toBe("fit");
+  });
+
+  it("falls back to readable for unknown or unavailable stored values", async () => {
+    expect(await loadTerminalMobileFontPreset(createStorage("unknown"))).toBe("readable");
+    await expect(
+      loadTerminalMobileFontPreset({
+        getItem: async () => {
+          throw new Error("unavailable");
+        },
+        setItem: async () => {},
+      }),
+    ).resolves.toBe("readable");
+  });
+});
diff --git a/packages/app/src/terminal/runtime/terminal-mobile-font-preset.ts b/packages/app/src/terminal/runtime/terminal-mobile-font-preset.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dcedbe45c6c449919dbc9fd9a3c429595329985b
--- /dev/null
+++ b/packages/app/src/terminal/runtime/terminal-mobile-font-preset.ts
@@ -0,0 +1,72 @@
+import AsyncStorage from "@react-native-async-storage/async-storage";
+
+export type TerminalMobileFontPreset = "readable" | "fit";
+
+export interface TerminalMobileFontPresetStorage {
+  getItem(key: string): Promise<string | null>;
+  setItem(key: string, value: string): Promise<void>;
+}
+
+export interface TerminalMobileFontSizeInput {
+  preset: TerminalMobileFontPreset;
+  baseFontSize: number;
+  viewportWidth: number;
+  viewportHeight: number;
+  keyboardInset: number;
+}
+
+export interface TerminalMobileFontPresetTransition {
+  changed: boolean;
+  shouldClaimSize: boolean;
+}
+
+export const TERMINAL_MOBILE_FONT_PRESET_STORAGE_KEY = "@aigo:terminal-mobile-font-preset:v1";
+export const TERMINAL_MOBILE_FIT_FONT_SIZE_PORTRAIT = 9;
+export const TERMINAL_MOBILE_FIT_FONT_SIZE_LANDSCAPE = 10;
+
+export function resolveTerminalMobileFontSize(input: TerminalMobileFontSizeInput): number {
+  if (input.preset === "readable") {
+    return input.baseFontSize;
+  }
+
+  // Some native layouts subtract the software keyboard from viewport height.
+  // Add it back before deciding orientation so opening the keyboard cannot
+  // silently switch the user's font preset.
+  const fullViewportHeight = input.viewportHeight + Math.max(0, input.keyboardInset);
+  const fitFontSize =
+    input.viewportWidth > fullViewportHeight
+      ? TERMINAL_MOBILE_FIT_FONT_SIZE_LANDSCAPE
+      : TERMINAL_MOBILE_FIT_FONT_SIZE_PORTRAIT;
+  return Math.min(input.baseFontSize, fitFontSize);
+}
+
+export function resolveTerminalMobileFontPresetTransition(input: {
+  currentPreset: TerminalMobileFontPreset;
+  nextPreset: TerminalMobileFontPreset;
+  canClaimSize: boolean;
+}): TerminalMobileFontPresetTransition {
+  const changed = input.currentPreset !== input.nextPreset;
+  return {
+    changed,
+    shouldClaimSize: changed && input.canClaimSize,
+  };
+}
+
+export async function loadTerminalMobileFontPreset(
+  storage: TerminalMobileFontPresetStorage = AsyncStorage,
+): Promise<TerminalMobileFontPreset> {
+  try {
+    return (await storage.getItem(TERMINAL_MOBILE_FONT_PRESET_STORAGE_KEY)) === "fit"
+      ? "fit"
+      : "readable";
+  } catch {
+    return "readable";
+  }
+}
+
+export async function saveTerminalMobileFontPreset(
+  preset: TerminalMobileFontPreset,
+  storage: TerminalMobileFontPresetStorage = AsyncStorage,
+): Promise<void> {
+  await storage.setItem(TERMINAL_MOBILE_FONT_PRESET_STORAGE_KEY, preset);
+}
diff --git a/packages/app/src/terminal/runtime/terminal-mobile-layout.browser.test.ts b/packages/app/src/terminal/runtime/terminal-mobile-layout.browser.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..31a53992355a5ee2b899ebfef31c5f0dab76c20a
--- /dev/null
+++ b/packages/app/src/terminal/runtime/terminal-mobile-layout.browser.test.ts
@@ -0,0 +1,135 @@
+import { page } from "vitest/browser";
+import { afterEach, describe, expect, it } from "vitest";
+
+import { TerminalEmulatorRuntime } from "./terminal-emulator-runtime";
+
+interface ResizeEvent {
+  rows: number;
+  cols: number;
+  shouldClaim: boolean;
+  forceClaim?: boolean;
+}
+
+interface MountedTerminal {
+  root: HTMLDivElement;
+  runtime: TerminalEmulatorRuntime;
+  resizeEvents: ResizeEvent[];
+}
+
+const mounted: MountedTerminal[] = [];
+
+function nextFrame(): Promise<void> {
+  return new Promise((resolve) => requestAnimationFrame(() => resolve()));
+}
+
+async function waitFor(predicate: () => boolean, timeoutMs = 4000): Promise<void> {
+  const start = performance.now();
+  while (!predicate()) {
+    if (performance.now() - start > timeoutMs) {
+      throw new Error("timeout waiting for terminal resize");
+    }
+    await nextFrame();
+  }
+}
+
+function mountTerminal(width: number, height: number): MountedTerminal {
+  const root = document.createElement("div");
+  root.style.cssText = `width:${width}px;height:${height}px;position:fixed;left:0;top:0;overflow:hidden`;
+  const host = document.createElement("div");
+  host.style.cssText = "width:100%;height:100%";
+  root.appendChild(host);
+  document.body.appendChild(root);
+
+  const resizeEvents: ResizeEvent[] = [];
+  const runtime = new TerminalEmulatorRuntime();
+  runtime.setCallbacks({
+    callbacks: {
+      onResize: (event) => {
+        resizeEvents.push(event);
+      },
+    },
+  });
+  runtime.mount({
+    root,
+    host,
+    initialSnapshot: null,
+    scrollback: 1_000,
+    theme: { background: "#0b0b0b", foreground: "#e6e6e6", cursor: "#e6e6e6" },
+  });
+
+  const result = { root, runtime, resizeEvents };
+  mounted.push(result);
+  return result;
+}
+
+afterEach(() => {
+  for (const item of mounted.splice(0)) {
+    item.runtime.unmount();
+    item.root.remove();
+  }
+});
+
+describe("mobile terminal viewport fitting", () => {
+  it("refits and can reclaim size when rotating from portrait to landscape", async () => {
+    await page.viewport(390, 844);
+    const item = mountTerminal(360, 600);
+    await waitFor(() => item.resizeEvents.length > 0);
+    const portrait = item.resizeEvents.at(-1);
+    expect(portrait).toBeDefined();
+
+    await page.viewport(844, 390);
+    item.root.style.width = "814px";
+    item.root.style.height = "280px";
+    window.dispatchEvent(new Event("resize"));
+    await waitFor(() => (item.resizeEvents.at(-1)?.cols ?? 0) > (portrait?.cols ?? 0));
+    const landscape = item.resizeEvents.at(-1);
+
+    expect(landscape?.cols).toBeGreaterThan(portrait?.cols ?? 0);
+    expect(landscape?.rows).toBeLessThan(portrait?.rows ?? 0);
+
+    item.runtime.resize({ shouldClaim: true, forceClaim: true });
+    await waitFor(() => item.resizeEvents.at(-1)?.forceClaim === true);
+    expect(item.resizeEvents.at(-1)).toMatchObject({
+      rows: landscape?.rows,
+      cols: landscape?.cols,
+      shouldClaim: true,
+      forceClaim: true,
+    });
+  });
+
+  it("reflows readable and fit presets across keyboard and orientation changes", async () => {
+    await page.viewport(430, 932);
+    const item = mountTerminal(400, 700);
+    item.runtime.setFont({ fontSize: 14 });
+    await waitFor(() => item.resizeEvents.length > 0);
+    const readablePortrait = item.resizeEvents.at(-1);
+    expect(readablePortrait).toBeDefined();
+
+    item.runtime.setFont({ fontSize: 9 });
+    await waitFor(() => (item.resizeEvents.at(-1)?.cols ?? 0) > (readablePortrait?.cols ?? 0));
+    const fitPortrait = item.resizeEvents.at(-1);
+
+    item.root.style.height = "390px";
+    window.dispatchEvent(new Event("resize"));
+    await waitFor(() => (item.resizeEvents.at(-1)?.rows ?? 0) < (fitPortrait?.rows ?? 0));
+    const fitWithKeyboard = item.resizeEvents.at(-1);
+    expect(fitWithKeyboard?.cols).toBe(fitPortrait?.cols);
+
+    item.runtime.resize({ shouldClaim: true, forceClaim: true });
+    await waitFor(() => item.resizeEvents.at(-1)?.shouldClaim === true);
+    expect(item.resizeEvents.at(-1)).toMatchObject({
+      rows: fitWithKeyboard?.rows,
+      cols: fitWithKeyboard?.cols,
+      shouldClaim: true,
+      forceClaim: true,
+    });
+
+    await page.viewport(932, 430);
+    item.root.style.width = "902px";
+    item.root.style.height = "300px";
+    item.runtime.setFont({ fontSize: 10 });
+    window.dispatchEvent(new Event("resize"));
+    await waitFor(() => (item.resizeEvents.at(-1)?.cols ?? 0) > (fitPortrait?.cols ?? 0));
+    expect(item.resizeEvents.at(-1)?.cols).toBeGreaterThan(fitPortrait?.cols ?? 0);
+  });
+});

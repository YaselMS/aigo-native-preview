+import React from "react";
+import { Text, View } from "react-native";
+import { Button } from "@/components/ui/button";
+import { useTranslation } from "react-i18next";
+import { StyleSheet } from "react-native-unistyles";
+import type { PermissionResponseOutcome } from "./permission-response";
+
+export function PermissionResponseFeedback({
+  status,
+  onCheckStatus,
+}: {
+  status: PermissionResponseOutcome | "pending";
+  onCheckStatus: () => void;
+}) {
+  const { t } = useTranslation();
+  if (status === "ready") return null;
+  return (
+    <View style={styles.container} testID="permission-response-feedback">
+      <Text accessibilityRole="alert" style={styles.message}>
+        {t(`agentStream.permission.response.${status}`)}
+      </Text>
+      {status === "uncertain" || status === "unavailable" ? (
+        <Button
+          variant="outline"
+          size="sm"
+          onPress={onCheckStatus}
+          style={styles.button}
+          testID="permission-response-check"
+        >
+          {t("agentStream.permission.response.check")}
+        </Button>
+      ) : null}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  container: { gap: theme.spacing[2] },
+  message: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.base },
+  button: { alignSelf: "flex-start" },
+}));

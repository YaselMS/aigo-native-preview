new file mode 100644
--- /dev/null
+++ b/packages/app/src/agent-stream/permission-response.test.ts
@@ -0,0 +1,168 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { reconcilePermissionResponse, type PermissionResponseClient } from "./permission-response";
+
+function fixture(serverId: string) {
+  let pending = true;
+  let connected = true;
+  let failedRead = false;
+  let missingAgent = false;
+  const sent: unknown[] = [];
+  const client: PermissionResponseClient = {
+    get isConnected() {
+      return connected;
+    },
+    async fetchAgent() {
+      if (failedRead) throw new Error("Read failed");
+      if (missingAgent) return null;
+      return { agent: { pendingPermissions: pending ? [{ id: "request" }] : [] } } as NonNullable<
+        Awaited<ReturnType<PermissionResponseClient["fetchAgent"]>>
+      >;
+    },
+    async respondToPermissionAndWait(...args) {
+      sent.push(args);
+      throw new Error("Missing acknowledgement");
+    },
+  };
+  const input = { serverId, agentId: "agent", requestId: "request", client, timeoutMs: 500 };
+  return {
+    client,
+    input,
+    sent,
+    setPending(value: boolean) {
+      pending = value;
+    },
+    disconnect() {
+      connected = false;
+    },
+    failReads() {
+      failedRead = true;
+    },
+    removeAgent() {
+      missingAgent = true;
+    },
+  };
+}
+afterEach(() => vi.useRealTimers());
+
+describe("permission response reconciliation", () => {
+  it("does not coalesce identical agent/request ids across concurrent host operations", async () => {
+    vi.useFakeTimers();
+    const origin = fixture("concurrent-origin");
+    const destination = fixture("concurrent-destination");
+    const first = reconcilePermissionResponse({ ...origin.input, response: { behavior: "deny" } });
+    const second = reconcilePermissionResponse({
+      ...destination.input,
+      response: { behavior: "allow" },
+    });
+    expect(second).not.toBe(first);
+    await vi.advanceTimersByTimeAsync(500);
+    expect(await first).toBe("uncertain");
+    expect(await second).toBe("uncertain");
+    expect(origin.sent).toEqual([["agent", "request", { behavior: "deny" }, 500]]);
+    expect(destination.sent).toEqual([["agent", "request", { behavior: "allow" }, 500]]);
+    origin.setPending(false);
+    expect(await reconcilePermissionResponse(origin.input)).toBe("complete");
+    expect(await reconcilePermissionResponse(destination.input)).toBe("uncertain");
+  });
+
+  it("sends once and observes removal even without a resolution acknowledgement", async () => {
+    const f = fixture("missing-ack");
+    f.client.respondToPermissionAndWait = async (...args) => {
+      f.sent.push(args);
+      f.setPending(false);
+      throw new Error("No acknowledgement");
+    };
+    expect(await reconcilePermissionResponse({ ...f.input, response: { behavior: "allow" } })).toBe(
+      "complete",
+    );
+    expect(f.sent).toEqual([["agent", "request", { behavior: "allow" }, 500]]);
+  });
+
+  it("does not send an answer to an already resolved or missing request", async () => {
+    const f = fixture("stale");
+    f.setPending(false);
+    expect(await reconcilePermissionResponse({ ...f.input, response: { behavior: "allow" } })).toBe(
+      "stale",
+    );
+    f.removeAgent();
+    expect(await reconcilePermissionResponse({ ...f.input, response: { behavior: "allow" } })).toBe(
+      "stale",
+    );
+    expect(f.sent).toEqual([]);
+  });
+
+  it("does not infer resolution or send when preflight is offline or fails", async () => {
+    const offline = fixture("offline");
+    offline.disconnect();
+    expect(
+      await reconcilePermissionResponse({ ...offline.input, response: { behavior: "allow" } }),
+    ).toBe("unavailable");
+    expect(offline.sent).toEqual([]);
+    const failed = fixture("failed-read");
+    failed.failReads();
+    expect(
+      await reconcilePermissionResponse({ ...failed.input, response: { behavior: "allow" } }),
+    ).toBe("unavailable");
+    expect(failed.sent).toEqual([]);
+  });
+
+  it("coalesces double taps, reports uncertainty, and only reads on subsequent attempts", async () => {
+    vi.useFakeTimers();
+    const f = fixture("uncertain");
+    const first = reconcilePermissionResponse({ ...f.input, response: { behavior: "deny" } });
+    const second = reconcilePermissionResponse({ ...f.input, response: { behavior: "allow" } });
+    expect(second).toBe(first);
+    await vi.advanceTimersByTimeAsync(500);
+    expect(await first).toBe("uncertain");
+    expect(await reconcilePermissionResponse(f.input)).toBe("uncertain");
+    expect(await reconcilePermissionResponse({ ...f.input, response: { behavior: "allow" } })).toBe(
+      "uncertain",
+    );
+    f.setPending(false);
+    expect(await reconcilePermissionResponse(f.input)).toBe("complete");
+    expect(f.sent).toEqual([["agent", "request", { behavior: "deny" }, 500]]);
+  });
+
+  it("preserves uncertainty across disconnect and a replacement client", async () => {
+    const f = fixture("reconnected");
+    f.client.respondToPermissionAndWait = async (...args) => {
+      f.sent.push(args);
+      f.disconnect();
+      throw new Error("Disconnected");
+    };
+    expect(await reconcilePermissionResponse({ ...f.input, response: { behavior: "allow" } })).toBe(
+      "uncertain",
+    );
+    const replacement = fixture("reconnected");
+    expect(
+      await reconcilePermissionResponse({ ...replacement.input, response: { behavior: "allow" } }),
+    ).toBe("uncertain");
+    expect(replacement.sent).toEqual([]);
+    replacement.failReads();
+    expect(await reconcilePermissionResponse(replacement.input)).toBe("uncertain");
+  });
+
+  it("keeps identical request ids on different hosts independent", async () => {
+    const f = fixture("other-host");
+    f.client.respondToPermissionAndWait = async (...args) => {
+      f.sent.push(args);
+      f.setPending(false);
+      throw new Error("No acknowledgement");
+    };
+    expect(await reconcilePermissionResponse(f.input)).toBe("ready");
+    expect(
+      await reconcilePermissionResponse({
+        ...f.input,
+        response: { behavior: "allow", updatedInput: { answers: { Choice: "Final" } } },
+      }),
+    ).toBe("complete");
+    expect(f.sent).toEqual([
+      [
+        "agent",
+        "request",
+        { behavior: "allow", updatedInput: { answers: { Choice: "Final" } } },
+        500,
+      ],
+    ]);
+  });
+});

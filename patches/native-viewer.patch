diff --git a/packages/app/src/screens/settings/native-notification-diagnostic-section.tsx b/packages/app/src/screens/settings/native-notification-diagnostic-section.tsx
new file mode 100644
--- /dev/null
+++ b/packages/app/src/screens/settings/native-notification-diagnostic-section.tsx
@@ -0,0 +1,176 @@
+import { useEffect, useRef, useState } from "react";
+import { Platform, Text, View } from "react-native";
+import { useTranslation } from "react-i18next";
+import * as Application from "expo-application";
+import * as Clipboard from "expo-clipboard";
+import Constants from "expo-constants";
+import * as Notifications from "expo-notifications";
+import { Button } from "@/components/ui/button";
+import { useStableEvent } from "@/hooks/use-stable-event";
+import { SettingsSection } from "@/screens/settings/settings-section";
+import { settingsStyles } from "@/styles/settings";
+import { isPreviewNotificationDiagnosticEnabled } from "@/push-notifications/preview-diagnostic-enabled";
+import {
+  diagnosticError,
+  notificationDiagnosticReport,
+  PREVIEW_NOTIFICATION_TEST,
+  runNotificationDiagnostic,
+  type NotificationDiagnostic,
+} from "@/push-notifications/preview-diagnostic";
+
+type DiagnosticState =
+  | { status: "idle" }
+  | { status: "running"; phase: "permission" | "local" | "registration" }
+  | {
+      status: "complete";
+      diagnostic: NotificationDiagnostic;
+      copy: "idle" | "copying" | "copied" | "error";
+      copyError: string;
+    };
+
+export function NativeNotificationDiagnosticSection() {
+  const { t } = useTranslation();
+  const [state, setState] = useState<DiagnosticState>({ status: "idle" });
+  const activeRun = useRef<AbortController | null>(null);
+  useEffect(() => () => activeRun.current?.abort(), []);
+
+  async function run() {
+    if (activeRun.current && !activeRun.current.signal.aborted) return;
+    const controller = new AbortController();
+    activeRun.current = controller;
+    const diagnostic = await runNotificationDiagnostic({
+      api: Notifications,
+      signal: controller.signal,
+      onPhase: (phase) => setState({ status: "running", phase }),
+      notification: {
+        content: {
+          title: t("settings.notifications.nativeDiagnostic.notificationTitle"),
+          body: t("settings.notifications.nativeDiagnostic.notificationBody"),
+          sound: "default",
+          data: { aigoDiagnostic: PREVIEW_NOTIFICATION_TEST },
+        },
+        trigger: {
+          type: Notifications.SchedulableTriggerInputTypes.TIME_INTERVAL,
+          seconds: 15,
+          repeats: false,
+        },
+      },
+    });
+    if (!diagnostic) return;
+    controller.abort();
+    setState({ status: "complete", diagnostic, copy: "idle", copyError: "" });
+  }
+
+  function report(diagnostic: NotificationDiagnostic, includeToken: boolean) {
+    return notificationDiagnosticReport({
+      identity: {
+        applicationId: Application.applicationId,
+        nativeApplicationVersion: Application.nativeApplicationVersion,
+        nativeBuildVersion: Application.nativeBuildVersion,
+        configuredBundle: Constants.expoConfig?.ios?.bundleIdentifier ?? null,
+        configuredVersion: Constants.expoConfig?.version ?? null,
+        systemVersion: String(Platform.Version),
+      },
+      diagnostic,
+      includeToken,
+    });
+  }
+
+  async function copyReport(includeToken: boolean) {
+    if (state.status !== "complete") return;
+    const diagnostic = state.diagnostic;
+    setState({ ...state, copy: "copying", copyError: "" });
+    try {
+      await Clipboard.setStringAsync(report(diagnostic, includeToken));
+      setState((current) => {
+        if (current.status !== "complete" || current.diagnostic !== diagnostic) return current;
+        return { ...current, copy: "copied" };
+      });
+    } catch (error) {
+      setState((current) => {
+        if (current.status !== "complete" || current.diagnostic !== diagnostic) return current;
+        return { ...current, copy: "error", copyError: diagnosticError(error) };
+      });
+    }
+  }
+
+  const handleRun = useStableEvent(() => {
+    void run();
+  });
+  const handleCopyReport = useStableEvent(() => {
+    void copyReport(false);
+  });
+  const handleCopyRegistration = useStableEvent(() => {
+    void copyReport(true);
+  });
+
+  if (!isPreviewNotificationDiagnosticEnabled) return null;
+  const running = state.status === "running";
+  return (
+    <SettingsSection title={t("settings.notifications.nativeDiagnostic.title")}>
+      <View style={settingsStyles.card}>
+        <View style={settingsStyles.row}>
+          <View style={settingsStyles.rowContent}>
+            <Text style={settingsStyles.rowTitle}>
+              {t("settings.notifications.nativeDiagnostic.instructions")}
+            </Text>
+            <Text style={settingsStyles.rowHint}>
+              {t("settings.notifications.nativeDiagnostic.limit")}
+            </Text>
+          </View>
+        </View>
+        <View style={[settingsStyles.row, settingsStyles.rowBorder]}>
+          <Button onPress={handleRun} disabled={running} size="sm">
+            {t("settings.notifications.nativeDiagnostic.run")}
+          </Button>
+        </View>
+      </View>
+      {state.status === "running" ? (
+        <Text style={settingsStyles.rowHint}>
+          {t(`settings.notifications.nativeDiagnostic.${state.phase}`)}
+        </Text>
+      ) : null}
+      {state.status === "complete" ? (
+        <>
+          <Text style={settingsStyles.rowHint}>
+            {t("settings.notifications.nativeDiagnostic.complete")}
+          </Text>
+          <Text
+            selectable
+            style={settingsStyles.rowHint}
+            testID="native-notification-diagnostic-report"
+          >
+            {report(state.diagnostic, false)}
+          </Text>
+          <Button variant="outline" onPress={handleCopyReport} disabled={state.copy === "copying"}>
+            {t("settings.notifications.nativeDiagnostic.copy")}
+          </Button>
+          {state.diagnostic.registration.status === "success" ? (
+            <>
+              <Text style={settingsStyles.rowHint}>
+                {t("settings.notifications.nativeDiagnostic.tokenHint")}
+              </Text>
+              <Button
+                variant="outline"
+                onPress={handleCopyRegistration}
+                disabled={state.copy === "copying"}
+              >
+                {t("settings.notifications.nativeDiagnostic.copyToken")}
+              </Button>
+            </>
+          ) : null}
+          {state.copy === "copied" ? (
+            <Text style={settingsStyles.rowHint}>
+              {t("settings.notifications.nativeDiagnostic.copied")}
+            </Text>
+          ) : null}
+          {state.copy === "error" ? (
+            <Text style={settingsStyles.rowError}>
+              {t("settings.notifications.nativeDiagnostic.copyError", { error: state.copyError })}
+            </Text>
+          ) : null}
+        </>
+      ) : null}
+    </SettingsSection>
+  );
+}

diff --git a/packages/app/scripts/generate-brand-assets.mjs b/packages/app/scripts/generate-brand-assets.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2515a588bb1d69db898ba911d89f18aafff6482a
--- /dev/null
+++ b/packages/app/scripts/generate-brand-assets.mjs
@@ -0,0 +1,133 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import sharp from "sharp";
+
+const SCRIPT_DIRECTORY = dirname(fileURLToPath(import.meta.url));
+const APP_DIRECTORY = resolve(SCRIPT_DIRECTORY, "..");
+const MASTER = resolve(APP_DIRECTORY, "assets/branding/aigo-01b-master.png");
+const EXPECTED_MASTER_SHA256 = "850f7ca1f5e23549a0777a21bf1b0f854211072b74e62bc8441fad192e73d002";
+const BRAND_BACKGROUND = "#181b1a";
+const args = process.argv.slice(2);
+
+function option(name) {
+  const index = args.indexOf(name);
+  return index === -1 ? undefined : args[index + 1];
+}
+
+const masterBytes = readFileSync(MASTER);
+assert.equal(
+  createHash("sha256").update(masterBytes).digest("hex"),
+  EXPECTED_MASTER_SHA256,
+  "The AiGo 01B master does not match the user-approved source.",
+);
+
+const trimmed = await sharp(masterBytes)
+  .trim({ background: { r: 0, g: 0, b: 0, alpha: 0 } })
+  .png()
+  .toBuffer();
+
+async function transparentLogo(size, scale) {
+  const maximum = Math.round(size * scale);
+  const logo = await sharp(trimmed)
+    .resize({ width: maximum, height: maximum, fit: "inside", withoutEnlargement: false })
+    .png()
+    .toBuffer();
+  return sharp({
+    create: { width: size, height: size, channels: 4, background: { r: 0, g: 0, b: 0, alpha: 0 } },
+  })
+    .composite([{ input: logo, gravity: "center" }])
+    .png()
+    .toBuffer();
+}
+
+async function opaqueTile(size, scale) {
+  const logo = await transparentLogo(size, scale);
+  return sharp({ create: { width: size, height: size, channels: 3, background: BRAND_BACKGROUND } })
+    .composite([{ input: logo }])
+    .removeAlpha()
+    .png()
+    .toBuffer();
+}
+
+async function roundTile(size, scale, statusColor) {
+  const base = await opaqueTile(size, scale);
+  const circle = Buffer.from(
+    `<svg width="${size}" height="${size}" xmlns="http://www.w3.org/2000/svg"><circle cx="${size / 2}" cy="${size / 2}" r="${size / 2}" fill="white"/></svg>`,
+  );
+  const rounded = await sharp(base)
+    .composite([{ input: circle, blend: "dest-in" }])
+    .png()
+    .toBuffer();
+  let result = sharp(rounded);
+  if (statusColor) {
+    const radius = Math.max(3, Math.round(size * 0.13));
+    const border = Math.max(1, Math.round(size * 0.04));
+    const dot = Buffer.from(
+      `<svg width="${size}" height="${size}" xmlns="http://www.w3.org/2000/svg"><circle cx="${size - radius - border}" cy="${size - radius - border}" r="${radius + border}" fill="${BRAND_BACKGROUND}"/><circle cx="${size - radius - border}" cy="${size - radius - border}" r="${radius}" fill="${statusColor}"/></svg>`,
+    );
+    result = result.composite([{ input: dot }]);
+  }
+  return result.png().toBuffer();
+}
+
+function write(relativePath, bytes) {
+  const path = resolve(APP_DIRECTORY, relativePath);
+  mkdirSync(dirname(path), { recursive: true });
+  writeFileSync(path, bytes);
+  console.log(`wrote ${relativePath}`);
+}
+
+function makeIco(images) {
+  const header = Buffer.alloc(6);
+  header.writeUInt16LE(0, 0);
+  header.writeUInt16LE(1, 2);
+  header.writeUInt16LE(images.length, 4);
+  const entries = Buffer.alloc(images.length * 16);
+  let offset = header.length + entries.length;
+  images.forEach(({ size, bytes }, index) => {
+    const start = index * 16;
+    entries.writeUInt8(size === 256 ? 0 : size, start);
+    entries.writeUInt8(size === 256 ? 0 : size, start + 1);
+    entries.writeUInt8(0, start + 2);
+    entries.writeUInt8(0, start + 3);
+    entries.writeUInt16LE(1, start + 4);
+    entries.writeUInt16LE(32, start + 6);
+    entries.writeUInt32LE(bytes.length, start + 8);
+    entries.writeUInt32LE(offset, start + 12);
+    offset += bytes.length;
+  });
+  return Buffer.concat([header, entries, ...images.map(({ bytes }) => bytes)]);
+}
+
+write("assets/images/aigo-logo.png", await transparentLogo(512, 0.94));
+write("assets/images/icon.png", await opaqueTile(1024, 0.76));
+write("assets/images/android-icon-foreground.png", await transparentLogo(1024, 0.62));
+write("assets/images/splash-icon.png", await transparentLogo(200, 0.9));
+
+const favicon = await roundTile(48, 0.72);
+const runningFavicon = await roundTile(48, 0.72, "#22c55e");
+const attentionFavicon = await roundTile(48, 0.72, "#f59e0b");
+for (const theme of ["dark", "light"]) {
+  write(`assets/images/favicon-${theme}.png`, favicon);
+  write(`assets/images/favicon-${theme}-running.png`, runningFavicon);
+  write(`assets/images/favicon-${theme}-attention.png`, attentionFavicon);
+}
+write("assets/images/favicon.png", favicon);
+write("public/apple-touch-icon.png", await opaqueTile(180, 0.74));
+write("public/pwa-icon-192.png", await opaqueTile(192, 0.7));
+write("public/pwa-icon-512.png", await opaqueTile(512, 0.7));
+
+const trayOutput = option("--tray-output");
+if (trayOutput) {
+  const sizes = [16, 20, 24, 32, 48, 64, 128, 256];
+  const images = await Promise.all(
+    sizes.map(async (size) => ({ size, bytes: await roundTile(size, 0.72) })),
+  );
+  const path = resolve(APP_DIRECTORY, trayOutput);
+  mkdirSync(dirname(path), { recursive: true });
+  writeFileSync(path, makeIco(images));
+  console.log(`wrote ${path}`);
+}
diff --git a/packages/app/src/agent-stream/permission-response-feedback.test.tsx b/packages/app/src/agent-stream/permission-response-feedback.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..7297658e755b3a1b1b7f765d5129c5243639b4ed
--- /dev/null
+++ b/packages/app/src/agent-stream/permission-response-feedback.test.tsx
@@ -0,0 +1,107 @@
+/** @vitest-environment jsdom */
+import React from "react";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { createInstance } from "i18next";
+import { I18nextProvider, initReactI18next } from "react-i18next";
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { en } from "@/i18n/resources/en";
+import { PermissionResponseFeedback } from "./permission-response-feedback";
+import { QuestionFormCard } from "@/components/question-form-card";
+import type { PendingPermission } from "@/types/shared";
+
+const permission: PendingPermission = {
+  key: "agent:question",
+  agentId: "agent",
+  request: {
+    id: "question",
+    provider: "opencode",
+    name: "Question",
+    kind: "question",
+    input: {
+      questions: [{ header: "Choice", question: "Choose a value", options: [{ label: "Final" }] }],
+    },
+  },
+};
+
+const i18n = createInstance();
+const ignoreCheck = () => undefined;
+beforeAll(async () => {
+  await i18n.use(initReactI18next).init({ lng: "en", resources: { en: { translation: en } } });
+});
+afterEach(cleanup);
+
+describe("permission response feedback", () => {
+  it("keeps a completed question selection visible but blocks another submission when uncertain", () => {
+    const respond = vi.fn();
+    const card = (blocked: boolean) => (
+      <I18nextProvider i18n={i18n}>
+        <QuestionFormCard
+          permission={permission}
+          onRespond={respond}
+          isResponding={false}
+          isResponseBlocked={blocked}
+        />
+      </I18nextProvider>
+    );
+    const { rerender } = render(card(false));
+    fireEvent.click(screen.getByRole("radio", { name: "Final" }));
+    fireEvent.click(screen.getByRole("button", { name: "Submit" }));
+    expect(respond).toHaveBeenCalledTimes(1);
+    rerender(card(true));
+    expect(screen.getByRole("radio", { name: "Final" }).getAttribute("aria-checked")).toBe("true");
+    expect(screen.getByRole("button", { name: "Submit" }).getAttribute("aria-disabled")).toBe(
+      "true",
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Submit" }));
+    expect(respond).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps uncertainty visible and offers a status check without an approval action", () => {
+    const checkStatus = vi.fn();
+    render(
+      <I18nextProvider i18n={i18n}>
+        <PermissionResponseFeedback status="uncertain" onCheckStatus={checkStatus} />
+      </I18nextProvider>,
+    );
+    expect(screen.getByRole("alert").textContent).toBe(
+      en.agentStream.permission.response.uncertain,
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Check status" }));
+    expect(checkStatus).toHaveBeenCalledTimes(1);
+    expect(screen.getAllByRole("button")).toHaveLength(1);
+    expect(screen.getByRole("alert").textContent).toBe(
+      en.agentStream.permission.response.uncertain,
+    );
+  });
+
+  it("shows offline recovery, then progress and a neutral no-longer-pending result", () => {
+    const feedback = (status: "unavailable" | "pending" | "complete") => (
+      <I18nextProvider i18n={i18n}>
+        <PermissionResponseFeedback status={status} onCheckStatus={ignoreCheck} />
+      </I18nextProvider>
+    );
+    const { rerender } = render(feedback("unavailable"));
+    expect(screen.getByRole("alert").textContent).toBe(
+      en.agentStream.permission.response.unavailable,
+    );
+    expect(screen.getByRole("button", { name: "Check status" }).textContent).toBe("Check status");
+    rerender(feedback("pending"));
+    expect(screen.getByRole("alert").textContent).toBe(en.agentStream.permission.response.pending);
+    expect(screen.queryByRole("button")).toBeNull();
+    rerender(feedback("complete"));
+    expect(screen.getByRole("alert").textContent).toBe("This request is no longer pending.");
+    expect(screen.queryByRole("button")).toBeNull();
+  });
+
+  it("explains that a stale request was not sent", () => {
+    render(
+      <I18nextProvider i18n={i18n}>
+        <PermissionResponseFeedback status="stale" onCheckStatus={ignoreCheck} />
+      </I18nextProvider>,
+    );
+    expect(screen.getByRole("alert").textContent).toBe(
+      "This request is no longer pending. No response was sent.",
+    );
+    expect(screen.queryByRole("button")).toBeNull();
+  });
+});
diff --git a/packages/app/src/agent-stream/permission-response-feedback.tsx b/packages/app/src/agent-stream/permission-response-feedback.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8d45ff41114d3fdc9724754b92a847f30b746a41
--- /dev/null
+++ b/packages/app/src/agent-stream/permission-response-feedback.tsx
@@ -0,0 +1,41 @@
+import React from "react";
+import { Text, View } from "react-native";
+import { Button } from "@/components/ui/button";
+import { useTranslation } from "react-i18next";
+import { StyleSheet } from "react-native-unistyles";
+import type { PermissionResponseOutcome } from "./permission-response";
+
+export function PermissionResponseFeedback({
+  status,
+  onCheckStatus,
+}: {
+  status: PermissionResponseOutcome | "pending";
+  onCheckStatus: () => void;
+}) {
+  const { t } = useTranslation();
+  if (status === "ready") return null;
+  return (
+    <View style={styles.container} testID="permission-response-feedback">
+      <Text accessibilityRole="alert" style={styles.message}>
+        {t(`agentStream.permission.response.${status}`)}
+      </Text>
+      {status === "uncertain" || status === "unavailable" ? (
+        <Button
+          variant="outline"
+          size="sm"
+          onPress={onCheckStatus}
+          style={styles.button}
+          testID="permission-response-check"
+        >
+          {t("agentStream.permission.response.check")}
+        </Button>
+      ) : null}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({

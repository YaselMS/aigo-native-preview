+import { describe, expect, it, vi } from "vitest";
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import { openOrCreateHostTerminal } from "./host-terminal";
+
+describe("openOrCreateHostTerminal", () => {
+  it("reattaches the existing matching terminal instead of spawning a second writer", async () => {
+    const listTerminals = vi.fn(async () => ({
+      cwd: "C:\\Users\\K",
+      terminals: [
+        { id: "other", name: "Host terminal", scope: "host" as const, activity: null },
+        { id: "herdr-live", name: "Herdr (live session)", scope: "host" as const, activity: null },
+      ],
+      requestId: "list-1",
+    }));
+    const createTerminal = vi.fn();
+    const client = {
+      listTerminals,
+      createTerminal,
+      getDaemonConfig: vi.fn(async () => ({
+        requestId: "config-1",
+        config: {
+          terminalProfiles: [
+            {
+              id: "herdr",
+              name: "Herdr (live session)",
+              command: "C:\\tools\\herdr.exe",
+              args: [],
+            },
+          ],
+        },
+      })),
+    } as unknown as DaemonClient;
+
+    await expect(openOrCreateHostTerminal(client, { profileId: "herdr" })).resolves.toEqual({
+      id: "herdr-live",
+      name: "Herdr (live session)",
+      cwd: "C:\\Users\\K",
+    });
+    expect(listTerminals).toHaveBeenCalledWith(undefined, undefined, { scope: "host" });
+    expect(createTerminal).not.toHaveBeenCalled();
+  });
+
+  it("creates the configured profile only after no matching live terminal exists", async () => {
+    const createTerminal = vi.fn(async () => ({
+      terminal: {
+        id: "herdr-new",
+        name: "Herdr (live session)",
+        cwd: "C:\\Users\\K",
+        scope: "host" as const,
+        activity: null,
+      },
+      error: null,
+      requestId: "create-1",
+    }));
+    const client = {
+      listTerminals: vi.fn(async () => ({
+        cwd: "C:\\Users\\K",
+        terminals: [],
+        requestId: "list-1",
+      })),
+      createTerminal,
+      getDaemonConfig: vi.fn(async () => ({
+        requestId: "config-1",
+        config: {
+          terminalProfiles: [
+            {
+              id: "herdr",
+              name: "Herdr (live session)",
+              command: "C:\\tools\\herdr.exe",
+              args: [],
+            },
+          ],
+        },
+      })),
+    } as unknown as DaemonClient;
+
+    await expect(openOrCreateHostTerminal(client, { profileId: "herdr" })).resolves.toMatchObject({
+      id: "herdr-new",
+    });
+    expect(createTerminal).toHaveBeenCalledWith("", "Herdr (live session)", undefined, {
+      scope: "host",
+      command: "C:\\tools\\herdr.exe",
+      args: [],
+    });
+  });
+
+  it("shares an in-flight launch so rapid taps cannot create duplicate processes", async () => {
+    let resolveList!: (value: { cwd: string; terminals: []; requestId: string }) => void;
+    const listTerminals = vi.fn(
+      () =>
+        new Promise<{ cwd: string; terminals: []; requestId: string }>((resolve) => {
+          resolveList = resolve;
+        }),
+    );
+    const createTerminal = vi.fn(async () => ({
+      terminal: {
+        id: "host-new",
+        name: "Host terminal",
+        cwd: "C:\\Users\\K",
+        scope: "host" as const,
+        activity: null,
+      },
+      error: null,
+      requestId: "create-1",
+    }));
+    const client = { listTerminals, createTerminal } as unknown as DaemonClient;
+
+    const first = openOrCreateHostTerminal(client);
+    const second = openOrCreateHostTerminal(client);
+    expect(first).toBe(second);
+    expect(listTerminals).toHaveBeenCalledTimes(1);
+
+    resolveList({ cwd: "C:\\Users\\K", terminals: [], requestId: "list-1" });
+    await expect(Promise.all([first, second])).resolves.toEqual([
+      expect.objectContaining({ id: "host-new" }),
+      expect.objectContaining({ id: "host-new" }),
+    ]);
+    expect(createTerminal).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/packages/app/src/terminal/runtime/host-terminal.ts b/packages/app/src/terminal/runtime/host-terminal.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6fa91f331adefa1f092c36af7322263155771be3
--- /dev/null
+++ b/packages/app/src/terminal/runtime/host-terminal.ts
@@ -0,0 +1,110 @@
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import {
+  DEFAULT_TERMINAL_PROFILES,
+  resolveTerminalProfileLaunch,
+} from "@getpaseo/protocol/terminal-profiles";
+
+export const DEFAULT_HOST_TERMINAL_NAME = "Host terminal";
+
+export interface HostTerminalTarget {
+  id: string;
+  name: string;
+  cwd: string;
+}
+
+interface OpenHostTerminalOptions {
+  profileId?: string;
+  forceCreate?: boolean;
+}
+
+const pendingHostTerminalLaunches = new WeakMap<
+  DaemonClient,
+  Map<string, Promise<HostTerminalTarget>>
+>();
+
+function hostTerminalLaunchKey(options: OpenHostTerminalOptions): string {
+  return `${options.profileId ?? "default"}:${options.forceCreate === true ? "replace" : "open"}`;
+}
+
+export async function findHostTerminal(
+  client: DaemonClient,
+  terminalId: string,
+): Promise<HostTerminalTarget | null> {
+  const payload = await client.listTerminals(undefined, undefined, { scope: "host" });
+  const terminal = payload.terminals.find((candidate) => candidate.id === terminalId);
+  if (!terminal || !payload.cwd) {
+    return null;
+  }
+  return { id: terminal.id, name: terminal.name, cwd: payload.cwd };
+}
+
+async function openOrCreateHostTerminalUnshared(
+  client: DaemonClient,
+  options: OpenHostTerminalOptions = {},
+): Promise<HostTerminalTarget> {
+  let name = DEFAULT_HOST_TERMINAL_NAME;
+  let command: string | undefined;
+  let args: string[] | undefined;
+
+  if (options.profileId) {
+    const { config } = await client.getDaemonConfig();
+    const profile = (config.terminalProfiles ?? DEFAULT_TERMINAL_PROFILES).find(
+      (candidate) => candidate.id === options.profileId,
+    );
+    if (!profile) {
+      throw new Error(`Terminal profile ${options.profileId} is not configured on this host.`);
+    }
+    const launch = resolveTerminalProfileLaunch(profile, "");
+    name = launch.name;
+    command = launch.command;
+    args = launch.args;
+  }
+
+  if (!options.forceCreate) {
+    const existing = await client.listTerminals(undefined, undefined, { scope: "host" });
+    for (let index = existing.terminals.length - 1; index >= 0; index -= 1) {
+      const terminal = existing.terminals[index];
+      if (terminal?.name === name && existing.cwd) {
+        return { id: terminal.id, name: terminal.name, cwd: existing.cwd };
+      }
+    }
+  }
+
+  const payload = await client.createTerminal("", name, undefined, {
+    scope: "host",
+    ...(command ? { command } : {}),
+    ...(args ? { args } : {}),
+  });
+  if (!payload.terminal) {
+    throw new Error(payload.error ?? "The host could not create the terminal.");
+  }
+  return {
+    id: payload.terminal.id,
+    name: payload.terminal.name,
+    cwd: payload.terminal.cwd,
+  };
+}
+
+export function openOrCreateHostTerminal(
+  client: DaemonClient,
+  options: OpenHostTerminalOptions = {},
+): Promise<HostTerminalTarget> {
+  let pendingByLaunch = pendingHostTerminalLaunches.get(client);
+  if (!pendingByLaunch) {
+    pendingByLaunch = new Map();
+    pendingHostTerminalLaunches.set(client, pendingByLaunch);
+  }
+  const key = hostTerminalLaunchKey(options);
+  const existing = pendingByLaunch.get(key);
+  if (existing) {
+    return existing;
+  }
+
+  const launch = openOrCreateHostTerminalUnshared(client, options);
+  pendingByLaunch.set(key, launch);
+  const clearPending = () => {
+    if (pendingByLaunch?.get(key) === launch) pendingByLaunch.delete(key);
+  };
+  void launch.then(clearPending, clearPending);
+  return launch;
+}
diff --git a/packages/app/src/terminal/runtime/terminal-mobile-font-preset.test.ts b/packages/app/src/terminal/runtime/terminal-mobile-font-preset.test.ts

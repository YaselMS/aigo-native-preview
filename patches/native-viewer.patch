@@ -0,0 +1,69 @@
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import type { AgentPermissionResponse } from "@getpaseo/protocol/agent-types";
+
+export type PermissionResponseClient = Pick<
+  DaemonClient,
+  "isConnected" | "fetchAgent" | "respondToPermissionAndWait"
+>;
+export type PermissionResponseOutcome =
+  | "ready"
+  | "complete"
+  | "stale"
+  | "uncertain"
+  | "unavailable";
+
+// Keep an ambiguous response locked across card remounts and connection generations.
+// This is an in-memory submission guard, never a source of pending permission state.
+const attemptedRequests = new Set<string>();
+const inFlight = new Map<string, Promise<PermissionResponseOutcome>>();
+
+export function reconcilePermissionResponse(input: {
+  serverId: string;
+  agentId: string;
+  requestId: string;
+  client: PermissionResponseClient;
+  response?: AgentPermissionResponse;
+  timeoutMs?: number;
+}): Promise<PermissionResponseOutcome> {
+  const key = JSON.stringify([input.serverId, input.agentId, input.requestId]);
+  const existing = inFlight.get(key);
+  if (existing) return existing;
+  const operation = run().finally(() => inFlight.delete(key));
+  inFlight.set(key, operation);
+  return operation;
+
+  async function run(): Promise<PermissionResponseOutcome> {
+    const { client, agentId, requestId } = input;
+    const timeoutMs = input.timeoutMs ?? 15_000;
+    const deadline = Date.now() + timeoutMs;
+    const fetchPending = async () => {
+      if (!client.isConnected) throw new Error("Host disconnected");
+      const result = await client.fetchAgent({
+        agentId,
+        timeout: Math.max(1, Math.min(5_000, deadline - Date.now())),
+      });
+      return result?.agent.pendingPermissions.some((request) => request.id === requestId) ?? false;
+    };
+    try {
+      if (!(await fetchPending())) {
+        return attemptedRequests.has(key) ? "complete" : "stale";
+      }
+      if (attemptedRequests.has(key)) return "uncertain";
+      if (!input.response) return "ready";
+      if (!client.isConnected) return "unavailable";
+      attemptedRequests.add(key);
+      // This existing SDK method sends with skipQueue:true. Its acknowledgement is optional
+      // evidence: some providers apply the answer without emitting permission_resolved.
+      void client
+        .respondToPermissionAndWait(agentId, requestId, input.response, timeoutMs)
+        .catch(() => undefined);
+      do {
+        if (!(await fetchPending())) return "complete";
+        await new Promise<void>((resolve) => setTimeout(resolve, 250));
+      } while (Date.now() < deadline);
+      return "uncertain";
+    } catch {
+      return attemptedRequests.has(key) ? "uncertain" : "unavailable";
+    }
+  }
+}

+import { describe, expect, it } from "vitest";
+import {
+  allowsDesktopNavigation,
+  desktopOrigin,
+  parseDesktopFullscreenRequest,
+} from "./desktop-view-policy";
+
+const origin = "https://aigo-native-test.trycloudflare.com";
+const link = `${origin}/#${"a".repeat(64)}`;
+
+describe("native desktop navigation", () => {
+  it("accepts the private viewer entry and its authenticated root navigation", () => {
+    expect(desktopOrigin(link)).toBe(origin);
+    expect(allowsDesktopNavigation(link, origin)).toBe(true);
+    expect(allowsDesktopNavigation(`${origin}/`, origin)).toBe(true);
+  });
+
+  it.each([
+    "https://example.com/#" + "a".repeat(64),
+    link.replace("https:", "http:"),
+    link.replace(".com/", ".com.attacker.test/"),
+    link.replace("/#", "/other#"),
+    link.replace("/#", "/?token="),
+    link.replace("https://", "https://user:secret@"),
+    `${origin}/#short`,
+    "file:///test",
+    "javascript:alert(1)",
+  ])("rejects an invalid or unexpected desktop link: %s", (value) => {
+    expect(desktopOrigin(value)).toBe(null);
+  });
+
+  it.each([
+    "https://example.com/",
+    "paseo://pair",
+    "file:///test",
+    `${origin}/credentials`,
+    `${origin}/?redirect=elsewhere`,
+  ])("keeps navigation within the viewer root: %s", (value) => {
+    expect(allowsDesktopNavigation(value, origin)).toBe(false);
+  });
+});
+
+describe("native desktop fullscreen bridge", () => {
+  it("accepts an explicit presentation request with camera coordinates only", () => {
+    expect(
+      parseDesktopFullscreenRequest(
+        JSON.stringify({
+          type: "aigo:native-fullscreen",
+          fullscreen: true,
+          camera: { zoom: 2, centerX: 960, centerY: 540 },
+          lease: "must-not-cross-the-bridge",
+        }),
+      ),
+    ).toEqual({ fullscreen: true, camera: { zoom: 2, centerX: 960, centerY: 540 } });
+    expect(
+      parseDesktopFullscreenRequest(
+        JSON.stringify({
+          type: "aigo:native-fullscreen",
+          fullscreen: false,
+        }),
+      ),
+    ).toEqual({ fullscreen: false, camera: null });
+  });
+
+  it.each([
+    "not json",
+    "null",
+    "[]",
+    "x".repeat(1025),
+    JSON.stringify({ type: "take-control", fullscreen: true }),
+    JSON.stringify({ type: "aigo:native-fullscreen", fullscreen: "true" }),
+    JSON.stringify({ type: "aigo:native-fullscreen", fullscreen: true, camera: {} }),
+    JSON.stringify({
+      type: "aigo:native-fullscreen",
+      fullscreen: true,
+      camera: { zoom: -1, centerX: 0, centerY: 0 },
+    }),
+    JSON.stringify({
+      type: "aigo:native-fullscreen",
+      fullscreen: true,
+      camera: { zoom: 2, centerX: 100001, centerY: 0 },
+    }),
+  ])("ignores malformed and unrelated messages: %s", (data) => {
+    expect(parseDesktopFullscreenRequest(data)).toBeNull();
+  });
+});

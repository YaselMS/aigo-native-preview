--- /dev/null
+++ b/packages/app/src/constants/layout-breakpoints.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vitest";
+import { isCompactViewport } from "./layout-breakpoints";
+
+describe("compact viewport", () => {
+  it("keeps a native phone compact across rotation", () => {
+    expect(isCompactViewport(430, 932, true)).toBe(true);
+    expect(isCompactViewport(932, 430, true)).toBe(true);
+  });
+
+  it("keeps a full-size tablet wide in both orientations", () => {
+    expect(isCompactViewport(820, 1180, true)).toBe(false);
+    expect(isCompactViewport(1180, 820, true)).toBe(false);
+  });
+
+  it("allows a narrow native window to use compact navigation", () => {
+    expect(isCompactViewport(600, 1180, true)).toBe(true);
+    expect(isCompactViewport(720, 1180, true)).toBe(false);
+  });
+
+  it("preserves width-based web layout", () => {
+    expect(isCompactViewport(430, 932, false)).toBe(true);
+    expect(isCompactViewport(932, 430, false)).toBe(false);
+    expect(isCompactViewport(719, 900, false)).toBe(true);
+    expect(isCompactViewport(720, 900, false)).toBe(false);
+  });
+});
diff --git a/packages/app/src/constants/layout-breakpoints.ts b/packages/app/src/constants/layout-breakpoints.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b25cef9443eeee93310c4d325bfb00054aaf4141
--- /dev/null
+++ b/packages/app/src/constants/layout-breakpoints.ts
@@ -0,0 +1,14 @@
+export const LAYOUT_BREAKPOINTS = {
+  xs: 0,
+  sm: 576,
+  md: 720,
+  lg: 992,
+  xl: 1200,
+};
+
+export function isCompactViewport(width: number, height: number, native: boolean): boolean {
+  // A phone remains a compact device when rotated. Changing the entire shell
+  // at landscape width would unmount its active panels and fullscreen viewer.
+  const layoutWidth = native ? Math.min(width, height) : width;
+  return layoutWidth < LAYOUT_BREAKPOINTS.md;
+}

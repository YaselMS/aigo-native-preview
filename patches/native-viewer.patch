+import { describe, expect, it } from "vitest";
+import { isCompactViewport } from "./layout-breakpoints";
+
+describe("compact viewport", () => {
+  it("keeps a native phone compact across rotation", () => {
+    expect(isCompactViewport(430, 932, true)).toBe(true);
+    expect(isCompactViewport(932, 430, true)).toBe(true);
+  });
+
+  it("keeps a full-size tablet wide in both orientations", () => {
+    expect(isCompactViewport(820, 1180, true)).toBe(false);
+    expect(isCompactViewport(1180, 820, true)).toBe(false);
+  });
+
+  it("allows a narrow native window to use compact navigation", () => {
+    expect(isCompactViewport(600, 1180, true)).toBe(true);
+    expect(isCompactViewport(720, 1180, true)).toBe(false);
+  });
+
+  it("preserves width-based web layout", () => {
+    expect(isCompactViewport(430, 932, false)).toBe(true);
+    expect(isCompactViewport(932, 430, false)).toBe(false);
+    expect(isCompactViewport(719, 900, false)).toBe(true);
+    expect(isCompactViewport(720, 900, false)).toBe(false);
+  });
+});

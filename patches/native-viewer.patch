diff --git a/packages/app/src/push-notifications/preview-diagnostic.test.ts b/packages/app/src/push-notifications/preview-diagnostic.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e16130ebf3aafe4195caa4850ea88dbbe17d24b6
--- /dev/null
+++ b/packages/app/src/push-notifications/preview-diagnostic.test.ts
@@ -0,0 +1,216 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { PermissionStatus } from "expo-modules-core";
+import type * as Notifications from "expo-notifications";
+import {
+  diagnosticError,
+  notificationDiagnosticReport,
+  PREVIEW_NOTIFICATION_TEST,
+  runNotificationDiagnostic,
+  shouldShowPreviewNotification,
+} from "./preview-diagnostic";
+
+const permission: Notifications.NotificationPermissionsStatus = {
+  status: PermissionStatus.GRANTED,
+  granted: true,
+  canAskAgain: true,
+  expires: "never",
+};
+const token: Notifications.NativeDevicePushToken = { type: "ios", data: "a".repeat(64) };
+const notification: Notifications.NotificationRequestInput = {
+  content: { title: "Aigo local test", data: { aigoDiagnostic: PREVIEW_NOTIFICATION_TEST } },
+  trigger: null,
+};
+
+function setup() {
+  const api = {
+    setAutoServerRegistrationEnabledAsync: vi
+      .fn<(enabled: boolean) => Promise<void>>()
+      .mockResolvedValue(undefined),
+    requestPermissionsAsync: vi
+      .fn<() => Promise<Notifications.NotificationPermissionsStatus>>()
+      .mockResolvedValue(permission),
+    scheduleNotificationAsync: vi.fn<() => Promise<string>>().mockResolvedValue("local-test-id"),
+    getDevicePushTokenAsync: vi
+      .fn<() => Promise<Notifications.DevicePushToken>>()
+      .mockResolvedValue(token),
+  };
+  const controller = new AbortController();
+  const onPhase = vi.fn();
+  return {
+    api,
+    controller,
+    run: () => runNotificationDiagnostic({ api, notification, signal: controller.signal, onPhase }),
+    onPhase,
+  };
+}
+
+afterEach(() => vi.useRealTimers());
+
+describe("preview native notification diagnostic", () => {
+  it("requests permission, schedules the supplied local alert, and registers natively", async () => {
+    const test = setup();
+    expect(await test.run()).toEqual({
+      permission: { status: "success", value: permission },
+      local: { status: "success", value: "local-test-id" },
+      registration: { status: "success", value: token },
+    });
+    expect(test.api.requestPermissionsAsync).toHaveBeenCalledWith({
+      ios: { allowAlert: true, allowSound: true, allowBadge: true },
+    });
+    expect(test.api.scheduleNotificationAsync).toHaveBeenCalledExactlyOnceWith(notification);
+    expect(test.api.setAutoServerRegistrationEnabledAsync).toHaveBeenCalledExactlyOnceWith(false);
+    expect(test.onPhase.mock.calls).toEqual([["permission"], ["local"], ["registration"]]);
+  });
+
+  it("reports denial without scheduling and still exposes a missing APNs entitlement", async () => {
+    const test = setup();
+    const denied = {
+      ...permission,
+      status: PermissionStatus.DENIED,
+      granted: false,
+      canAskAgain: false,
+    };
+    test.api.requestPermissionsAsync.mockResolvedValue(denied);
+    test.api.getDevicePushTokenAsync.mockRejectedValue(
+      new Error("no valid aps-environment entitlement string found"),
+    );
+    expect(await test.run()).toEqual({
+      permission: { status: "success", value: denied },
+      local: { status: "skipped" },
+      registration: {
+        status: "error",
+        message: "no valid aps-environment entitlement string found",
+      },
+    });
+    expect(test.api.scheduleNotificationAsync).not.toHaveBeenCalled();
+  });
+
+  it("keeps permission and scheduling failures visible independently of registration", async () => {
+    const test = setup();
+    test.api.scheduleNotificationAsync.mockRejectedValue(new Error("Scheduling unavailable"));
+    expect(await test.run()).toMatchObject({
+      local: { status: "error", message: "Scheduling unavailable" },
+      registration: { status: "success" },
+    });
+    test.api.requestPermissionsAsync.mockRejectedValue(new Error("Permission API unavailable"));
+    expect(await test.run()).toMatchObject({
+      permission: { status: "error", message: "Permission API unavailable" },
+      local: { status: "skipped" },
+    });
+  });
+
+  it("refuses native registration if disabling Expo auto-upload fails", async () => {
+    const test = setup();
+    test.api.setAutoServerRegistrationEnabledAsync.mockRejectedValue(
+      new Error("Cannot disable auto-upload"),
+    );
+    expect(await test.run()).toMatchObject({
+      registration: { status: "error", message: "Cannot disable auto-upload" },
+    });
+    expect(test.api.getDevicePushTokenAsync).not.toHaveBeenCalled();
+  });
+
+  it("finishes after a 10 second APNs timeout and ignores a late token", async () => {
+    vi.useFakeTimers();
+    const test = setup();
+    let resolveToken: (value: Notifications.DevicePushToken) => void = () => {};
+    test.api.getDevicePushTokenAsync.mockImplementation(
+      () =>
+        new Promise((resolve) => {
+          resolveToken = resolve;
+        }),
+    );
+    const pending = test.run();
+    await vi.advanceTimersByTimeAsync(10_000);
+    const result = await pending;
+    expect(result?.registration).toEqual({ status: "timeout" });
+    resolveToken(token);
+    await vi.advanceTimersByTimeAsync(0);
+    expect(result?.registration).toEqual({ status: "timeout" });
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("bounds a stalled permission request and a stalled scheduler", async () => {
+    vi.useFakeTimers();
+    const test = setup();
+    test.api.requestPermissionsAsync.mockImplementation(() => new Promise(() => {}));
+    const permissionPending = test.run();
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(await permissionPending).toMatchObject({
+      permission: { status: "timeout" },
+      local: { status: "skipped" },
+    });
+    test.api.requestPermissionsAsync.mockResolvedValue(permission);
+    test.api.scheduleNotificationAsync.mockImplementation(() => new Promise(() => {}));
+    const schedulePending = test.run();
+    await vi.advanceTimersByTimeAsync(8_000);
+    expect(await schedulePending).toMatchObject({
+      local: { status: "timeout" },
+      registration: { status: "success" },
+    });
+  });
+
+  it("does not start another phase or publish a stale result after unmount", async () => {
+    const test = setup();
+    test.api.requestPermissionsAsync.mockImplementation(async () => {
+      test.controller.abort();
+      return permission;
+    });
+    expect(await test.run()).toBeNull();
+    expect(test.api.scheduleNotificationAsync).not.toHaveBeenCalled();
+    expect(test.api.getDevicePushTokenAsync).not.toHaveBeenCalled();
+    expect(test.onPhase.mock.calls).toEqual([["permission"]]);
+  });
+
+  it("does not publish a token after leaving during registration", async () => {
+    const test = setup();
+    test.api.getDevicePushTokenAsync.mockImplementation(async () => {
+      test.controller.abort();
+      return token;
+    });
+    expect(await test.run()).toBeNull();
+  });
+
+  it("masks tokens in the ordinary report, includes signed identity, and separates remote proof", async () => {
+    const diagnostic = await setup().run();
+    if (!diagnostic) throw new Error("Expected a diagnostic result");
+    const identity = {
+      applicationId: "signed.aigo.preview",
+      nativeApplicationVersion: "0.7.5",
+      nativeBuildVersion: "7005999",
+      configuredBundle: "dev.aigo.preview",
+      configuredVersion: "0.7.5",
+      systemVersion: "26",
+    };
+    const report = notificationDiagnosticReport({ identity, diagnostic, includeToken: false });
+    expect(report).not.toContain(token.data);
+    expect(report).toContain("signed.aigo.preview");
+    expect(report).toContain("dev.aigo.preview");
+    expect(report).toContain("Remote delivery: not tested");
+    expect(report).not.toContain("Registration timeout:");
+    expect(notificationDiagnosticReport({ identity, diagnostic, includeToken: true })).toContain(
+      token.data,
+    );
+    expect(diagnosticError(new Error(`Failed token ${token.data}`))).toBe(
+      "Failed token [redacted]",
+    );
+  });
+
+  it("only presents and intercepts explicitly marked preview diagnostics", () => {
+    expect(
+      shouldShowPreviewNotification({
+        enabled: true,
+        data: { aigoDiagnostic: PREVIEW_NOTIFICATION_TEST },
+      }),
+    ).toBe(true);
+    expect(
+      shouldShowPreviewNotification({
+        enabled: false,
+        data: { aigoDiagnostic: PREVIEW_NOTIFICATION_TEST },
+      }),
+    ).toBe(false);
+    expect(shouldShowPreviewNotification({ enabled: true, data: { agentId: "agent" } })).toBe(
+      false,
+    );
+  });
+});
diff --git a/packages/app/src/push-notifications/preview-diagnostic.ts b/packages/app/src/push-notifications/preview-diagnostic.ts
new file mode 100644
index 0000000000000000000000000000000000000000..573f4db4a957bf0baaee3d0aa31163ccb0a802aa
--- /dev/null
+++ b/packages/app/src/push-notifications/preview-diagnostic.ts
@@ -0,0 +1,143 @@
+import type * as Notifications from "expo-notifications";
+
+export const PREVIEW_NOTIFICATION_TEST = "aigo-native-local-test";
+
+type Outcome<T> =
+  | { status: "success"; value: T }
+  | { status: "error"; message: string }
+  | { status: "timeout" };
+
+export interface NotificationDiagnostic {
+  permission: Outcome<Notifications.NotificationPermissionsStatus>;
+  local: Outcome<string> | { status: "skipped" };
+  registration: Outcome<Notifications.NativeDevicePushToken>;
+}
+
+interface DiagnosticInput {
+  api: Pick<
+    typeof Notifications,
+    | "requestPermissionsAsync"
+    | "scheduleNotificationAsync"
+    | "getDevicePushTokenAsync"
+    | "setAutoServerRegistrationEnabledAsync"
+  >;
+  notification: Notifications.NotificationRequestInput;
+  signal: AbortSignal;
+  onPhase: (phase: "permission" | "local" | "registration") => void;
+}
+
+// Native error text can include a token. Reports never include token-shaped strings from errors.
+export function diagnosticError(error: unknown): string {
+  const message = error instanceof Error ? error.message : String(error);
+  return message.replace(/[a-f\d]{32,}/gi, "[redacted]").slice(0, 1200);
+}
+
+async function bounded<T>(operation: () => Promise<T>, timeoutMs: number): Promise<Outcome<T>> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<Outcome<T>>((resolve) => {
+    timer = setTimeout(() => resolve({ status: "timeout" }), timeoutMs);
+  });
+  const attempt = Promise.resolve()
+    .then(operation)
+    .then<Outcome<T>, Outcome<T>>(
+      (value) => ({ status: "success", value }),
+      (error: unknown) => ({ status: "error", message: diagnosticError(error) }),
+    );
+  try {
+    return await Promise.race([attempt, timeout]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+export async function runNotificationDiagnostic({
+  api,
+  notification,
+  signal,
+  onPhase,
+}: DiagnosticInput): Promise<NotificationDiagnostic | null> {
+  if (signal.aborted) return null;
+  onPhase("permission");
+  const permission = await bounded(
+    () =>
+      api.requestPermissionsAsync({
+        ios: { allowAlert: true, allowSound: true, allowBadge: true },
+      }),
+    60_000,
+  );
+  if (signal.aborted) return null;
+  let local: NotificationDiagnostic["local"] = { status: "skipped" };
+  if (permission.status === "success" && permission.value.granted) {
+    onPhase("local");
+    local = await bounded(() => api.scheduleNotificationAsync(notification), 8_000);
+  }
+  if (signal.aborted) return null;
+  onPhase("registration");
+  // Device registration talks to APNs through iOS. Never request an Expo token or publish this token.
+  const registration = await bounded<Notifications.NativeDevicePushToken>(async () => {
+    await api.setAutoServerRegistrationEnabledAsync(false);
+    if (signal.aborted) throw new Error("Diagnostic cancelled before native registration.");
+    const token = await api.getDevicePushTokenAsync();
+    if (token.type !== "ios" || typeof token.data !== "string" || token.data.length === 0) {
+      throw new Error("Native registration did not return an iOS device token.");
+    }
+    return { type: "ios", data: token.data };
+  }, 10_000);
+  if (signal.aborted) return null;
+  return { permission, local, registration };
+}
+
+export interface DiagnosticIdentity {
+  applicationId: string | null;
+  nativeApplicationVersion: string | null;
+  nativeBuildVersion: string | null;
+  configuredBundle: string | null;
+  configuredVersion: string | null;
+  systemVersion: string;
+}
+
+interface ReportInput {
+  identity: DiagnosticIdentity;
+  diagnostic: NotificationDiagnostic;
+  includeToken: boolean;
+}
+
+export function notificationDiagnosticReport({
+  identity,
+  diagnostic,
+  includeToken,
+}: ReportInput): string {
+  const { permission, local, registration } = diagnostic;
+  const lines = ["AiGo native notification diagnostic", JSON.stringify(identity, null, 2)];
+  lines.push(`Permission: ${JSON.stringify(permission)}`);
+  lines.push(`Local test: ${JSON.stringify(local)}`);
+  if (registration.status === "success") {
+    const token = includeToken
+      ? registration.value.data
+      : "[redacted; available via Copy registration details]";
+    lines.push(
+      `Native registration: success (${registration.value.type})`,
+      `Device token: ${token}`,
+    );
+  } else {
+    lines.push(`Native registration: ${JSON.stringify(registration)}`);
+  }
+  if (registration.status === "timeout") {
+    lines.push(
+      "Registration timeout: no result within 10 seconds; native registration may finish later. Reopen the app before retrying.",
+    );
+  }
+  lines.push(
+    "Local test delivery: user observation required; scheduling is not delivery proof.",
+    "Signed APNs entitlement/environment: not inspected.",
+    "Remote delivery: not tested. No token sent to AiGo, Expo push service, or an AiGo server.",
+  );
+  return lines.join("\n");
+}
+
+export function shouldShowPreviewNotification(input: {
+  enabled: boolean;
+  data: Record<string, unknown>;
+}): boolean {
+  return input.enabled && input.data.aigoDiagnostic === PREVIEW_NOTIFICATION_TEST;
+}
diff --git a/packages/app/src/screens/host-terminal-screen.tsx b/packages/app/src/screens/host-terminal-screen.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6c8f25a02807a0c02e9718d24d500ee9691a1e1d
--- /dev/null
+++ b/packages/app/src/screens/host-terminal-screen.tsx
@@ -0,0 +1,244 @@
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { Text, View } from "react-native";
+import { useIsFocused } from "@react-navigation/native";
+import { router, type Href } from "expo-router";
+import { Maximize2, Minimize2, RefreshCw } from "lucide-react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { StyleSheet } from "react-native-unistyles";
+import { BackHeader } from "@/components/headers/back-header";
+import { TerminalPane } from "@/components/terminal-pane";
+import { Button } from "@/components/ui/button";
+import { useHostRuntimeClient, useHostRuntimeConnectionStatus } from "@/runtime/host-runtime";
+import { useSessionStore } from "@/stores/session-store";
+import { useLastHostTerminalRouteStore } from "@/stores/last-host-terminal-route";
+import { buildHostTerminalRoute } from "@/utils/host-routes";
+import { findHostTerminal, openOrCreateHostTerminal } from "@/terminal/runtime/host-terminal";
+import {
+  shouldRenderHostTerminal,
+  type HostTerminalAvailability,
+} from "@/terminal/runtime/host-terminal-screen-state";
+
+interface HostTerminalScreenProps {
+  serverId: string;
+  terminalId: string;
+  initialCwd: string;
+  profileId?: string;
+}
+
+const ignoreOpenFile = () => {};
+
+export function HostTerminalScreen({
+  serverId,
+  terminalId,
+  initialCwd,
+  profileId,
+}: HostTerminalScreenProps) {
+  const client = useHostRuntimeClient(serverId);
+  const connectionStatus = useHostRuntimeConnectionStatus(serverId);
+  const supportsHostTerminals = useSessionStore(
+    (state) => state.sessions[serverId]?.serverInfo?.features?.hostTerminals === true,
+  );
+  const navigationFocused = useIsFocused();
+  const insets = useSafeAreaInsets();
+  const [cwd, setCwd] = useState(initialCwd);
+  const [name, setName] = useState(profileId === "herdr" ? "Herdr" : "Host terminal");
+  const [availability, setAvailability] = useState<HostTerminalAvailability>("checking");
+  const [focused, setFocused] = useState(false);
+  const [layoutRequestToken, setLayoutRequestToken] = useState(0);
+  const [verificationAttempt, setVerificationAttempt] = useState(0);
+  const [creating, setCreating] = useState(false);
+  const rememberRoute = useLastHostTerminalRouteStore((state) => state.remember);
+  const clearRememberedRoute = useLastHostTerminalRouteStore((state) => state.clear);
+
+  useEffect(() => {
+    if (!serverId || !terminalId || !cwd) {
+      return;
+    }
+    rememberRoute({
+      serverId,
+      terminalId,
+      cwd,
+      ...(profileId ? { profileId } : {}),
+    });
+    return () => clearRememberedRoute({ serverId, terminalId });
+  }, [clearRememberedRoute, cwd, profileId, rememberRoute, serverId, terminalId]);
+
+  useEffect(() => {
+    if (!client || connectionStatus !== "online") {
+      return;
+    }
+    if (!supportsHostTerminals) {
+      setAvailability("unsupported");
+      return;
+    }
+    let cancelled = false;
+    setAvailability("checking");
+    void (async () => {
+      try {
+        const terminal = await findHostTerminal(client, terminalId);
+        if (cancelled) return;
+        if (!terminal) {
+          setAvailability("missing");
+          return;
+        }
+        setCwd(terminal.cwd);
+        setName(terminal.name);
+        setAvailability("ready");
+      } catch {
+        if (!cancelled) setAvailability("error");
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+  }, [client, connectionStatus, supportsHostTerminals, terminalId, verificationAttempt]);
+
+  const handleCreateReplacement = useCallback(() => {
+    if (!client || creating) return;
+    setCreating(true);
+    void (async () => {
+      try {
+        const terminal = await openOrCreateHostTerminal(client, {
+          profileId,
+          forceCreate: true,
+        });
+        router.replace(
+          buildHostTerminalRoute(serverId, terminal.id, {
+            cwd: terminal.cwd,
+            profileId,
+          }) as Href,
+        );
+      } catch {
+        setAvailability("error");
+      } finally {
+        setCreating(false);
+      }
+    })();
+  }, [client, creating, profileId, serverId]);
+
+  const enterFocus = useCallback(() => {
+    setFocused(true);
+    setLayoutRequestToken((current) => current + 1);
+  }, []);
+  const exitFocus = useCallback(() => {
+    setFocused(false);
+    setLayoutRequestToken((current) => current + 1);
+  }, []);
+  const retryVerification = useCallback(() => {
+    setAvailability("checking");
+    setVerificationAttempt((current) => current + 1);
+  }, []);
+  const focusButton = useMemo(
+    () => (
+      <Button variant="ghost" size="sm" leftIcon={Maximize2} onPress={enterFocus}>
+        Focus
+      </Button>
+    ),
+    [enterFocus],
+  );
+
+  const canRenderTerminal = shouldRenderHostTerminal({
+    availability,
+    connectionStatus,
+    hasCwd: cwd.length > 0,
+  });
+
+  if (!canRenderTerminal) {
+    const isConnecting = connectionStatus !== "online" || availability === "checking";
+    let title = "Terminal ended";
+    let detail =
+      "This terminal is no longer running. AiGo will not start a replacement automatically.";
+    if (isConnecting) {
+      title = "Connecting to host…";
+      detail = "AiGo will reattach to the same terminal when the host is available.";
+    } else if (availability === "unsupported") {
+      title = "Update the host to use account terminals";
+      detail = "This AiGo build needs a daemon that supports host-scoped terminals.";
+    } else if (availability === "error") {
+      title = "Could not verify terminal";
+      detail = "AiGo could not check this terminal. Retry without starting another process.";
+    }
+    return (
+      <View style={styles.container}>
+        <BackHeader title={name} />
+        <View style={styles.message}>
+          <Text style={styles.messageTitle}>{title}</Text>
+          <Text style={styles.messageDetail}>{detail}</Text>
+          {availability === "missing" ? (
+            <Button
+              leftIcon={RefreshCw}
+              onPress={handleCreateReplacement}
+              loading={creating}
+              disabled={!client || creating}
+            >
+              Start a new terminal
+            </Button>
+          ) : null}
+          {availability === "error" ? (
+            <Button leftIcon={RefreshCw} onPress={retryVerification}>
+              Retry
+            </Button>
+          ) : null}
+        </View>
+      </View>
+    );
+  }
+
+  return (
+    <View style={styles.container}>
+      {!focused ? <BackHeader title={name} rightContent={focusButton} /> : null}
+      <View style={styles.terminal}>
+        <TerminalPane
+          serverId={serverId}
+          cwd={cwd}
+          terminalId={terminalId}
+          isWorkspaceFocused={navigationFocused}
+          isPaneFocused={navigationFocused}
+          layoutRequestToken={layoutRequestToken}
+          onOpenFileExplorer={ignoreOpenFile}
+          onOpenWorkspaceFile={ignoreOpenFile}
+        />
+      </View>
+      {focused ? (
+        <View style={[styles.restore, { top: insets.top + 8 }]}>
+          <Button variant="secondary" size="sm" leftIcon={Minimize2} onPress={exitFocus}>
+            Exit focus
+          </Button>
+        </View>
+      ) : null}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  container: {
+    flex: 1,
+    backgroundColor: theme.colors.surface0,
+  },
+  terminal: {
+    flex: 1,
+    minHeight: 0,
+  },
+  message: {
+    flex: 1,
+    alignItems: "center",
+    justifyContent: "center",
+    gap: theme.spacing[4],
+    padding: theme.spacing[6],
+  },
+  messageTitle: {
+    color: theme.colors.foreground,
+    fontSize: theme.fontSize.lg,
+  },
+  messageDetail: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.base,
+    textAlign: "center",
+    maxWidth: 480,
+  },
+  restore: {
+    position: "absolute",
+    right: theme.spacing[3],
+    zIndex: 10,
+  },
+}));

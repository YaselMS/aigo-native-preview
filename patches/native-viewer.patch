new file mode 100644
--- /dev/null
+++ b/packages/app/src/push-notifications/preview-diagnostic.ts
@@ -0,0 +1,143 @@
+import type * as Notifications from "expo-notifications";
+
+export const PREVIEW_NOTIFICATION_TEST = "aigo-native-local-test";
+
+type Outcome<T> =
+  | { status: "success"; value: T }
+  | { status: "error"; message: string }
+  | { status: "timeout" };
+
+export interface NotificationDiagnostic {
+  permission: Outcome<Notifications.NotificationPermissionsStatus>;
+  local: Outcome<string> | { status: "skipped" };
+  registration: Outcome<Notifications.NativeDevicePushToken>;
+}
+
+interface DiagnosticInput {
+  api: Pick<
+    typeof Notifications,
+    | "requestPermissionsAsync"
+    | "scheduleNotificationAsync"
+    | "getDevicePushTokenAsync"
+    | "setAutoServerRegistrationEnabledAsync"
+  >;
+  notification: Notifications.NotificationRequestInput;
+  signal: AbortSignal;
+  onPhase: (phase: "permission" | "local" | "registration") => void;
+}
+
+// Native error text can include a token. Reports never include token-shaped strings from errors.
+export function diagnosticError(error: unknown): string {
+  const message = error instanceof Error ? error.message : String(error);
+  return message.replace(/[a-f\d]{32,}/gi, "[redacted]").slice(0, 1200);
+}
+
+async function bounded<T>(operation: () => Promise<T>, timeoutMs: number): Promise<Outcome<T>> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<Outcome<T>>((resolve) => {
+    timer = setTimeout(() => resolve({ status: "timeout" }), timeoutMs);
+  });
+  const attempt = Promise.resolve()
+    .then(operation)
+    .then<Outcome<T>, Outcome<T>>(
+      (value) => ({ status: "success", value }),
+      (error: unknown) => ({ status: "error", message: diagnosticError(error) }),
+    );
+  try {
+    return await Promise.race([attempt, timeout]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+export async function runNotificationDiagnostic({
+  api,
+  notification,
+  signal,
+  onPhase,
+}: DiagnosticInput): Promise<NotificationDiagnostic | null> {
+  if (signal.aborted) return null;
+  onPhase("permission");
+  const permission = await bounded(
+    () =>
+      api.requestPermissionsAsync({
+        ios: { allowAlert: true, allowSound: true, allowBadge: true },
+      }),
+    60_000,
+  );
+  if (signal.aborted) return null;
+  let local: NotificationDiagnostic["local"] = { status: "skipped" };
+  if (permission.status === "success" && permission.value.granted) {
+    onPhase("local");
+    local = await bounded(() => api.scheduleNotificationAsync(notification), 8_000);
+  }
+  if (signal.aborted) return null;
+  onPhase("registration");
+  // Device registration talks to APNs through iOS. Never request an Expo token or publish this token.
+  const registration = await bounded<Notifications.NativeDevicePushToken>(async () => {
+    await api.setAutoServerRegistrationEnabledAsync(false);
+    if (signal.aborted) throw new Error("Diagnostic cancelled before native registration.");
+    const token = await api.getDevicePushTokenAsync();
+    if (token.type !== "ios" || typeof token.data !== "string" || token.data.length === 0) {
+      throw new Error("Native registration did not return an iOS device token.");
+    }
+    return { type: "ios", data: token.data };
+  }, 10_000);
+  if (signal.aborted) return null;
+  return { permission, local, registration };
+}
+
+export interface DiagnosticIdentity {
+  applicationId: string | null;
+  nativeApplicationVersion: string | null;
+  nativeBuildVersion: string | null;
+  configuredBundle: string | null;
+  configuredVersion: string | null;
+  systemVersion: string;
+}
+
+interface ReportInput {
+  identity: DiagnosticIdentity;
+  diagnostic: NotificationDiagnostic;
+  includeToken: boolean;
+}
+
+export function notificationDiagnosticReport({
+  identity,
+  diagnostic,
+  includeToken,
+}: ReportInput): string {
+  const { permission, local, registration } = diagnostic;
+  const lines = ["Aigo native notification diagnostic", JSON.stringify(identity, null, 2)];
+  lines.push(`Permission: ${JSON.stringify(permission)}`);
+  lines.push(`Local test: ${JSON.stringify(local)}`);
+  if (registration.status === "success") {
+    const token = includeToken
+      ? registration.value.data
+      : "[redacted; available via Copy registration details]";
+    lines.push(
+      `Native registration: success (${registration.value.type})`,
+      `Device token: ${token}`,
+    );
+  } else {
+    lines.push(`Native registration: ${JSON.stringify(registration)}`);
+  }
+  if (registration.status === "timeout") {
+    lines.push(
+      "Registration timeout: no result within 10 seconds; native registration may finish later. Reopen the app before retrying.",
+    );
+  }
+  lines.push(
+    "Local test delivery: user observation required; scheduling is not delivery proof.",
+    "Signed APNs entitlement/environment: not inspected.",
+    "Remote delivery: not tested. No token sent to Paseo, Expo push service, or an Aigo server.",
+  );
+  return lines.join("\n");
+}
+
+export function shouldShowPreviewNotification(input: {
+  enabled: boolean;
+  data: Record<string, unknown>;
+}): boolean {
+  return input.enabled && input.data.aigoDiagnostic === PREVIEW_NOTIFICATION_TEST;
+}

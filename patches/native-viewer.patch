--- /dev/null
+++ b/packages/app/src/plugins/react-native/desktop-view-policy.ts
@@ -0,0 +1,57 @@
+import { z } from "zod";
+
+export function desktopOrigin(value: string): string | null {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return null;
+  }
+  const trustedEndpoint =
+    url.protocol === "https:" &&
+    /^[a-z0-9-]+\.trycloudflare\.com$/.test(url.hostname) &&
+    url.port === "" &&
+    url.username === "" &&
+    url.password === "" &&
+    url.pathname === "/" &&
+    url.search === "" &&
+    /^#[a-f0-9]{64}$/.test(url.hash);
+  return trustedEndpoint ? url.origin : null;
+}
+
+export function allowsDesktopNavigation(value: string, origin: string): boolean {
+  try {
+    const url = new URL(value);
+    return url.origin === origin && url.pathname === "/" && url.search === "";
+  } catch {
+    return false;
+  }
+}
+
+const desktopFullscreenSchema = z.object({
+  type: z.literal("aigo:native-fullscreen"),
+  fullscreen: z.boolean(),
+  camera: z
+    .object({
+      zoom: z.number().finite().min(1).max(32),
+      centerX: z.number().finite().min(0).max(100000),
+      centerY: z.number().finite().min(0).max(100000),
+    })
+    .nullable()
+    .default(null),
+});
+
+export type DesktopFullscreenRequest = Omit<z.infer<typeof desktopFullscreenSchema>, "type">;
+
+export function parseDesktopFullscreenRequest(data: string): DesktopFullscreenRequest | null {
+  if (data.length > 1024) return null;
+  let value: unknown;
+  try {
+    value = JSON.parse(data);
+  } catch {
+    return null;
+  }
+  const result = desktopFullscreenSchema.safeParse(value);
+  if (!result.success) return null;
+  return { fullscreen: result.data.fullscreen, camera: result.data.camera };
+}

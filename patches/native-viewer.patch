+
+function formatVersionWithPrefix(version: string | null): string {
+  if (!version) {
+    return "\u2014";
+  }
+
+  return version.startsWith("v") ? version : `v${version}`;
+}
+
+export function resolveAppVersionLabel(): string {
+  const appVersion = resolveAppVersion();
+  if (Constants.expoConfig?.extra?.aigoNativePreview !== true) {
+    return formatVersionWithPrefix(appVersion);
+  }
+
+  const previewVersion = toVersionOrNull(Constants.expoConfig.version) ?? appVersion;
+  const previewLabel =
+    toVersionOrNull(Constants.expoConfig.extra.aigoPreviewLabel) ?? "AiGo Preview";
+  return `${formatVersionWithPrefix(previewVersion)} \u00b7 ${previewLabel}`;
+}

@@ -0,0 +1,9 @@
+export type HostTerminalAvailability = "checking" | "ready" | "missing" | "unsupported" | "error";
+
+export function shouldRenderHostTerminal(input: {
+  availability: HostTerminalAvailability;
+  connectionStatus: string;
+  hasCwd: boolean;
+}): boolean {
+  return input.hasCwd && (input.availability === "ready" || input.connectionStatus !== "online");
+}

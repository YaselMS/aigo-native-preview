+export const LAYOUT_BREAKPOINTS = {
+  xs: 0,
+  sm: 576,
+  md: 720,
+  lg: 992,
+  xl: 1200,
+};
+
+export function isCompactViewport(width: number, height: number, native: boolean): boolean {
+  // A phone remains a compact device when rotated. Changing the entire shell
+  // at landscape width would unmount its active panels and fullscreen viewer.
+  const layoutWidth = native ? Math.min(width, height) : width;
+  return layoutWidth < LAYOUT_BREAKPOINTS.md;
+}

--- /dev/null
+++ b/packages/app/src/terminal/native-renderer/terminal-mouse-events.ts
@@ -0,0 +1,47 @@
+import type {
+  NativeHeadlessTerminalMouseModeState,
+  NativeHeadlessTerminalMouseTrackingMode,
+} from "./headless-terminal-state";
+import type { TerminalGridCellMetrics } from "./terminal-grid-metrics";
+
+export interface NativeTerminalMouseTapInput {
+  point: { x: number; y: number };
+  metrics: TerminalGridCellMetrics;
+  rows: number;
+  cols: number;
+  mode: NativeHeadlessTerminalMouseModeState;
+}
+
+function clampCellCoordinate(value: number, cellSize: number, count: number): number {
+  return Math.min(count, Math.max(1, Math.floor(value / cellSize) + 1));
+}
+
+function encodeSgrLeftClick(
+  col: number,
+  row: number,
+  trackingMode: NativeHeadlessTerminalMouseTrackingMode,
+): string {
+  const press = `\x1b[<0;${col};${row}M`;
+  return trackingMode === "x10" ? press : `${press}\x1b[<0;${col};${row}m`;
+}
+
+/**
+ * Encodes a terminal-native left click when the TUI requested SGR mouse input.
+ * Unsupported encodings return null so the caller can retain ordinary focus behavior.
+ */
+export function resolveNativeTerminalMouseTap(input: NativeTerminalMouseTapInput): string | null {
+  if (
+    input.mode.trackingMode === "none" ||
+    input.mode.encoding !== "sgr" ||
+    input.metrics.cellWidth <= 0 ||
+    input.metrics.cellHeight <= 0 ||
+    input.rows <= 0 ||
+    input.cols <= 0
+  ) {
+    return null;
+  }
+
+  const col = clampCellCoordinate(input.point.x, input.metrics.cellWidth, input.cols);
+  const row = clampCellCoordinate(input.point.y, input.metrics.cellHeight, input.rows);
+  return encodeSgrLeftClick(col, row, input.mode.trackingMode);
+}

diff --git a/packages/app/src/plugins/react-native/desktop-view-policy.test.ts b/packages/app/src/plugins/react-native/desktop-view-policy.test.ts
new file mode 100644
index 0000000..9186b95
--- /dev/null
+++ b/packages/app/src/plugins/react-native/desktop-view-policy.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+import { allowsDesktopNavigation, desktopOrigin } from "./desktop-view-policy";
+
+const origin = "https://aigo-native-test.trycloudflare.com";
+const link = `${origin}/#${"a".repeat(64)}`;
+
+describe("native desktop navigation", () => {
+  it("accepts the private viewer entry and its authenticated root navigation", () => {
+    expect(desktopOrigin(link)).toBe(origin);
+    expect(allowsDesktopNavigation(link, origin)).toBe(true);
+    expect(allowsDesktopNavigation(`${origin}/`, origin)).toBe(true);
+  });
+
+  it.each([
+    "https://example.com/#" + "a".repeat(64),
+    link.replace("https:", "http:"),
+    link.replace(".com/", ".com.attacker.test/"),
+    link.replace("/#", "/other#"),
+    link.replace("/#", "/?token="),
+    link.replace("https://", "https://user:secret@"),
+    `${origin}/#short`,
+    "file:///test",
+    "javascript:alert(1)",
+  ])("rejects an invalid or unexpected desktop link: %s", (value) => {
+    expect(desktopOrigin(value)).toBe(null);
+  });
+
+  it.each([
+    "https://example.com/",
+    "paseo://pair",
+    "file:///test",
+    `${origin}/credentials`,
+    `${origin}/?redirect=elsewhere`,
+  ])("keeps navigation within the viewer root: %s", (value) => {
+    expect(allowsDesktopNavigation(value, origin)).toBe(false);
+  });
+});
diff --git a/packages/app/src/plugins/react-native/desktop-view-policy.ts b/packages/app/src/plugins/react-native/desktop-view-policy.ts
new file mode 100644
index 0000000..1f5a3cd
--- /dev/null
+++ b/packages/app/src/plugins/react-native/desktop-view-policy.ts
@@ -0,0 +1,27 @@
+export function desktopOrigin(value: string): string | null {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return null;
+  }
+  const trustedEndpoint =
+    url.protocol === "https:" &&
+    /^[a-z0-9-]+\.trycloudflare\.com$/.test(url.hostname) &&
+    url.port === "" &&
+    url.username === "" &&
+    url.password === "" &&
+    url.pathname === "/" &&
+    url.search === "" &&
+    /^#[a-f0-9]{64}$/.test(url.hash);
+  return trustedEndpoint ? url.origin : null;
+}
+
+export function allowsDesktopNavigation(value: string, origin: string): boolean {
+  try {
+    const url = new URL(value);
+    return url.origin === origin && url.pathname === "/" && url.search === "";
+  } catch {
+    return false;
+  }
+}
diff --git a/packages/app/src/plugins/react-native/desktop-view.native.tsx b/packages/app/src/plugins/react-native/desktop-view.native.tsx
new file mode 100644
index 0000000..1013c74
--- /dev/null
+++ b/packages/app/src/plugins/react-native/desktop-view.native.tsx
@@ -0,0 +1,112 @@
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { ActivityIndicator, AppState, Pressable, Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { WebView, type WebViewNavigation } from "react-native-webview";
+import type { DesktopViewProps } from "@getpaseo/plugin/react-native";
+import { usePaneFocus } from "@/panels/pane-context";
+import { useRetainedPanelActive } from "@/components/retained-panel";
+import { allowsDesktopNavigation, desktopOrigin } from "./desktop-view-policy";
+
+export function DesktopView({ url }: DesktopViewProps) {
+  const { isInteractive } = usePaneFocus();
+  const panelActive = useRetainedPanelActive();
+  const [appState, setAppState] = useState(AppState.currentState);
+  useEffect(() => {
+    const listener = AppState.addEventListener("change", setAppState);
+    return () => listener.remove();
+  }, []);
+  const origin = desktopOrigin(url);
+  if (!origin) {
+    return <DesktopMessage message="The desktop link is invalid. Reconnect from this panel." />;
+  }
+  const active = panelActive && isInteractive && appState === "active";
+  if (!active) {
+    // Destroy the WebView, rather than retaining a hidden socket that renews human ownership.
+    return <DesktopMessage message="Desktop disconnected while this panel is inactive." />;
+  }
+  return <ConnectedDesktop key={url} url={url} origin={origin} />;
+}
+
+function ConnectedDesktop({ url, origin }: DesktopViewProps & { origin: string }) {
+  const [failed, setFailed] = useState(false);
+  const [loading, setLoading] = useState(true);
+  const source = useMemo(() => ({ uri: url }), [url]);
+  const retry = useCallback(() => {
+    setLoading(true);
+    setFailed(false);
+  }, []);
+  const fail = useCallback(() => setFailed(true), []);
+  const loaded = useCallback(() => setLoading(false), []);
+  const allowNavigation = useCallback(
+    (request: WebViewNavigation) => allowsDesktopNavigation(request.url, origin),
+    [origin],
+  );
+  if (failed) {
+    return (
+      <View style={styles.message}>
+        <Text style={styles.text}>
+          Desktop connection failed. Check that the PC viewer is running.
+        </Text>
+        <Pressable accessibilityRole="button" onPress={retry} style={styles.button}>
+          <Text style={styles.text}>Retry connection</Text>
+        </Pressable>
+      </View>
+    );
+  }
+  return (
+    <View style={styles.container}>
+      <WebView
+        source={source}
+        style={styles.container}
+        containerStyle={styles.container}
+        incognito
+        cacheEnabled={false}
+        sharedCookiesEnabled={false}
+        thirdPartyCookiesEnabled={false}
+        // Handle every attempted navigation ourselves; don't dispatch rejected links to other apps.
+        originWhitelist={["*"]}
+        onShouldStartLoadWithRequest={allowNavigation}
+        onOpenWindow={fail}
+        setSupportMultipleWindows
+        allowsLinkPreview={false}
+        allowFileAccess={false}
+        allowFileAccessFromFileURLs={false}
+        allowUniversalAccessFromFileURLs={false}
+        mixedContentMode="never"
+        bounces={false}
+        automaticallyAdjustContentInsets={false}
+        contentInsetAdjustmentBehavior="never"
+        onLoadEnd={loaded}
+        onError={fail}
+        onHttpError={fail}
+        onContentProcessDidTerminate={fail}
+        onRenderProcessGone={fail}
+      />
+      {loading ? (
+        <ActivityIndicator style={styles.loading} accessibilityLabel="Connecting to desktop" />
+      ) : null}
+    </View>
+  );
+}
+
+function DesktopMessage({ message }: { message: string }) {
+  return (
+    <View style={styles.message}>
+      <Text style={styles.text}>{message}</Text>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  container: { flex: 1, backgroundColor: theme.colors.surface0 },
+  message: {
+    flex: 1,
+    padding: 16,
+    gap: 16,
+    justifyContent: "center",
+    backgroundColor: theme.colors.surface0,
+  },
+  text: { color: theme.colors.foreground },
+  button: { padding: 12, borderRadius: 8, backgroundColor: theme.colors.surface1 },
+  loading: { position: "absolute", top: 16, alignSelf: "center" },
+}));

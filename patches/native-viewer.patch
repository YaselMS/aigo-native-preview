--- /dev/null
+++ b/packages/app/src/push-notifications/preview-diagnostic.test.ts
@@ -0,0 +1,216 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { PermissionStatus } from "expo-modules-core";
+import type * as Notifications from "expo-notifications";
+import {
+  diagnosticError,
+  notificationDiagnosticReport,
+  PREVIEW_NOTIFICATION_TEST,
+  runNotificationDiagnostic,
+  shouldShowPreviewNotification,
+} from "./preview-diagnostic";
+
+const permission: Notifications.NotificationPermissionsStatus = {
+  status: PermissionStatus.GRANTED,
+  granted: true,
+  canAskAgain: true,
+  expires: "never",
+};
+const token: Notifications.NativeDevicePushToken = { type: "ios", data: "a".repeat(64) };
+const notification: Notifications.NotificationRequestInput = {
+  content: { title: "Aigo local test", data: { aigoDiagnostic: PREVIEW_NOTIFICATION_TEST } },
+  trigger: null,
+};
+
+function setup() {
+  const api = {
+    setAutoServerRegistrationEnabledAsync: vi
+      .fn<(enabled: boolean) => Promise<void>>()
+      .mockResolvedValue(undefined),
+    requestPermissionsAsync: vi
+      .fn<() => Promise<Notifications.NotificationPermissionsStatus>>()
+      .mockResolvedValue(permission),
+    scheduleNotificationAsync: vi.fn<() => Promise<string>>().mockResolvedValue("local-test-id"),
+    getDevicePushTokenAsync: vi
+      .fn<() => Promise<Notifications.DevicePushToken>>()
+      .mockResolvedValue(token),
+  };
+  const controller = new AbortController();
+  const onPhase = vi.fn();
+  return {
+    api,
+    controller,
+    run: () => runNotificationDiagnostic({ api, notification, signal: controller.signal, onPhase }),
+    onPhase,
+  };
+}
+
+afterEach(() => vi.useRealTimers());
+
+describe("preview native notification diagnostic", () => {
+  it("requests permission, schedules the supplied local alert, and registers natively", async () => {
+    const test = setup();
+    expect(await test.run()).toEqual({
+      permission: { status: "success", value: permission },
+      local: { status: "success", value: "local-test-id" },
+      registration: { status: "success", value: token },
+    });
+    expect(test.api.requestPermissionsAsync).toHaveBeenCalledWith({
+      ios: { allowAlert: true, allowSound: true, allowBadge: true },
+    });
+    expect(test.api.scheduleNotificationAsync).toHaveBeenCalledExactlyOnceWith(notification);
+    expect(test.api.setAutoServerRegistrationEnabledAsync).toHaveBeenCalledExactlyOnceWith(false);
+    expect(test.onPhase.mock.calls).toEqual([["permission"], ["local"], ["registration"]]);
+  });
+
+  it("reports denial without scheduling and still exposes a missing APNs entitlement", async () => {
+    const test = setup();
+    const denied = {
+      ...permission,
+      status: PermissionStatus.DENIED,
+      granted: false,
+      canAskAgain: false,
+    };
+    test.api.requestPermissionsAsync.mockResolvedValue(denied);
+    test.api.getDevicePushTokenAsync.mockRejectedValue(
+      new Error("no valid aps-environment entitlement string found"),
+    );
+    expect(await test.run()).toEqual({
+      permission: { status: "success", value: denied },
+      local: { status: "skipped" },
+      registration: {
+        status: "error",
+        message: "no valid aps-environment entitlement string found",
+      },
+    });
+    expect(test.api.scheduleNotificationAsync).not.toHaveBeenCalled();
+  });
+
+  it("keeps permission and scheduling failures visible independently of registration", async () => {
+    const test = setup();
+    test.api.scheduleNotificationAsync.mockRejectedValue(new Error("Scheduling unavailable"));
+    expect(await test.run()).toMatchObject({
+      local: { status: "error", message: "Scheduling unavailable" },
+      registration: { status: "success" },
+    });
+    test.api.requestPermissionsAsync.mockRejectedValue(new Error("Permission API unavailable"));
+    expect(await test.run()).toMatchObject({
+      permission: { status: "error", message: "Permission API unavailable" },
+      local: { status: "skipped" },
+    });
+  });
+
+  it("refuses native registration if disabling Expo auto-upload fails", async () => {
+    const test = setup();
+    test.api.setAutoServerRegistrationEnabledAsync.mockRejectedValue(
+      new Error("Cannot disable auto-upload"),
+    );
+    expect(await test.run()).toMatchObject({
+      registration: { status: "error", message: "Cannot disable auto-upload" },
+    });
+    expect(test.api.getDevicePushTokenAsync).not.toHaveBeenCalled();
+  });
+
+  it("finishes after a 10 second APNs timeout and ignores a late token", async () => {
+    vi.useFakeTimers();
+    const test = setup();
+    let resolveToken: (value: Notifications.DevicePushToken) => void = () => {};
+    test.api.getDevicePushTokenAsync.mockImplementation(
+      () =>
+        new Promise((resolve) => {
+          resolveToken = resolve;
+        }),
+    );
+    const pending = test.run();
+    await vi.advanceTimersByTimeAsync(10_000);
+    const result = await pending;
+    expect(result?.registration).toEqual({ status: "timeout" });
+    resolveToken(token);
+    await vi.advanceTimersByTimeAsync(0);
+    expect(result?.registration).toEqual({ status: "timeout" });
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("bounds a stalled permission request and a stalled scheduler", async () => {
+    vi.useFakeTimers();
+    const test = setup();
+    test.api.requestPermissionsAsync.mockImplementation(() => new Promise(() => {}));
+    const permissionPending = test.run();
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(await permissionPending).toMatchObject({
+      permission: { status: "timeout" },
+      local: { status: "skipped" },
+    });
+    test.api.requestPermissionsAsync.mockResolvedValue(permission);
+    test.api.scheduleNotificationAsync.mockImplementation(() => new Promise(() => {}));
+    const schedulePending = test.run();
+    await vi.advanceTimersByTimeAsync(8_000);
+    expect(await schedulePending).toMatchObject({
+      local: { status: "timeout" },
+      registration: { status: "success" },
+    });
+  });
+
+  it("does not start another phase or publish a stale result after unmount", async () => {
+    const test = setup();
+    test.api.requestPermissionsAsync.mockImplementation(async () => {
+      test.controller.abort();
+      return permission;
+    });
+    expect(await test.run()).toBeNull();
+    expect(test.api.scheduleNotificationAsync).not.toHaveBeenCalled();
+    expect(test.api.getDevicePushTokenAsync).not.toHaveBeenCalled();
+    expect(test.onPhase.mock.calls).toEqual([["permission"]]);
+  });
+
+  it("does not publish a token after leaving during registration", async () => {
+    const test = setup();
+    test.api.getDevicePushTokenAsync.mockImplementation(async () => {
+      test.controller.abort();
+      return token;
+    });
+    expect(await test.run()).toBeNull();
+  });
+
+  it("masks tokens in the ordinary report, includes signed identity, and separates remote proof", async () => {
+    const diagnostic = await setup().run();
+    if (!diagnostic) throw new Error("Expected a diagnostic result");
+    const identity = {
+      applicationId: "signed.aigo.preview",
+      nativeApplicationVersion: "0.7.5",
+      nativeBuildVersion: "7005999",
+      configuredBundle: "dev.aigo.preview",
+      configuredVersion: "0.7.5",
+      systemVersion: "26",
+    };
+    const report = notificationDiagnosticReport({ identity, diagnostic, includeToken: false });
+    expect(report).not.toContain(token.data);
+    expect(report).toContain("signed.aigo.preview");
+    expect(report).toContain("dev.aigo.preview");
+    expect(report).toContain("Remote delivery: not tested");
+    expect(report).not.toContain("Registration timeout:");
+    expect(notificationDiagnosticReport({ identity, diagnostic, includeToken: true })).toContain(
+      token.data,
+    );
+    expect(diagnosticError(new Error(`Failed token ${token.data}`))).toBe(
+      "Failed token [redacted]",
+    );
+  });
+
+  it("only presents and intercepts explicitly marked preview diagnostics", () => {
+    expect(
+      shouldShowPreviewNotification({
+        enabled: true,
+        data: { aigoDiagnostic: PREVIEW_NOTIFICATION_TEST },
+      }),
+    ).toBe(true);
+    expect(
+      shouldShowPreviewNotification({
+        enabled: false,
+        data: { aigoDiagnostic: PREVIEW_NOTIFICATION_TEST },
+      }),
+    ).toBe(false);
+    expect(shouldShowPreviewNotification({ enabled: true, data: { agentId: "agent" } })).toBe(
+      false,
+    );
+  });
+});

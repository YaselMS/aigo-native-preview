+export function buildHostTerminalRoute(
+  serverId: string,
+  terminalId: string,
+  options: { cwd?: string; profileId?: string } = {},
+) {
+  const base = buildHostRootRoute(serverId);
+  const normalizedTerminalId = trimNonEmpty(terminalId);
+  if (base === "/" || !normalizedTerminalId) {
+    return "/" as const;
+  }
+  const params = new URLSearchParams();
+  const cwd = trimNonEmpty(options.cwd);
+  const profileId = trimNonEmpty(options.profileId);
+  if (cwd) params.set("cwd", cwd);
+  if (profileId) params.set("profile", profileId);
+  const query = params.toString();
+  return `${base}/terminal/${encodeSegment(normalizedTerminalId)}${query ? `?${query}` : ""}` as const;
+}

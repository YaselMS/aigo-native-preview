+import { describe, expect, it } from "vitest";
+import { shouldRenderHostTerminal } from "./host-terminal-screen-state";
+
+describe("host terminal screen state", () => {
+  it("renders only a verified terminal while the host is online", () => {
+    for (const availability of ["checking", "missing", "unsupported", "error"] as const) {
+      expect(
+        shouldRenderHostTerminal({ availability, connectionStatus: "online", hasCwd: true }),
+      ).toBe(false);
+    }
+    expect(
+      shouldRenderHostTerminal({
+        availability: "ready",
+        connectionStatus: "online",
+        hasCwd: true,
+      }),
+    ).toBe(true);
+  });
+
+  it("keeps the exact terminal surface mounted during a host disconnect", () => {
+    expect(
+      shouldRenderHostTerminal({
+        availability: "checking",
+        connectionStatus: "connecting",
+        hasCwd: true,
+      }),
+    ).toBe(true);
+  });
+
+  it("never renders without route cwd context", () => {
+    expect(
+      shouldRenderHostTerminal({
+        availability: "ready",
+        connectionStatus: "online",
+        hasCwd: false,
+      }),
+    ).toBe(false);
+  });
+});

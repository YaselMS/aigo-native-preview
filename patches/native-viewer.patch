index 0000000000000000000000000000000000000000..1d2e63a6c78a38e5684e5378901c3e52d837cc64
--- /dev/null
+++ b/packages/app/src/stores/last-host-terminal-route.ts
@@ -0,0 +1,65 @@
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import { useEffect, useState } from "react";
+import { create } from "zustand";
+import { persist } from "zustand/middleware";
+import { z } from "zod";
+import { createValidatedPersistStorage } from "@/storage/validated-persist-storage";
+
+const HostTerminalRouteSelectionSchema = z.strictObject({
+  serverId: z.string(),
+  terminalId: z.string(),
+  cwd: z.string(),
+  profileId: z.string().optional(),
+});
+
+const LastHostTerminalRoutePersistedStateSchema = z.strictObject({
+  selection: HostTerminalRouteSelectionSchema.nullable(),
+});
+
+export type HostTerminalRouteSelection = z.infer<typeof HostTerminalRouteSelectionSchema>;
+
+interface LastHostTerminalRouteState {
+  selection: HostTerminalRouteSelection | null;
+  remember: (selection: HostTerminalRouteSelection) => void;
+  clear: (selection: Pick<HostTerminalRouteSelection, "serverId" | "terminalId">) => void;
+}
+
+export const useLastHostTerminalRouteStore = create<LastHostTerminalRouteState>()(
+  persist(
+    (set) => ({
+      selection: null,
+      remember: (selection) => set({ selection }),
+      clear: (selection) =>
+        set((state) =>
+          state.selection?.serverId === selection.serverId &&
+          state.selection.terminalId === selection.terminalId
+            ? { selection: null }
+            : state,
+        ),
+    }),
+    {
+      name: "aigo:last-host-terminal-route",
+      storage: createValidatedPersistStorage(
+        AsyncStorage,
+        LastHostTerminalRoutePersistedStateSchema,
+      ),
+      partialize: (state) => ({ selection: state.selection }),
+    },
+  ),
+);
+
+export function useLastHostTerminalRouteHydrated(): boolean {
+  const [hydrated, setHydrated] = useState(() =>
+    useLastHostTerminalRouteStore.persist.hasHydrated(),
+  );
+
+  useEffect(() => {
+    if (useLastHostTerminalRouteStore.persist.hasHydrated()) {
+      setHydrated(true);
+      return;
+    }
+    return useLastHostTerminalRouteStore.persist.onFinishHydration(() => setHydrated(true));
+  }, []);
+
+  return hydrated;
+}

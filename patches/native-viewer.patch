diff --git a/packages/app/src/agent-stream/permission-response-feedback.test.tsx b/packages/app/src/agent-stream/permission-response-feedback.test.tsx
new file mode 100644
--- /dev/null
+++ b/packages/app/src/agent-stream/permission-response-feedback.test.tsx
@@ -0,0 +1,107 @@
+/** @vitest-environment jsdom */
+import React from "react";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { createInstance } from "i18next";
+import { I18nextProvider, initReactI18next } from "react-i18next";
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { en } from "@/i18n/resources/en";
+import { PermissionResponseFeedback } from "./permission-response-feedback";
+import { QuestionFormCard } from "@/components/question-form-card";
+import type { PendingPermission } from "@/types/shared";
+
+const permission: PendingPermission = {
+  key: "agent:question",
+  agentId: "agent",
+  request: {
+    id: "question",
+    provider: "opencode",
+    name: "Question",
+    kind: "question",
+    input: {
+      questions: [{ header: "Choice", question: "Choose a value", options: [{ label: "Final" }] }],
+    },
+  },
+};
+
+const i18n = createInstance();
+const ignoreCheck = () => undefined;
+beforeAll(async () => {
+  await i18n.use(initReactI18next).init({ lng: "en", resources: { en: { translation: en } } });
+});
+afterEach(cleanup);
+
+describe("permission response feedback", () => {
+  it("keeps a completed question selection visible but blocks another submission when uncertain", () => {
+    const respond = vi.fn();
+    const card = (blocked: boolean) => (
+      <I18nextProvider i18n={i18n}>
+        <QuestionFormCard
+          permission={permission}
+          onRespond={respond}
+          isResponding={false}
+          isResponseBlocked={blocked}
+        />
+      </I18nextProvider>
+    );
+    const { rerender } = render(card(false));
+    fireEvent.click(screen.getByRole("radio", { name: "Final" }));
+    fireEvent.click(screen.getByRole("button", { name: "Submit" }));
+    expect(respond).toHaveBeenCalledTimes(1);
+    rerender(card(true));
+    expect(screen.getByRole("radio", { name: "Final" }).getAttribute("aria-checked")).toBe("true");
+    expect(screen.getByRole("button", { name: "Submit" }).getAttribute("aria-disabled")).toBe(
+      "true",
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Submit" }));
+    expect(respond).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps uncertainty visible and offers a status check without an approval action", () => {
+    const checkStatus = vi.fn();
+    render(
+      <I18nextProvider i18n={i18n}>
+        <PermissionResponseFeedback status="uncertain" onCheckStatus={checkStatus} />
+      </I18nextProvider>,
+    );
+    expect(screen.getByRole("alert").textContent).toBe(
+      en.agentStream.permission.response.uncertain,
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Check status" }));
+    expect(checkStatus).toHaveBeenCalledTimes(1);
+    expect(screen.getAllByRole("button")).toHaveLength(1);
+    expect(screen.getByRole("alert").textContent).toBe(
+      en.agentStream.permission.response.uncertain,
+    );
+  });
+
+  it("shows offline recovery, then progress and a neutral no-longer-pending result", () => {
+    const feedback = (status: "unavailable" | "pending" | "complete") => (
+      <I18nextProvider i18n={i18n}>
+        <PermissionResponseFeedback status={status} onCheckStatus={ignoreCheck} />
+      </I18nextProvider>
+    );
+    const { rerender } = render(feedback("unavailable"));
+    expect(screen.getByRole("alert").textContent).toBe(
+      en.agentStream.permission.response.unavailable,
+    );
+    expect(screen.getByRole("button", { name: "Check status" }).textContent).toBe("Check status");
+    rerender(feedback("pending"));
+    expect(screen.getByRole("alert").textContent).toBe(en.agentStream.permission.response.pending);
+    expect(screen.queryByRole("button")).toBeNull();
+    rerender(feedback("complete"));
+    expect(screen.getByRole("alert").textContent).toBe("This request is no longer pending.");
+    expect(screen.queryByRole("button")).toBeNull();
+  });
+
+  it("explains that a stale request was not sent", () => {
+    render(
+      <I18nextProvider i18n={i18n}>
+        <PermissionResponseFeedback status="stale" onCheckStatus={ignoreCheck} />
+      </I18nextProvider>,
+    );
+    expect(screen.getByRole("alert").textContent).toBe(
+      "This request is no longer pending. No response was sent.",
+    );
+    expect(screen.queryByRole("button")).toBeNull();
+  });
+});

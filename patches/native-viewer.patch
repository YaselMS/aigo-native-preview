+import { describe, expect, it } from "vitest";
+import {
+  allowsDesktopNavigation,
+  desktopOrigin,
+  parseDesktopFullscreenRequest,
+} from "./desktop-view-policy";
+
+const origin = "https://aigo-native-test.trycloudflare.com";
+const link = `${origin}/#${"a".repeat(64)}`;
+
+describe("native desktop navigation", () => {
+  it("accepts the private viewer entry and its authenticated root navigation", () => {
+    expect(desktopOrigin(link)).toBe(origin);
+    expect(allowsDesktopNavigation(link, origin)).toBe(true);
+    expect(allowsDesktopNavigation(`${origin}/`, origin)).toBe(true);
+  });
+
+  it.each([
+    "https://example.com/#" + "a".repeat(64),
+    link.replace("https:", "http:"),
+    link.replace(".com/", ".com.attacker.test/"),
+    link.replace("/#", "/other#"),
+    link.replace("/#", "/?token="),
+    link.replace("https://", "https://user:secret@"),
+    `${origin}/#short`,
+    "file:///test",
+    "javascript:alert(1)",
+  ])("rejects an invalid or unexpected desktop link: %s", (value) => {
+    expect(desktopOrigin(value)).toBe(null);
+  });
+
+  it.each([
+    "https://example.com/",
+    "paseo://pair",
+    "file:///test",
+    `${origin}/credentials`,
+    `${origin}/?redirect=elsewhere`,
+  ])("keeps navigation within the viewer root: %s", (value) => {
+    expect(allowsDesktopNavigation(value, origin)).toBe(false);
+  });
+});
+
+describe("native desktop fullscreen bridge", () => {
+  it("accepts an explicit presentation request with camera coordinates only", () => {
+    expect(
+      parseDesktopFullscreenRequest(
+        JSON.stringify({
+          type: "aigo:native-fullscreen",
+          fullscreen: true,
+          camera: { zoom: 2, centerX: 960, centerY: 540 },
+          lease: "must-not-cross-the-bridge",
+        }),
+      ),
+    ).toEqual({ fullscreen: true, camera: { zoom: 2, centerX: 960, centerY: 540 } });
+    expect(
+      parseDesktopFullscreenRequest(
+        JSON.stringify({
+          type: "aigo:native-fullscreen",
+          fullscreen: false,
+        }),
+      ),
+    ).toEqual({ fullscreen: false, camera: null });
+  });
+
+  it.each([
+    "not json",
+    "null",
+    "[]",
+    "x".repeat(1025),
+    JSON.stringify({ type: "take-control", fullscreen: true }),
+    JSON.stringify({ type: "aigo:native-fullscreen", fullscreen: "true" }),
+    JSON.stringify({ type: "aigo:native-fullscreen", fullscreen: true, camera: {} }),
+    JSON.stringify({
+      type: "aigo:native-fullscreen",
+      fullscreen: true,
+      camera: { zoom: -1, centerX: 0, centerY: 0 },
+    }),
+    JSON.stringify({
+      type: "aigo:native-fullscreen",
+      fullscreen: true,
+      camera: { zoom: 2, centerX: 100001, centerY: 0 },
+    }),
+  ])("ignores malformed and unrelated messages: %s", (data) => {
+    expect(parseDesktopFullscreenRequest(data)).toBeNull();
+  });
+});
diff --git a/packages/app/src/plugins/react-native/desktop-view-policy.ts b/packages/app/src/plugins/react-native/desktop-view-policy.ts
new file mode 100644
index 0000000..ebab5dd
--- /dev/null
+++ b/packages/app/src/plugins/react-native/desktop-view-policy.ts
@@ -0,0 +1,57 @@
+import { z } from "zod";
+
+export function desktopOrigin(value: string): string | null {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return null;
+  }
+  const trustedEndpoint =
+    url.protocol === "https:" &&
+    /^[a-z0-9-]+\.trycloudflare\.com$/.test(url.hostname) &&
+    url.port === "" &&
+    url.username === "" &&
+    url.password === "" &&
+    url.pathname === "/" &&
+    url.search === "" &&
+    /^#[a-f0-9]{64}$/.test(url.hash);
+  return trustedEndpoint ? url.origin : null;
+}
+
+export function allowsDesktopNavigation(value: string, origin: string): boolean {
+  try {
+    const url = new URL(value);
+    return url.origin === origin && url.pathname === "/" && url.search === "";
+  } catch {
+    return false;
+  }
+}
+
+const desktopFullscreenSchema = z.object({
+  type: z.literal("aigo:native-fullscreen"),
+  fullscreen: z.boolean(),
+  camera: z
+    .object({
+      zoom: z.number().finite().min(1).max(32),
+      centerX: z.number().finite().min(0).max(100000),
+      centerY: z.number().finite().min(0).max(100000),
+    })
+    .nullable()
+    .default(null),
+});
+
+export type DesktopFullscreenRequest = Omit<z.infer<typeof desktopFullscreenSchema>, "type">;
+
+export function parseDesktopFullscreenRequest(data: string): DesktopFullscreenRequest | null {
+  if (data.length > 1024) return null;
+  let value: unknown;
+  try {
+    value = JSON.parse(data);
+  } catch {
+    return null;
+  }
+  const result = desktopFullscreenSchema.safeParse(value);
+  if (!result.success) return null;
+  return { fullscreen: result.data.fullscreen, camera: result.data.camera };
+}
diff --git a/packages/app/src/plugins/react-native/desktop-view.native.test.tsx b/packages/app/src/plugins/react-native/desktop-view.native.test.tsx

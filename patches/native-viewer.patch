diff --git a/packages/app/src/panels/provider-subagent-history.test.ts b/packages/app/src/panels/provider-subagent-history.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5167f213969608c1a711692d6889fc18c288a843
--- /dev/null
+++ b/packages/app/src/panels/provider-subagent-history.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from "vitest";
+import { createProviderHistoryRequests } from "./provider-subagent-history";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+}
+
+describe("provider child history requests", () => {
+  it.each(["initial", "older"] as const)(
+    "preserves cached history after %s failure and permits retry",
+    async (kind) => {
+      const gate = createProviderHistoryRequests();
+      gate.activate();
+      let cached = "cached transcript";
+      await gate.run(
+        kind,
+        async () => {
+          throw new Error("disconnected");
+        },
+        (value: string) => {
+          cached = value;
+        },
+      );
+      expect(gate.getSnapshot()[kind]).toBe("error");
+      expect(cached).toBe("cached transcript");
+      const retry = deferred<string>();
+      const operation = gate.run(
+        kind,
+        () => retry.promise,
+        (value) => {
+          cached = value;
+        },
+      );
+      expect(gate.getSnapshot()[kind]).toBe("loading");
+      retry.resolve("recovered transcript");
+      await operation;
+      expect(gate.getSnapshot()[kind]).toBe("ready");
+      expect(cached).toBe("recovered transcript");
+    },
+  );
+
+  it("ignores completion after target disposal, including effect reactivation", async () => {
+    const gate = createProviderHistoryRequests();
+    gate.activate();
+    const old = deferred<string>();
+    const applied: string[] = [];
+    const first = gate.run(
+      "initial",
+      () => old.promise,
+      (value) => applied.push(value),
+    );
+    gate.dispose();
+    gate.activate();
+    await gate.run(
+      "initial",
+      async () => "new",
+      (value) => applied.push(value),
+    );
+    old.resolve("stale");
+    await first;
+    expect(applied).toEqual(["new"]);
+    expect(gate.getSnapshot().initial).toBe("ready");
+  });
+
+  it("does not issue duplicate requests or surface errors from a disposed target", async () => {
+    const gate = createProviderHistoryRequests();
+    gate.activate();
+    const pending = deferred<string>();
+    let calls = 0;
+    const request = () => {
+      calls++;
+      return pending.promise;
+    };
+    const first = gate.run("older", request, () => {});
+    await gate.run("older", request, () => {});
+    expect(calls).toBe(1);
+    gate.dispose();
+    gate.activate();
+    pending.reject(new Error("old connection"));
+    await first;
+    expect(gate.getSnapshot().older).toBe("idle");
+  });
+});
diff --git a/packages/app/src/panels/provider-subagent-history.ts b/packages/app/src/panels/provider-subagent-history.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2a795836bab8461ffb0d0a34a26814d616d4c0c0
--- /dev/null
+++ b/packages/app/src/panels/provider-subagent-history.ts
@@ -0,0 +1,50 @@
+export type HistoryRequestPhase = "idle" | "loading" | "ready" | "error";
+export type HistoryRequestKind = "initial" | "older";
+
+/** Each panel target owns a gate; disposed requests cannot update its replacement or cache. */
+export function createProviderHistoryRequests() {
+  let generation = 0;
+  let active = false;
+  let state: Record<HistoryRequestKind, HistoryRequestPhase> = { initial: "idle", older: "idle" };
+  const listeners = new Set<() => void>();
+  const update = (kind: HistoryRequestKind, phase: HistoryRequestPhase) => {
+    state = { ...state, [kind]: phase };
+    for (const listener of listeners) listener();
+  };
+  return {
+    getSnapshot: () => state,
+    subscribe: (listener: () => void) => {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+    activate: () => {
+      active = true;
+      generation++;
+      state = { initial: "idle", older: "idle" };
+      for (const listener of listeners) listener();
+    },
+    dispose: () => {
+      active = false;
+      generation++;
+    },
+    async run<T>(
+      kind: HistoryRequestKind,
+      request: () => Promise<T>,
+      apply: (value: T) => void,
+    ): Promise<void> {
+      if (!active || state[kind] === "loading") return;
+      const current = generation;
+      update(kind, "loading");
+      try {
+        const value = await request();
+        if (!active || current !== generation) return;
+        apply(value);
+        update(kind, "ready");
+      } catch {
+        if (active && current === generation) update(kind, "error");
+      }
+    },
+  };
+}

@@ -0,0 +1,190 @@
+import React, { useCallback, useEffect, useMemo, useState } from "react";
+import { ActivityIndicator, AppState, Modal, StatusBar, Text, View } from "react-native";
+import { SafeAreaProvider, SafeAreaView } from "react-native-safe-area-context";
+import { StyleSheet } from "react-native-unistyles";
+import { WebView, type WebViewMessageEvent, type WebViewNavigation } from "react-native-webview";
+import type { DesktopViewProps } from "@getpaseo/plugin/react-native";
+import { usePaneFocus } from "@/panels/pane-context";
+import { useRetainedPanelActive } from "@/components/retained-panel";
+import { Button } from "@/components/ui/button";
+import {
+  allowsDesktopNavigation,
+  desktopOrigin,
+  parseDesktopFullscreenRequest,
+  type DesktopFullscreenRequest,
+} from "./desktop-view-policy";
+
+export function DesktopView({ url }: DesktopViewProps) {
+  const { isInteractive } = usePaneFocus();
+  const panelActive = useRetainedPanelActive();
+  const [appState, setAppState] = useState(AppState.currentState);
+  useEffect(() => {
+    const listener = AppState.addEventListener("change", setAppState);
+    return () => listener.remove();
+  }, []);
+  const origin = desktopOrigin(url);
+  if (!origin) {
+    return <DesktopMessage message="The desktop link is invalid. Reconnect from this panel." />;
+  }
+  const active = panelActive && isInteractive && appState === "active";
+  if (!active) {
+    // Destroy the WebView, rather than retaining a hidden socket that renews human ownership.
+    return <DesktopMessage message="Desktop disconnected while this panel is inactive." />;
+  }
+  return <ConnectedDesktop key={url} url={url} origin={origin} />;
+}
+
+function ConnectedDesktop({ url, origin }: DesktopViewProps & { origin: string }) {
+  const [presentation, setPresentation] = useState<DesktopFullscreenRequest>({
+    fullscreen: false,
+    camera: null,
+  });
+  const onMessage = useCallback(
+    (event: WebViewMessageEvent) => {
+      if (!allowsDesktopNavigation(event.nativeEvent.url, origin)) return;
+      const request = parseDesktopFullscreenRequest(event.nativeEvent.data);
+      if (request) setPresentation(request);
+    },
+    [origin],
+  );
+  const exitFullscreen = useCallback(() => {
+    setPresentation({ fullscreen: false, camera: null });
+  }, []);
+  const viewer = (
+    <DesktopWebView url={url} origin={origin} presentation={presentation} onMessage={onMessage} />
+  );
+  if (!presentation.fullscreen) return viewer;
+  // Moving into a native Modal recreates WKWebView. Keep only camera state, never the
+  // control lease: closing the old socket releases held input and requires a new takeover.
+  return (
+    <Modal
+      visible
+      animationType="none"
+      presentationStyle="fullScreen"
+      supportedOrientations={["portrait", "landscape-left", "landscape-right"]}
+      statusBarTranslucent
+      navigationBarTranslucent
+      onRequestClose={exitFullscreen}
+    >
+      <SafeAreaProvider>
+        <SafeAreaView style={styles.container}>
+          <StatusBar hidden />
+          <View style={styles.toolbar}>
+            <Text style={styles.title}>Desktop</Text>
+            <Button variant="ghost" size="sm" onPress={exitFullscreen}>
+              Done
+            </Button>
+          </View>
+          {viewer}
+        </SafeAreaView>
+      </SafeAreaProvider>
+    </Modal>
+  );
+}
+
+interface DesktopWebViewProps extends DesktopViewProps {
+  origin: string;
+  presentation: DesktopFullscreenRequest;
+  onMessage: (event: WebViewMessageEvent) => void;
+}
+
+function DesktopWebView({ url, origin, presentation, onMessage }: DesktopWebViewProps) {
+  const [failed, setFailed] = useState(false);
+  const [loading, setLoading] = useState(true);
+  const source = useMemo(() => ({ uri: url }), [url]);
+  const nativeState = `window.__AIGO_NATIVE_FULLSCREEN__ = ${JSON.stringify(presentation.fullscreen)};
+    window.__AIGO_NATIVE_CAMERA__ = ${JSON.stringify(presentation.camera)};
+    window.dispatchEvent(new CustomEvent('aigo:native-fullscreenchange', {
+      detail: { fullscreen: window.__AIGO_NATIVE_FULLSCREEN__ }
+    })); true;`;
+  const retry = useCallback(() => {
+    setLoading(true);
+    setFailed(false);
+  }, []);
+  const fail = useCallback(() => setFailed(true), []);
+  const loaded = useCallback(() => setLoading(false), []);
+  const allowNavigation = useCallback(
+    (request: WebViewNavigation) => allowsDesktopNavigation(request.url, origin),
+    [origin],
+  );
+  if (failed) {
+    return (
+      <View style={styles.message}>
+        <Text style={styles.text}>
+          Desktop connection failed. Check that the PC viewer is running.
+        </Text>
+        <Button onPress={retry}>Retry connection</Button>
+      </View>
+    );
+  }
+  return (
+    <View style={styles.container}>
+      <WebView
+        source={source}
+        onMessage={onMessage}
+        injectedJavaScriptBeforeContentLoaded={nativeState}
+        injectedJavaScript={nativeState}
+        injectedJavaScriptBeforeContentLoadedForMainFrameOnly
+        injectedJavaScriptForMainFrameOnly
+        style={styles.container}
+        containerStyle={styles.container}
+        incognito
+        cacheEnabled={false}
+        sharedCookiesEnabled={false}
+        thirdPartyCookiesEnabled={false}
+        // Handle every attempted navigation ourselves; don't dispatch rejected links to other apps.
+        originWhitelist={["*"]}
+        onShouldStartLoadWithRequest={allowNavigation}
+        onOpenWindow={fail}
+        setSupportMultipleWindows
+        allowsLinkPreview={false}
+        allowFileAccess={false}
+        allowFileAccessFromFileURLs={false}
+        allowUniversalAccessFromFileURLs={false}
+        mixedContentMode="never"
+        bounces={false}
+        scrollEnabled={false}
+        automaticallyAdjustContentInsets={false}
+        contentInsetAdjustmentBehavior="never"
+        onLoadEnd={loaded}
+        onError={fail}
+        onHttpError={fail}
+        onContentProcessDidTerminate={fail}
+        onRenderProcessGone={fail}
+      />
+      {loading ? (
+        <ActivityIndicator style={styles.loading} accessibilityLabel="Connecting to desktop" />
+      ) : null}
+    </View>
+  );
+}
+
+function DesktopMessage({ message }: { message: string }) {
+  return (
+    <View style={styles.message}>
+      <Text style={styles.text}>{message}</Text>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  container: { flex: 1, backgroundColor: theme.colors.surface0 },
+  message: {
+    flex: 1,
+    padding: 16,
+    gap: 16,
+    justifyContent: "center",
+    backgroundColor: theme.colors.surface0,
+  },
+  text: { color: theme.colors.foreground, fontSize: theme.fontSize.base },
+  toolbar: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+    paddingHorizontal: theme.spacing[2],
+    borderBottomWidth: 1,
+    borderBottomColor: theme.colors.border,
+  },
+  title: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm },
+  loading: { position: "absolute", top: 16, alignSelf: "center" },
+}));

+  mounts: 0,
+  unmounts: 0,
+  appChange: (_value: string) => {},
+  message: (_event: { nativeEvent: { url: string; data: string } }) => {},
+  fail: () => {},
+  script: "",
+}));
+
+vi.mock("react-native", () => ({
+  AppState: {
+    currentState: "active",
+    addEventListener: (_event: string, callback: typeof state.appChange) => {
+      state.appChange = callback;
+      return { remove: vi.fn() };
+    },
+  },
+  View: ({ children }: { children?: ReactNode }) => <div>{children}</div>,
+  Text: ({ children }: { children?: ReactNode }) => <span>{children}</span>,
+  ActivityIndicator: () => <span>Connecting</span>,
+  StatusBar: () => null,
+  Modal: ({ children }: { children?: ReactNode }) => <div data-fullscreen>{children}</div>,
+}));
+vi.mock("react-native-safe-area-context", () => ({
+  SafeAreaProvider: ({ children }: { children?: ReactNode }) => <div>{children}</div>,
+  SafeAreaView: ({ children }: { children?: ReactNode }) => <div>{children}</div>,
+}));
+vi.mock("react-native-unistyles", () => ({ StyleSheet: { create: () => ({}) } }));
+vi.mock("@/components/ui/button", () => ({
+  Button: ({ children, onPress }: { children?: ReactNode; onPress: () => void }) => (
+    <button type="button" onClick={onPress}>
+      {children}
+    </button>
+  ),
+}));
+vi.mock("@/panels/pane-context", () => ({
+  usePaneFocus: () => ({ isInteractive: state.focused }),
+}));
+vi.mock("@/components/retained-panel", () => ({ useRetainedPanelActive: () => state.active }));
+vi.mock("react-native-webview", () => ({
+  WebView: (props: {
+    onMessage: typeof state.message;
+    onError: typeof state.fail;
+    injectedJavaScript: string;
+  }) => {
+    state.message = props.onMessage;
+    state.fail = props.onError;
+    state.script = props.injectedJavaScript;
+    React.useEffect(() => {
+      state.mounts += 1;
+      return () => {
+        state.unmounts += 1;
+      };
+    }, []);
+    return <div data-webview />;
+  },
+}));
+
+import { DesktopView } from "./desktop-view.native";
+
+const origin = "https://aigo-native-test.trycloudflare.com";
+const url = `${origin}/#${"a".repeat(64)}`;
+
+describe("native desktop presentation lifecycle", () => {
+  let container: HTMLDivElement;
+  let root: Root;
+  function render() {
+    act(() => root.render(<DesktopView url={url} />));
+  }
+  function enter() {
+    act(() =>
+      state.message({
+        nativeEvent: {
+          url,
+          data: JSON.stringify({
+            type: "aigo:native-fullscreen",
+            fullscreen: true,
+            camera: { zoom: 2, centerX: 960, centerY: 540 },
+          }),
+        },
+      }),
+    );
+  }
+  beforeEach(() => {
+    vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+    state.active = true;
+    state.focused = true;
+    state.mounts = 0;
+    state.unmounts = 0;
+    container = document.createElement("div");
+    root = createRoot(container);
+  });
+  afterEach(() => {
+    act(() => root.unmount());
+    vi.unstubAllGlobals();
+  });
+
+  it("releases the embedded instance before showing fullscreen and preserves camera only", () => {
+    render();
+    enter();
+    expect(container.querySelector("[data-fullscreen]")).not.toBeNull();
+    expect(container.querySelectorAll("[data-webview]")).toHaveLength(1);
+    expect(state.mounts).toBe(2);
+    expect(state.unmounts).toBe(1);
+    expect(state.script).toContain('"zoom":2,"centerX":960,"centerY":540');
+    expect(state.script).toContain("window.__AIGO_NATIVE_FULLSCREEN__ = true");
+  });
+
+  it.each(["background", "panel", "focus"])(
+    "destroys fullscreen when losing %s activity",
+    (reason) => {
+      render();
+      enter();
+      if (reason === "background") act(() => state.appChange("background"));
+      if (reason === "panel") {
+        state.active = false;
+        render();
+      }
+      if (reason === "focus") {
+        state.focused = false;
+        render();
+      }
+      expect(container.querySelector("[data-fullscreen]")).toBeNull();
+      expect(container.querySelector("[data-webview]")).toBeNull();
+      expect(state.unmounts).toBe(2);
+      expect(container.textContent).toContain("disconnected");
+      state.active = true;
+      state.focused = true;
+      act(() => state.appChange("active"));
+      render();
+      expect(container.querySelector("[data-fullscreen]")).toBeNull();
+      expect(state.script).toContain("window.__AIGO_NATIVE_FULLSCREEN__ = false");
+    },
+  );
+
+  it("keeps a native exit available when the fullscreen page fails", () => {
+    render();
+    enter();
+    act(() => state.fail());
+    expect(container.textContent).toContain("connection failed");
+    const done = container.querySelector("button");
+    expect(done?.textContent).toBe("Done");
+    act(() => done?.click());
+    expect(container.querySelector("[data-fullscreen]")).toBeNull();
+    expect(container.querySelectorAll("[data-webview]")).toHaveLength(1);
+  });
+
+  it("ignores presentation requests from other origins", () => {
+    render();
+    act(() =>
+      state.message({
+        nativeEvent: {
+          url: "https://example.com/",
+          data: JSON.stringify({
+            type: "aigo:native-fullscreen",
+            fullscreen: true,
+          }),
+        },
+      }),
+    );
+    expect(container.querySelector("[data-fullscreen]")).toBeNull();
+    expect(state.mounts).toBe(1);
+  });
+});

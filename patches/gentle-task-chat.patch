new file mode 100644
index 0000000..3c8bd0d
--- /dev/null
+++ b/packages/app/src/desktop/components/task-pairing-panel.tsx
@@ -0,0 +1,124 @@
+import { useCallback, useEffect, useState } from "react";
+import { Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import * as Clipboard from "expo-clipboard";
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import type { TaskPairingStatus } from "@getpaseo/protocol/messages";
+import { Button } from "@/components/ui/button";
+
+const styles = StyleSheet.create((theme) => ({
+  body: { gap: 12 },
+  text: { color: theme.colors.foreground },
+  muted: { color: theme.colors.foregroundMuted },
+}));
+export function TaskPairingPanel({
+  client,
+  initial,
+  onClose,
+}: {
+  client: DaemonClient;
+  initial: TaskPairingStatus;
+  onClose: () => void;
+}) {
+  const [status, setStatus] = useState(initial),
+    [url, setUrl] = useState("");
+  const [busy, setBusy] = useState(false),
+    [error, setError] = useState("");
+  const action = useCallback(
+    async (taskAction: "status" | "enable" | "offer" | "disable") => {
+      setBusy(true);
+      setError("");
+      try {
+        const result = await client.getDaemonPairingOffer({ taskAction });
+        if (!result.taskPairing) throw new Error("UNSUPPORTED");
+        setStatus(result.taskPairing);
+        setUrl(taskAction === "offer" ? result.url : "");
+      } catch {
+        setUrl("");
+        setError("Pairing state unavailable. Reconnect to the PC before trying again.");
+      } finally {
+        setBusy(false);
+      }
+    },
+    [client],
+  );
+  useEffect(() => {
+    let live = true;
+    const timer = setInterval(() => {
+      void client
+        .getDaemonPairingOffer({ taskAction: "status" })
+        .then((result) => {
+          if (live && result.taskPairing) {
+            setStatus(result.taskPairing);
+            if (!result.taskPairing.enabled) setUrl("");
+          }
+          return null;
+        })
+        .catch(() => {
+          if (live) {
+            setUrl("");
+            setError("PC disconnected; pairing status cannot be confirmed.");
+          }
+        });
+    }, 5000);
+    return () => {
+      live = false;
+      clearInterval(timer);
+    };
+  }, [client]);
+  const copy = useCallback(() => {
+    if (url) void Clipboard.setStringAsync(url);
+  }, [url]);
+  const enable = useCallback(() => {
+    void action("enable");
+  }, [action]);
+  const offer = useCallback(() => {
+    void action("offer");
+  }, [action]);
+  const disable = useCallback(() => {
+    void action("disable");
+  }, [action]);
+  return (
+    <View style={styles.body} testID="task-pairing-panel">
+      <Text style={styles.text}>Selected task phone chat</Text>
+      <Text style={styles.text}>{status.task?.title ?? "No eligible live task"}</Text>
+      <Text style={styles.muted}>
+        {status.task ? `Task ${status.task.agentId}` : "Start a live task on this PC first."}
+      </Text>
+      <Text style={styles.text}>
+        {status.enabled
+          ? `Enabled until ${new Date(status.expiresAt!).toLocaleTimeString()}`
+          : "Off — no phone access"}
+      </Text>
+      <Text style={styles.muted}>
+        One selected task, one hour. The phone can read the selected chat, send prompts and answer
+        questions. Agent coding tools remain scoped to the selected project. No file browser,
+        terminal or desktop access. Outbound encrypted transport uses relay.paseo.sh. Restart or
+        revoke ends access.
+      </Text>
+      {error ? (
+        <Text accessibilityRole="alert" style={styles.text}>
+          {error}
+        </Text>
+      ) : null}
+      {!status.enabled ? (
+        <Button disabled={busy || !status.task} onPress={enable}>
+          Enable this task for one hour
+        </Button>
+      ) : (
+        <>
+          <Button disabled={busy} onPress={offer}>
+            Create two-minute invitation
+          </Button>
+          {url ? <Button onPress={copy}>Copy invitation for iPhone</Button> : null}
+          <Button disabled={busy} onPress={disable}>
+            Revoke all phones and stop relay
+          </Button>
+        </>
+      )}
+      <Button variant="secondary" onPress={onClose}>
+        Close
+      </Button>
+    </View>
+  );
+}

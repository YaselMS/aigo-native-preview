@@ -0,0 +1,155 @@
+import type { SessionInboundMessage, SessionOutboundMessage } from "../messages.js";
+
+/** A narrow chat grant, never daemon-wide workspace authority. Server-owned only. */
+export interface TaskChatScope {
+  readonly deviceId: string;
+  readonly workspaceId: string;
+  readonly agentId: string;
+  readonly generation: string;
+  readonly isActive: () => boolean;
+}
+
+export function projectTaskOutbound(
+  scope: TaskChatScope,
+  message: SessionOutboundMessage,
+): SessionOutboundMessage | null {
+  if (!scope.isActive()) return null;
+  const snapshot = (
+    agent: NonNullable<
+      Extract<SessionOutboundMessage, { type: "fetch_agent_response" }>["payload"]["agent"]
+    >,
+  ) => {
+    const { runtimeInfo: _runtimeInfo, ...safe } = agent;
+    return { ...safe, cwd: ".", persistence: null, labels: {}, availableModes: [], features: [] };
+  };
+  if (
+    message.type === "agent_status" &&
+    message.payload.agentId === scope.agentId &&
+    requiredSnapshotMatches(scope, message.payload.info)
+  )
+    return { ...message, payload: { ...message.payload, info: snapshot(message.payload.info) } };
+  if (
+    message.type === "fetch_agent_response" &&
+    message.payload.agent?.id === scope.agentId &&
+    message.payload.agent.workspaceId === scope.workspaceId
+  )
+    return {
+      ...message,
+      payload: { ...message.payload, agent: snapshot(message.payload.agent), project: null },
+    };
+  if (
+    message.type === "agent_update" &&
+    message.payload.kind === "upsert" &&
+    message.payload.agent.id === scope.agentId &&
+    message.payload.agent.workspaceId === scope.workspaceId
+  )
+    return {
+      ...message,
+      payload: { ...message.payload, agent: snapshot(message.payload.agent), project: null },
+    };
+  if (
+    message.type === "fetch_agent_timeline_response" &&
+    message.payload.agentId === scope.agentId &&
+    message.payload.agent?.id === scope.agentId &&
+    message.payload.agent?.workspaceId === scope.workspaceId
+  )
+    return { ...message, payload: { ...message.payload, agent: snapshot(message.payload.agent) } };
+  return taskAllowsOutbound(scope, message) ? message : null;
+}
+
+const inboundAgentOperations = new Set([
+  "fetch_agent_request",
+  "fetch_agent_timeline_request",
+  "agent.timeline.list_prompts.request",
+  "send_agent_message_request",
+  "agent_permission_response",
+  "abort_request",
+  "clear_agent_attention",
+]);
+const outboundAgentOperations = new Set([
+  "agent_stream",
+  "agent_status",
+  "agent_permission_request",
+  "agent_permission_resolved",
+  "fetch_agent_timeline_response",
+  "agent.timeline.list_prompts.response",
+  "send_agent_message_response",
+  "clear_agent_attention_response",
+  "cancel_agent_response",
+]);
+
+function optionalSnapshotMatches(scope: TaskChatScope, value: unknown): boolean {
+  if (value == null) return true;
+  return (
+    typeof value === "object" &&
+    "id" in value &&
+    "workspaceId" in value &&
+    value.id === scope.agentId &&
+    value.workspaceId === scope.workspaceId
+  );
+}
+
+export function taskAllowsInbound(scope: TaskChatScope, message: SessionInboundMessage): boolean {
+  if (!scope.isActive()) return false;
+  if (
+    message.type === "agent_permission_response" &&
+    message.response?.behavior === "allow" &&
+    message.response.updatedPermissions?.length
+  )
+    return false;
+  if (message.type === "agent.timeline.set_subscription.request")
+    return Array.isArray(message.agentIds) && message.agentIds.every((id) => id === scope.agentId);
+  return (
+    inboundAgentOperations.has(message.type) &&
+    "agentId" in message &&
+    message.agentId === scope.agentId
+  );
+}
+
+export function taskAllowsOutbound(scope: TaskChatScope, message: SessionOutboundMessage): boolean {
+  if (!scope.isActive()) return false;
+  if (message.type === "agent_status")
+    return (
+      message.payload.agentId === scope.agentId &&
+      requiredSnapshotMatches(scope, message.payload.info)
+    );
+  if (
+    message.type === "agent_stream" &&
+    (!message.payload.event ||
+      ["model_changed", "mode_changed", "attention_required"].includes(message.payload.event.type))
+  )
+    return false;
+  if (message.type === "rpc_error") return message.payload.code === "access_denied";
+  if (message.type === "agent.timeline.set_subscription.response")
+    return (
+      Array.isArray(message.payload.agentIds) &&
+      message.payload.agentIds.every((id) => id === scope.agentId)
+    );
+  if (message.type === "fetch_agent_response")
+    return (
+      message.payload.agent?.id === scope.agentId &&
+      message.payload.agent.workspaceId === scope.workspaceId &&
+      !message.payload.project
+    );
+  if (message.type === "agent_update")
+    return (
+      message.payload.kind === "upsert" &&
+      message.payload.agent.id === scope.agentId &&
+      message.payload.agent.workspaceId === scope.workspaceId &&
+      !message.payload.project
+    );
+  return agentPayloadMatches(scope, message);
+}
+
+function requiredSnapshotMatches(scope: TaskChatScope, value: unknown): boolean {
+  return value != null && optionalSnapshotMatches(scope, value);
+}
+function agentPayloadMatches(scope: TaskChatScope, message: SessionOutboundMessage): boolean {
+  return (
+    outboundAgentOperations.has(message.type) &&
+    "payload" in message &&
+    "agentId" in message.payload &&
+    message.payload.agentId === scope.agentId &&
+    optionalSnapshotMatches(scope, "agent" in message.payload ? message.payload.agent : undefined)
+  );
+}

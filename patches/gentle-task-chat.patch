+      this.connectionErrors++;
+      if (this.connectionErrors === 3)
+        this.emit({
+          type: "timeline",
+          provider: this.provider,
+          item: {
+            type: "error",
+            message:
+              "Original Gentle task unavailable (closed or disconnected). Reconnecting without replaying input.",
+          },
+        });

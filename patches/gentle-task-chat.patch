diff --git a/packages/app/src/app/task-chat.tsx b/packages/app/src/app/task-chat.tsx
new file mode 100644
index 0000000..e3bb407
--- /dev/null
+++ b/packages/app/src/app/task-chat.tsx
@@ -0,0 +1,285 @@
+import React, {
+  useCallback,
+  useEffect,
+  useMemo,
+  useRef,
+  useState,
+  useSyncExternalStore,
+} from "react";
+import { KeyboardAvoidingView, Platform, Pressable, ScrollView, Text, View } from "react-native";
+import { SafeAreaView } from "react-native-safe-area-context";
+import { useRouter } from "expo-router";
+import { StyleSheet } from "react-native-unistyles";
+import { AssistantMessage, UserMessage, ToolCall } from "@/components/message";
+import { QuestionFormCard } from "@/components/question-form-card";
+import { ToolCallSheetProvider } from "@/components/tool-call-sheet";
+import { AssistantFileLinkResolverProvider } from "@/assistant-file-links/provider";
+import { EditingTextInput, type EditingTextInputHandle } from "@/components/ui/text-input";
+import {
+  getTaskChatSession,
+  subscribeTaskChatSession,
+  clearTaskChatSession,
+  type TaskChatSession,
+} from "@/task-chat/session";
+import type { TaskChatState } from "@/task-chat/session";
+import type { AgentPermissionResponse } from "@getpaseo/protocol/agent-types";
+type AgentTimelineEntryPayload = TaskChatState["entries"][number];
+
+const styles = StyleSheet.create((theme) => ({
+  page: { flex: 1, backgroundColor: theme.colors.surface0 },
+  body: { flex: 1 },
+  header: {
+    padding: 16,
+    gap: 8,
+    borderBottomWidth: 1,
+    borderBottomColor: theme.colors.border,
+  },
+  title: { fontSize: 18, fontWeight: "600", color: theme.colors.foreground },
+  text: { color: theme.colors.foreground, fontSize: 14 },
+  muted: { color: theme.colors.foregroundMuted, fontSize: 12 },
+  actions: { flexDirection: "row", gap: 12, flexWrap: "wrap" },
+  button: {
+    padding: 10,
+    borderRadius: 8,
+    backgroundColor: theme.colors.surface2,
+  },
+  buttonText: { color: theme.colors.foreground, fontWeight: "600" },
+  history: { padding: 16, gap: 12 },
+  error: { color: theme.colors.destructive, padding: 12 },
+  footer: {
+    padding: 12,
+    gap: 10,
+    borderTopWidth: 1,
+    borderTopColor: theme.colors.border,
+  },
+  input: {
+    color: theme.colors.foreground,
+    backgroundColor: theme.colors.surface2,
+    padding: 12,
+    borderRadius: 10,
+    minHeight: 48,
+    maxHeight: 140,
+  },
+  disabled: { opacity: 0.5 },
+}));
+const cleanupTimers = new WeakMap<TaskChatSession, ReturnType<typeof setTimeout>>();
+function TaskRow({ entry }: { entry: AgentTimelineEntryPayload }) {
+  const item = entry.item,
+    time = Date.parse(entry.timestamp);
+  if (item.type === "user_message") return <UserMessage message={item.text} timestamp={time} />;
+  if (item.type === "assistant_message")
+    return (
+      <AssistantMessage
+        occurrenceKey={String(entry.seqStart)}
+        message={item.text}
+        timestamp={time}
+        phase="complete"
+      />
+    );
+  if (item.type === "tool_call")
+    return (
+      <ToolCall
+        toolName={item.name}
+        detail={item.detail}
+        status={item.status}
+        metadata={item.metadata}
+        forceInline
+      />
+    );
+  if (item.type === "error")
+    return (
+      <Text selectable style={styles.error}>
+        {item.message}
+      </Text>
+    );
+  if (item.type === "compaction") return <Text style={styles.muted}>Context compacted</Text>;
+  return null;
+}
+function TaskQuestion({
+  request,
+  session,
+  busy,
+  blocked,
+}: {
+  request: NonNullable<TaskChatState["agent"]>["pendingPermissions"][number];
+  session: TaskChatSession;
+  busy: boolean;
+  blocked: boolean;
+}) {
+  const permission = useMemo(
+    () => ({ key: request.id, agentId: session.task.agentId, request }),
+    [request, session.task.agentId],
+  );
+  const respond = useCallback(
+    (response: AgentPermissionResponse) => {
+      void session.answer(request.id, response);
+    },
+    [session, request.id],
+  );
+  return (
+    <QuestionFormCard
+      permission={permission}
+      isResponding={busy}
+      isResponseBlocked={blocked}
+      onRespond={respond}
+    />
+  );
+}
+function ActiveTask({ session, onClose }: { session: TaskChatSession; onClose: () => void }) {
+  const state = useSyncExternalStore(session.subscribe, session.getSnapshot, session.getSnapshot);
+  const [draft, setDraft] = useState("");
+  const inputRef = useRef<EditingTextInputHandle>(null);
+  useEffect(() => {
+    void session.start();
+  }, [session]);
+  useEffect(() => {
+    if (state.acceptedPrompt && inputRef.current?.getText() === state.acceptedPrompt.text) {
+      inputRef.current.replaceText("");
+      setDraft("");
+    }
+  }, [state.acceptedPrompt]);
+  const pending = state.agent?.pendingPermissions ?? [];
+  const reconnect = useCallback(() => {
+    void session.reconnect();
+  }, [session]);
+  const refresh = useCallback(() => {
+    void session.refresh().catch(() => undefined);
+  }, [session]);
+  const send = useCallback(() => {
+    void session.send(draft);
+  }, [session, draft]);
+  const enabled =
+    state.connection === "connected" &&
+    !state.busy &&
+    !state.uncertainPrompt &&
+    !state.uncertainQuestion &&
+    pending.length === 0;
+  return (
+    <SafeAreaView style={styles.page}>
+      <KeyboardAvoidingView
+        style={styles.body}
+        behavior={Platform.OS === "ios" ? "padding" : undefined}
+      >
+        <View style={styles.header}>
+          <Text style={styles.title}>{state.agent?.title ?? "Selected live task"}</Text>
+          <Text style={styles.muted}>
+            {state.hostname ?? "Connecting to PC"} · {state.connection} · one task, chat and
+            questions
+          </Text>
+          <View style={styles.actions}>
+            <Pressable accessibilityRole="button" onPress={reconnect} style={styles.button}>
+              <Text style={styles.buttonText}>Reconnect</Text>
+            </Pressable>
+            <Pressable accessibilityRole="button" onPress={refresh} style={styles.button}>
+              <Text style={styles.buttonText}>Refresh</Text>
+            </Pressable>
+            <Pressable accessibilityRole="button" onPress={onClose} style={styles.button}>
+              <Text style={styles.buttonText}>Disconnect</Text>
+            </Pressable>
+          </View>
+        </View>
+        {state.error ? (
+          <Text accessibilityRole="alert" style={styles.error}>
+            {state.error}
+          </Text>
+        ) : null}
+        <ScrollView
+          style={styles.body}
+          contentContainerStyle={styles.history}
+          keyboardShouldPersistTaps="handled"
+        >
+          {state.entries.map((entry) => (
+            <TaskRow key={`${entry.seqStart}`} entry={entry} />
+          ))}
+          {pending.map((request) =>
+            request.kind === "question" ? (
+              <TaskQuestion
+                key={request.id}
+                request={request}
+                session={session}
+                busy={state.busy}
+                blocked={state.connection !== "connected" || state.uncertainQuestion === request.id}
+              />
+            ) : (
+              <Text key={request.id} style={styles.muted}>
+                This permission needs the PC. This pairing supports structured questions.
+              </Text>
+            ),
+          )}
+        </ScrollView>
+        <View style={styles.footer}>
+          <EditingTextInput
+            ref={inputRef}
+            accessibilityLabel="Message this task"
+            placeholder="Message this task"
+            multiline
+            onChangeText={setDraft}
+            editable={enabled}
+            style={styles.input}
+          />
+          <Pressable
+            accessibilityRole="button"
+            accessibilityLabel="Send task message"
+            disabled={!enabled || !draft.trim()}
+            onPress={send}
+            style={[styles.button, !enabled ? styles.disabled : undefined]}
+          >
+            <Text style={styles.buttonText}>Send</Text>
+          </Pressable>
+          <Text style={styles.muted}>
+            Volatile pairing. Disconnect closes access. Full desktop and background alerts are not
+            enabled here.
+          </Text>
+        </View>
+      </KeyboardAvoidingView>
+    </SafeAreaView>
+  );
+}
+export default function TaskChatScreen() {
+  const router = useRouter();
+  const session = useSyncExternalStore(
+    subscribeTaskChatSession,
+    getTaskChatSession,
+    getTaskChatSession,
+  );
+  useEffect(() => {
+    // React development effect replay cancels this cleanup on the same mount.
+    if (session) {
+      const pending = cleanupTimers.get(session);
+      if (pending) clearTimeout(pending);
+    }
+    return () => {
+      if (session)
+        cleanupTimers.set(
+          session,
+          setTimeout(() => clearTaskChatSession(session), 0),
+        );
+    };
+  }, [session]);
+  const close = useCallback(() => {
+    if (session) clearTaskChatSession(session);
+    router.replace("/welcome");
+  }, [session, router]);
+  if (!session)
+    return (
+      <SafeAreaView style={styles.page}>
+        <View style={styles.header}>
+          <Text style={styles.title}>No active task pairing</Text>
+          <Text style={styles.text}>
+            Paste a fresh task pairing link from the PC. Nothing was saved.
+          </Text>
+          <Pressable accessibilityRole="button" onPress={close} style={styles.button}>
+            <Text style={styles.buttonText}>Back</Text>
+          </Pressable>
+        </View>
+      </SafeAreaView>
+    );
+  return (
+    <ToolCallSheetProvider>
+      {/* Task grants have no file lookup/open capability. */}
+      <AssistantFileLinkResolverProvider>
+        <ActiveTask key={session.viewId} session={session} onClose={close} />
+      </AssistantFileLinkResolverProvider>
+    </ToolCallSheetProvider>
+  );
+}

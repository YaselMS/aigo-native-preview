+import { generateTaskSigningKey, signTaskChallenge } from "@getpaseo/relay/e2ee";
+import { TaskDeviceServerFrameSchema } from "@getpaseo/protocol/task-device";
+import type { TaskDeviceServerFrame } from "@getpaseo/protocol/task-device";
+import type { TaskConnectionOffer } from "@getpaseo/protocol/connection-offer";
+import type { DaemonTransport, DaemonTransportFactory } from "./daemon-client-transport-types.js";
+import { createRelayE2eeTransportFactory } from "./daemon-client-relay-e2ee-transport.js";
+
+function assertChallenge(
+  frame: Extract<TaskDeviceServerFrame, { type: "task_device_challenge" }>,
+  serverId: string,
+  clientId: string,
+  deviceId: string | undefined,
+): void {
+  const signed = JSON.parse(frame.payload);
+  if (
+    frame.clientId !== clientId ||
+    frame.expiresAt <= Date.now() ||
+    (deviceId && frame.deviceId !== deviceId) ||
+    !Array.isArray(signed) ||
+    signed.length !== 7 ||
+    signed[0] !== "aigo-task-device-v1" ||
+    signed[1] !== serverId ||
+    signed[2] !== frame.deviceId ||
+    signed[3] !== clientId ||
+    signed[4] !== frame.id ||
+    signed[6] !== frame.expiresAt
+  )
+    throw new Error("INVALID_CHALLENGE");
+}
+
+/** Volatile only: never serialize this identity or the invitation to host settings. */
+export function createTaskDeviceTransport(args: {
+  offer: TaskConnectionOffer;
+  clientId: string;
+  baseFactory: DaemonTransportFactory;
+}) {
+  const { publicKeyB64, secretKey } = generateTaskSigningKey();
+  const active = new Set<DaemonTransport>();
+  let deviceId: string | undefined,
+    invitation: string | undefined = args.offer.invitation.token,
+    destroyed = false;
+  const binding = { ...args.offer.task },
+    serverId = args.offer.serverId,
+    clientId = args.clientId;
+  const encrypted = createRelayE2eeTransportFactory({
+    baseFactory: args.baseFactory,
+    daemonPublicKeyB64: args.offer.daemonPublicKeyB64,
+    logger: { warn: () => undefined },
+  });
+  const factory: DaemonTransportFactory = (options) => {
+    if (destroyed) throw new Error("TASK_DEVICE_CLOSED");
+    const base = encrypted(options);
+    active.add(base);
+    let ready = false,
+      closed = false;
+    const opens = new Set<() => void>(),
+      messages = new Set<(data: unknown, isBinary: boolean) => void>();
+    const closes = new Set<(event?: unknown) => void>(),
+      errors = new Set<(event?: unknown) => void>();
+    const deadline = setTimeout(() => fail(), 15000);
+    const fail = () => {
+      if (closed) return;
+      for (const fn of errors)
+        fn(new Error("Task pairing failed or expired. Reissue the pairing invitation if needed."));
+      base.close(4003, "Task authentication failed");
+    };
+    base.onOpen(() => {
+      if (destroyed) {
+        fail();
+        return;
+      }
+      base.send(
+        JSON.stringify(
+          deviceId
+            ? { type: "task_device_connect", deviceId, clientId }
+            : { type: "task_device_enroll", token: invitation, publicKeyB64, clientId },
+        ),
+      );
+    });
+    base.onMessage((data, isBinary) => {
+      if (closed) return;
+      if (ready) {
+        for (const fn of messages) fn(data, isBinary);
+        return;
+      }
+      try {
+        if (isBinary || typeof data !== "string" || data.length > 4096)
+          throw new Error("INVALID_FRAME");
+        const frame = TaskDeviceServerFrameSchema.parse(JSON.parse(data));
+        if (frame.type === "task_device_challenge") {
+          assertChallenge(frame, serverId, clientId, deviceId);
+          deviceId = frame.deviceId;
+          invitation = undefined;
+          base.send(
+            JSON.stringify({
+              type: "task_device_proof",
+              challengeId: frame.id,
+              signature: signTaskChallenge(frame.payload, secretKey),
+            }),
+          );
+          return;
+        }
+        if (
+          !deviceId ||
+          frame.deviceId !== deviceId ||
+          frame.expiresAt <= Date.now() ||
+          frame.binding.workspaceId !== binding.workspaceId ||
+          frame.binding.agentId !== binding.agentId ||
+          frame.binding.generation !== binding.generation
+        )
+          throw new Error("TASK_SCOPE_MISMATCH");
+        ready = true;
+        clearTimeout(deadline);
+        for (const fn of opens) fn();
+      } catch {
+        fail();
+      }
+    });
+    base.onClose((event) => {
+      active.delete(base);
+      if (closed) return;
+      closed = true;
+      clearTimeout(deadline);
+      for (const fn of closes) fn(event);
+    });
+    base.onError((event) => {
+      for (const fn of errors) fn(event);
+    });
+    return {
+      send: (data) => {
+        if (!ready || destroyed) throw new Error("TASK_DEVICE_NOT_READY");
+        base.send(data);
+      },
+      close: (code, reason) => base.close(code, reason),
+      onOpen: (fn) => {
+        opens.add(fn);
+        if (ready) fn();
+        return () => opens.delete(fn);
+      },
+      onMessage: (fn) => {
+        messages.add(fn);
+        return () => messages.delete(fn);
+      },
+      onClose: (fn) => {
+        closes.add(fn);
+        if (closed) fn();
+        return () => closes.delete(fn);
+      },
+      onError: (fn) => {
+        errors.add(fn);
+        return () => errors.delete(fn);
+      },
+    };
+  };
+  return {
+    factory,
+    disconnect: async () => {
+      await Promise.all(
+        [...active].map((base) => {
+          let timer: ReturnType<typeof setTimeout> | undefined;
+          const closed = new Promise<void>((resolve) => {
+            base.onClose(() => resolve());
+          });
+          const deadline = new Promise<void>((resolve) => {
+            timer = setTimeout(resolve, 2000);
+          });
+          base.close(4000, "Task reconnect requested");
+          return Promise.race([closed, deadline]).finally(() => clearTimeout(timer));
+        }),
+      );
+    },
+    destroy: () => {
+      destroyed = true;
+      for (const connection of active) connection.close(4000, "Task connection closed");
+      active.clear();
+      secretKey.fill(0);
+      invitation = undefined;
+      deviceId = undefined;
+    },
+  };
+}

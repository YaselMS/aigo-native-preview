+export function resolveAgentTabLabel(
+  title: string | null | undefined,
+  provider: string,
+): string | null {
+  const trimmed = title?.trim();
+  if (trimmed && trimmed.toLowerCase() !== "new agent") return trimmed;
+  return provider === "gentle-live" ? "Live Gentle Shell" : null;
+}

+    ];
+  }
+  async createSession(config: AgentSessionConfig): Promise<AgentSession> {
+    return this.attach(config, true);
+  }
+  async resumeSession(
+    handle: AgentPersistenceHandle,
+    overrides?: Partial<AgentSessionConfig>,
+  ): Promise<AgentSession> {
+    const config = {
+      ...(handle.metadata?.config as AgentSessionConfig),
+      ...overrides,
+      provider: this.provider,
+    };
+    return this.attach(config, false, handle.nativeHandle);
+  }
+  async importSession(input: ImportProviderSessionInput, context: ImportProviderSessionContext) {
+    const { descriptor } = await this.current();
+    if (input.providerHandleId !== `${descriptor.sessionId}:${descriptor.generation}`)
+      throw new Error("Selected live session is stale; refresh and attach again.");
+    return importSessionFromPersistence({
+      provider: this.provider,
+      request: input,
+      context,
+      persistence: {
+        provider: this.provider,
+        sessionId: descriptor.sessionId,
+        nativeHandle: input.providerHandleId,
+        metadata: { config: context.storedConfig },
+      },
+      config: {
+        title:
+          descriptor.launchOrigin === "aigo-background"
+            ? "AiGo session (background)"
+            : "Live Gentle Shell",
+      },
+      resumeSession: this.resumeSession.bind(this),
+    });
+  }
+  private async attach(config: AgentSessionConfig, replay: boolean, expected?: string) {
+    const { descriptor, snapshot } = await this.current();
+    if (!sameDirectory(config.cwd, snapshot.cwd))
+      throw new Error("Selected workspace differs from the live Gentle task.");
+    if (expected && expected !== `${descriptor.sessionId}:${descriptor.generation}`)
+      throw new Error("Live process incarnation changed; automatic resume is disabled.");
+    if ([...this.sessions].some((s) => !s.detached && sameIdentity(s.identity, descriptor)))
+      throw new Error("This Gentle process is already attached. Open its existing AiGo task.");
+    const session = new GentleLiveAgentSession(
+      this.descriptorPath,
+      descriptor,
+      snapshot,
+      config,
+      replay,
+    );
+    this.sessions.add(session);
+    return session;
+  }
+  async shutdown(): Promise<void> {
+    await Promise.all([...this.sessions].map((s) => s.close()));
+  }
+}
+
+export class GentleLiveAgentSession implements AgentSession {
+  readonly provider = "pi";
+  readonly capabilities = capabilities;
+  readonly id: string;
+  detached = false;
+  private readonly listeners = new Set<(event: AgentStreamEvent) => void>();
+  private readonly history: AgentStreamEvent[];
+  private readonly seenMessages = new Set<string>();
+  private readonly mapper = new PiHistoryMapper(this.provider);
+  private readonly subagents = new GentleSubagentMapper();
+  private snapshot: LiveSnapshot;
+  private pending = new Map<string, AgentPermissionRequest>();
+  private timer?: ReturnType<typeof setTimeout>;
+  private sequence: number;
+  private turnId?: string;
+  private connectionErrors = 0;
+  private started = false;
+  private connection: "connected" | "reconnecting" | "stale" | "detached" = "connected";
+  private submittedEcho?: { text: string; clientMessageId: string; turnId: string };
+
+  constructor(
+    private descriptorPath: string,
+    readonly identity: LiveDescriptor,
+    initial: LiveSnapshot,
+    private config: AgentSessionConfig,
+    private replay: boolean,
+  ) {
+    this.id = initial.sessionId;
+    this.snapshot = initial;
+    this.sequence = initial.sequence;
+    this.history = this.mapNewMessages(initial);
+    this.pending = this.permissions(initial);
+  }
+  private emit(event: AgentStreamEvent) {
+    for (const listener of this.listeners) listener(event);
+  }
+  private mapNewMessages(snapshot: LiveSnapshot): AgentStreamEvent[] {
+    const result: AgentStreamEvent[] = [];
+    for (const entry of snapshot.messages) {
+      if (this.seenMessages.has(entry.id)) continue;
+      this.seenMessages.add(entry.id);
+      const message = entry.message as PiAgentMessage;
+      const failure = nativeTurnFailure(entry.message);
+      if (failure)
+        result.push({
+          type: "timeline",
+          provider: this.provider,
+          turnId: this.turnId,
+          item: { type: "error", message: failure },
+        });
+      result.push(...this.subagents.map(entry.message));
+      const mapped = this.mapper.mapMessages([message]);
+      for (const event of mapped) {
+        if (
+          event.type === "timeline" &&
+          (event.item.type === "user_message" || event.item.type === "assistant_message")
+        )
+          event.item.messageId = entry.id;
+        if (event.type === "timeline") {
+          event.turnId = this.turnId;
+          if (
+            event.item.type === "user_message" &&
+            message.role === "user" &&
+            this.submittedEcho?.text === getUserMessageText(message.content)
+          ) {
+            event.item.clientMessageId = this.submittedEcho.clientMessageId;
+            event.turnId = this.submittedEcho.turnId;
+            this.submittedEcho = undefined;
+          }
+        }
+        result.push(event);
+      }
+    }
+    return result;
+  }
+  private permissions(snapshot: LiveSnapshot) {
+    return new Map(
+      snapshot.pending.map((request) => {
+        const id = publicPermissionId(this.identity, request.requestId);
+        const params = request.params;
+        const isBatch = "questions" in params;
+        const questions =
+          "questions" in params
+            ? params.questions.map((q, index) => ({
+                ...q,
+                answerKey: `gentle_q${index}`,
+                allowOther: true,
+              }))
+            : [
+                {
+                  header: "Response",
+                  question: params.question,
+                  options: params.options,
+                  multiSelect: false,
+                  allowOther: false,
+                },
+              ];
+        const permission: AgentPermissionRequest = {
+          id,
+          provider: this.provider,
+          name: isBatch ? "ask_user_question" : "ask_user_choice",
+          kind: "question",
+          title: questions[0].question,
+          input: {
+            questions,
+          },
+          metadata: {
+            generation: snapshot.generation,
+            sessionId: snapshot.sessionId,
+            pid: snapshot.pid,
+          },
+        };
+        return [id, permission];
+      }),
+    );
+  }
+  subscribe(callback: (event: AgentStreamEvent) => void): () => void {
+    this.listeners.add(callback);
+    if (!this.started && !this.detached) {
+      this.started = true;
+      queueMicrotask(() => {
+        if (this.replay) {
+          for (const event of this.history) this.emit(event);
+          this.replay = false;
+        }
+        if (!this.snapshot.idle) this.emit({ type: "turn_started", provider: this.provider });
+        for (const request of this.pending.values())
+          this.emit({ type: "permission_requested", provider: this.provider, request });
+        this.schedule();
+      });
+    }
+    return () => this.listeners.delete(callback);
+  }
+  private schedule() {
+    if (this.detached) return;
+    this.timer = setTimeout(() => void this.poll(), this.snapshot.idle ? 1000 : 100);
+    this.timer.unref();
+  }
+  private async poll() {
+    try {
+      const descriptor = await readDescriptor(this.descriptorPath);
+      if (!sameIdentity(descriptor, this.identity)) {
+        this.connection = "stale";
+        this.pending.clear();
+        this.emit({
+          type: "turn_failed",
+          provider: this.provider,
+          error: "Gentle process reloaded or changed. Attach again; no input was replayed.",
+          code: "LIVE_BRIDGE_STALE",
+        });
+        await this.close();
+        return;
+      }
+      const next = await readSnapshot(this.identity);
+      this.connection = "connected";
+      this.connectionErrors = 0;
+      for (const event of this.mapNewMessages(next)) {
+        this.history.push(event);
+        this.emit(event);
+      }
+      const permissions = this.permissions(next);
+      for (const id of this.pending.keys())
+        if (!permissions.has(id))
+          this.emit({
+            type: "permission_resolved",
+            provider: this.provider,
+            requestId: id,
+            resolution: {
+              behavior: next.events.some(
+                (e) =>
+                  e.type === "question_resolved" &&
+                  e.requestId === id.slice(this.identity.generation.length + 1) &&
+                  typeof e.result === "object" &&
+                  e.result !== null &&
+                  Reflect.get(e.result, "cancelled") === true,
+              )
+                ? "deny"
+                : "allow",
+            },
+          });
+      for (const [id, request] of permissions)
+        if (!this.pending.has(id))
+          this.emit({ type: "permission_requested", provider: this.provider, request });
+      this.pending = permissions;
+      for (const event of next.events.filter((e) => e.sequence > this.sequence)) {
+        if (event.type === "agent_start")
+          this.emit({ type: "turn_started", provider: this.provider, turnId: this.turnId });
+        if (event.type === "agent_end") {
+          const lastAssistant = next.messages.findLast(
+            (entry) =>
+              entry.message &&
+              typeof entry.message === "object" &&
+              Reflect.get(entry.message, "role") === "assistant",
+          );
+          const failure = nativeTurnFailure(lastAssistant?.message);
+          if (failure)
+            this.emit({
+              type: "turn_failed",
+              provider: this.provider,
+              turnId: this.turnId,
+              error: failure,
+              code: "LIVE_NATIVE_TURN_FAILED",
+            });

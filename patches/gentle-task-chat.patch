+/** Volatile signing identity for the task-device proof, separate from box keys. */
+export function generateTaskSigningKey() {
+  ensurePrng();
+  const key = nacl.sign.keyPair();
+  return { publicKeyB64: encodeBase64(key.publicKey), secretKey: key.secretKey };
+}
+export function signTaskChallenge(payload: string, secretKey: Uint8Array): string {
+  return encodeBase64(nacl.sign.detached(new TextEncoder().encode(payload), secretKey))
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/g, "");
+}
+
 export function exportPublicKey(publicKey: Uint8Array): string {

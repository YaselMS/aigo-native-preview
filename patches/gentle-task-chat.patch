+
+const capabilities: AgentCapabilityFlags = {
+  supportsStreaming: true,
+  supportsSessionPersistence: true,
+  supportsSessionListing: true,
+  supportsDynamicModes: false,
+  supportsMcpServers: false,
+  supportsReasoningStream: true,
+  supportsToolInvocations: true,
+};
+const replySchema = z.object({ ok: z.boolean(), error: z.string().optional() });
+export function nativeTurnFailure(message: unknown): string | null {
+  if (!message || typeof message !== "object" || Reflect.get(message, "role") !== "assistant")
+    return null;
+  const reason = Reflect.get(message, "stopReason");
+  if (reason === "aborted") return "The Pi turn was stopped.";
+  if (reason !== "error") return null;
+  const detail = String(Reflect.get(message, "errorMessage") ?? "");
+  if (/Cannot find module|auth derivation failed/i.test(detail))
+    return "The local Pi runtime or authentication module is unavailable. No model reply was produced. Check the runtime before retrying.";
+  if (/Read-only credential|refresh required|credential store modify/i.test(detail))
+    return "OpenAI sign-in needs renewal in Gentle Shell. No automatic sign-in was attempted.";
+  if (/DAILY_MODEL_REQUEST_CAP_REACHED/.test(detail))
+    return "The daily model request limit has been reached.";
+  return "The original Pi task failed before completing this turn. No automatic retry was sent.";
+}
+const publicPermissionId = (snapshot: LiveDescriptor, requestId: string) =>
+  `${snapshot.generation}:${requestId}`;
+
+/** Attaches only. This adapter never launches/resumes a Pi process or imports a JSONL writer. */
+export class GentleLiveAgentClient implements AgentClient {
+  readonly provider = "pi";
+  readonly capabilities = capabilities;
+  private readonly descriptorPath: string;
+  private readonly sessions = new Set<GentleLiveAgentSession>();

+import { test, expect, vi } from "vitest";
+import { TaskPairingController } from "./task-pairing-controller.js";
+import { SessionAuthorization } from "./index.js";
+test("pairing defaults off, freezes one task, never renews on repeated enable, revokes on expiry or task change", () => {
+  let now = 1000;
+  let selected: { agentId: string; workspaceId: string; generation: string; title: string } | null =
+    { agentId: "a", workspaceId: "w", generation: "g", title: "Task" };
+  const relay = vi.fn(),
+    revoke = vi.fn();
+  const control = new TaskPairingController({
+    getSelected: () => selected,
+    setRelayEnabled: relay,
+    revokeAll: revoke,
+    now: () => now,
+  });
+  expect(control.status().enabled).toBe(false);
+  expect(relay).not.toHaveBeenCalled();
+  expect(() => control.binding()).toThrow("DISABLED");
+  const enabled = control.enable();
+  now += 1000;
+  expect(control.enable().expiresAt).toBe(enabled.expiresAt);
+  expect(relay).toHaveBeenCalledTimes(1);
+  expect(control.binding()).toEqual({ agentId: "a", workspaceId: "w", generation: "g" });
+  now = enabled.expiresAt!;
+  expect(control.status().enabled).toBe(false);
+  expect(revoke).toHaveBeenCalledTimes(1);
+  expect(relay).toHaveBeenLastCalledWith(false);
+  control.enable();
+  selected = { ...selected!, generation: "new" };
+  expect(control.status().enabled).toBe(false);
+  expect(revoke).toHaveBeenCalledTimes(2);
+  selected = null;
+  expect(() => control.enable()).toThrow("NO_LIVE_TASK");
+});
+test("disable revokes outstanding invitations even without active relay; relay startup failure fails closed", () => {
+  const revoke = vi.fn();
+  const c = new TaskPairingController({
+    getSelected: () => ({ agentId: "a", workspaceId: "w", generation: "g", title: "Task" }),
+    revokeAll: revoke,
+    setRelayEnabled: (enabled) => {
+      if (enabled) throw Error("offline");
+    },
+  });
+  expect(() => c.enable()).toThrow("RELAY_UNAVAILABLE");
+  expect(c.status().enabled).toBe(false);
+  expect(revoke).toHaveBeenCalledTimes(1);
+  c.disable();
+  expect(revoke).toHaveBeenCalledTimes(2);
+});
+test("network enabling requires tunnel and access authority; narrow chat can never mint pairing", () => {
+  const message = {
+    type: "daemon.get_pairing_offer.request" as const,
+    requestId: "r",
+    taskAction: "enable" as const,
+  };
+  expect(new SessionAuthorization(["access.manage"]).allowsInbound(message)).toBe(false);
+  expect(new SessionAuthorization(["access.manage", "tunnel.manage"]).allowsInbound(message)).toBe(
+    true,
+  );
+  expect(
+    new SessionAuthorization(["access.manage", "tunnel.manage"], {
+      agentId: "a",
+      workspaceId: "w",
+      generation: "g",
+      deviceId: "d",
+      isActive: () => true,
+    }).allowsInbound(message),
+  ).toBe(false);
+});

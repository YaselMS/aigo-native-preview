+import { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import { createTaskDeviceTransport } from "@getpaseo/client/internal/task-device-transport";
+import {
+  createWebSocketTransportFactory,
+  defaultWebSocketFactory,
+} from "@getpaseo/client/internal/daemon-client-websocket-transport";
+import {
+  ConnectionOfferSchema,
+  decodeOfferFragmentPayload,
+  type TaskConnectionOffer,
+} from "@getpaseo/protocol/connection-offer";
+import { buildRelayWebSocketUrl } from "@getpaseo/protocol/daemon-endpoints";
+import type { AgentSnapshotPayload } from "@getpaseo/protocol/messages";
+type FetchAgentTimelinePayload = Awaited<ReturnType<DaemonClient["fetchAgentTimeline"]>>;
+import type { AgentPermissionResponse } from "@getpaseo/protocol/agent-types";
+
+export type TaskChatClient = Pick<
+  DaemonClient,
+  | "connect"
+  | "close"
+  | "on"
+  | "subscribeConnectionStatus"
+  | "getLastServerInfoMessage"
+  | "fetchAgent"
+  | "fetchAgentTimeline"
+  | "setAgentTimelineSubscription"
+  | "sendAgentMessage"
+  | "respondToPermissionAndWait"
+>;
+export interface TaskChatState {
+  connection: string;
+  agent: AgentSnapshotPayload | null;
+  entries: FetchAgentTimelinePayload["entries"];
+  error: string | null;
+  busy: boolean;
+  uncertainPrompt: boolean;
+  uncertainQuestion: string | null;
+  acceptedPrompt: { id: string; text: string } | null;
+  hostname: string | null;
+}
+export interface TaskChatDependencies {
+  client: TaskChatClient;
+  destroyIdentity: () => void;
+  reconnectTransport?: () => Promise<void>;
+  answerTimeout?: number;
+}
+function connection(offer: TaskConnectionOffer): TaskChatDependencies {
+  const clientId = crypto.randomUUID();
+  const identity = createTaskDeviceTransport({
+    offer,
+    clientId,
+    baseFactory: createWebSocketTransportFactory(defaultWebSocketFactory),
+  });
+  return {
+    client: new DaemonClient({
+      clientId,
+      clientType: "mobile",
+      appVersion: "0.7.9",
+      connectTimeoutMs: 20000,
+      url: buildRelayWebSocketUrl({
+        endpoint: offer.relay.endpoint,
+        useTls: offer.relay.useTls !== false,
+        serverId: offer.serverId,
+        role: "client",
+      }),
+      transportFactory: identity.factory,
+      reconnect: { enabled: true, baseDelayMs: 1000, maxDelayMs: 5000 },
+    }),
+    destroyIdentity: identity.destroy,
+    reconnectTransport: identity.disconnect,
+  };
+}
+
+/** One volatile selected task; no host registry, storage, prompts or credentials at startup. */
+export class TaskChatSession {
+  readonly viewId = crypto.randomUUID();
+  private state: TaskChatState = {
+    connection: "idle",
+    agent: null,
+    entries: [],
+    error: null,
+    busy: false,
+    uncertainPrompt: false,
+    uncertainQuestion: null,
+    acceptedPrompt: null,
+    hostname: null,
+  };
+  private listeners = new Set<() => void>();
+  private unsubscribers: Array<() => void> = [];
+  private dependencies: TaskChatDependencies;
+  private started = false;
+  private closed = false;
+  private refreshPromise: Promise<void> | null = null;
+  private refreshAgain = false;
+  private refreshTimer: ReturnType<typeof setTimeout> | undefined;
+  private pendingPrompt: { id: string; text: string } | null = null;
+  private attemptedQuestions = new Set<string>();
+  readonly task: TaskConnectionOffer["task"];
+  readonly serverId: string;
+  constructor(offer: TaskConnectionOffer, dependencies?: TaskChatDependencies) {
+    this.task = Object.freeze({ ...offer.task });
+    this.serverId = offer.serverId;
+    this.dependencies = dependencies ?? connection(offer);
+  }
+  getSnapshot = () => this.state;
+  subscribe = (fn: () => void) => {
+    this.listeners.add(fn);
+    return () => this.listeners.delete(fn);
+  };
+  private update(patch: Partial<TaskChatState>) {
+    if (this.closed) return;
+    this.state = { ...this.state, ...patch };
+    for (const fn of this.listeners) fn();
+  }
+  async start() {
+    if (this.started || this.closed) return;
+    this.started = true;
+    const client = this.dependencies.client;
+    this.unsubscribers.push(
+      client.subscribeConnectionStatus((status) => {
+        this.update({ connection: status.status });
+        if (
+          ["disconnected", "error"].includes(status.status) &&
+          !this.state.uncertainQuestion &&
+          !this.state.uncertainPrompt
+        )
+          this.update({
+            error:
+              "Task disconnected. Access may have expired or been revoked. Reconnect or request a fresh PC invitation.",
+          });
+        if (status.status === "connected")
+          void this.refresh().catch(() =>
+            this.update({ error: "Unable to refresh this task. Reconnect and try Refresh." }),
+          );
+      }),
+      client.on((message) => {
+        if (
+          ![
+            "agent_stream",
+            "agent_update",
+            "agent_status",
+            "agent_permission_request",
+            "agent_permission_resolved",
+          ].includes(message.type)
+        )
+          return;
+        if (this.refreshTimer) return;
+        this.refreshTimer = setTimeout(() => {
+          this.refreshTimer = undefined;
+          void this.refresh().catch(() => undefined);
+        }, 150);
+      }),
+    );
+    await this.reconnect();
+  }
+  async reconnect() {
+    if (this.closed) return;
+    try {
+      this.update({ error: null });
+      await this.dependencies.reconnectTransport?.();
+      await this.dependencies.client.connect();
+      const info = this.dependencies.client.getLastServerInfoMessage();
+      if (info?.serverId !== this.serverId) throw new Error("TASK_IDENTITY_CHANGED");
+      this.update({ hostname: info.hostname ?? null });
+      await this.dependencies.client.setAgentTimelineSubscription([this.task.agentId]);
+      await this.refresh();
+    } catch {
+      this.update({
+        error:
+          "Task connection failed, expired or was revoked. Reconnect, or request a new pairing invitation.",
+      });
+    }
+  }
+  async refresh(): Promise<void> {
+    if (this.closed) return;
+    if (this.refreshPromise) {
+      this.refreshAgain = true;
+      return this.refreshPromise;
+    }
+    this.refreshPromise = (async () => {
+      do {
+        this.refreshAgain = false;
+        const [snapshot, timeline] = await Promise.all([
+          this.dependencies.client.fetchAgent(this.task.agentId),
+          this.dependencies.client.fetchAgentTimeline(this.task.agentId, { limit: 200 }),
+        ]);
+        if (this.closed) return;
+        if (
+          !snapshot ||
+          snapshot.agent.id !== this.task.agentId ||
+          snapshot.agent.workspaceId !== this.task.workspaceId ||
+          timeline.agentId !== this.task.agentId
+        )
+          throw new Error("TASK_IDENTITY_CHANGED");
+        const patch: Partial<TaskChatState> = { agent: snapshot.agent, entries: timeline.entries };
+        if (
+          this.pendingPrompt &&
+          timeline.entries.some(
+            (row) =>
+              row.item.type === "user_message" &&
+              row.item.clientMessageId === this.pendingPrompt!.id,
+          )
+        ) {
+          patch.acceptedPrompt = { ...this.pendingPrompt };
+          patch.uncertainPrompt = false;
+          patch.error = null;
+          this.pendingPrompt = null;
+        }
+        if (
+          this.state.uncertainQuestion &&
+          !snapshot.agent.pendingPermissions.some((p) => p.id === this.state.uncertainQuestion)
+        ) {
+          patch.uncertainQuestion = null;
+          patch.error = null;
+        }
+        this.update(patch);
+      } while (this.refreshAgain && !this.closed);
+    })();
+    try {
+      await this.refreshPromise;
+    } finally {
+      this.refreshPromise = null;
+    }
+  }
+  async send(text: string): Promise<boolean> {
+    if (
+      this.closed ||
+      this.state.busy ||
+      this.state.uncertainPrompt ||
+      this.state.uncertainQuestion ||
+      this.state.connection !== "connected" ||
+      !text.trim() ||
+      this.state.agent?.pendingPermissions.length
+    )
+      return false;
+    const submission = { id: crypto.randomUUID(), text };
+    this.pendingPrompt = submission;
+    this.update({ busy: true, error: null });
+    try {
+      await this.dependencies.client.sendAgentMessage(this.task.agentId, text, {
+        messageId: submission.id,
+      });
+      this.update({ acceptedPrompt: submission });
+      this.pendingPrompt = null;
+    } catch {
+      this.update({
+        uncertainPrompt: true,
+        error:
+          "Message delivery is uncertain. It will not be sent again automatically. Reconnect and Refresh to check this task.",
+      });
+      await this.refresh().catch(() => undefined);
+      return !this.state.uncertainPrompt;
+    } finally {
+      this.update({ busy: false });
+    }
+    await this.refresh().catch(() =>
+      this.update({ error: "Message accepted; task refresh failed. Reconnect and Refresh." }),
+    );
+    return true;
+  }
+  async answer(requestId: string, response: AgentPermissionResponse) {
+    if (
+      this.closed ||
+      this.state.busy ||
+      this.state.connection !== "connected" ||
+      this.attemptedQuestions.has(requestId)
+    )
+      return;
+    const pending = this.state.agent?.pendingPermissions.find(
+      (p) => p.id === requestId && p.kind === "question",
+    );
+    if (!pending) return;
+    this.attemptedQuestions.add(requestId);
+    this.update({ busy: true, error: null });
+    let accepted = false;
+    try {
+      await this.dependencies.client.respondToPermissionAndWait(
+        this.task.agentId,
+        requestId,
+        response,
+        this.dependencies.answerTimeout ?? 15000,
+      );
+      accepted = true;
+    } catch {
+      this.update({
+        uncertainQuestion: requestId,
+        error:
+          "Answer delivery is uncertain. It will not be resent. Reconnect and Refresh to recover the current question state.",
+      });
+      await this.refresh().catch(() => undefined);
+    } finally {
+      this.update({ busy: false });
+    }
+    if (accepted)
+      await this.refresh().catch(() =>
+        this.update({ error: "Answer accepted; task refresh failed. Reconnect and Refresh." }),
+      );
+  }
+  async close() {
+    if (this.closed) return;
+    this.closed = true;
+    if (this.refreshTimer) clearTimeout(this.refreshTimer);
+    for (const fn of this.unsubscribers) fn();
+    this.unsubscribers = [];
+    this.dependencies.destroyIdentity();
+    await this.dependencies.client.close();
+    this.listeners.clear();
+  }
+}
+
+let active: TaskChatSession | null = null;
+let activeInvitation: string | undefined;
+const activeListeners = new Set<() => void>();
+export const subscribeTaskChatSession = (fn: () => void) => {
+  activeListeners.add(fn);
+  return () => activeListeners.delete(fn);
+};
+const notifyActive = () => {
+  for (const fn of activeListeners) fn();
+};
+export function getTaskChatSession() {
+  return active;
+}
+export function clearTaskChatSession(session: TaskChatSession) {
+  if (active === session) {
+    active = null;
+    activeInvitation = undefined;
+    notifyActive();
+  }
+  void session.close();
+}
+export function prepareTaskOffer(offer: TaskConnectionOffer) {
+  if (offer.invitation.expiresAt <= Date.now())
+    throw new Error("Task pairing invitation expired. Request a new one.");
+  if (offer.relay.useTls === false && !/^127\.0\.0\.1:\d+$/.test(offer.relay.endpoint))
+    throw new Error("Task pairing requires TLS.");
+  if (active && activeInvitation === offer.invitation.token && active.serverId === offer.serverId)
+    return active;
+  if (active) void active.close();
+  active = new TaskChatSession(offer);
+  activeInvitation = offer.invitation.token;
+  notifyActive();
+  return active;
+}
+export function routeTaskOfferUrl(raw: string): boolean {
+  const marker = raw.indexOf("#offer=");
+  if (marker < 0) return false;
+  const offer = ConnectionOfferSchema.parse(decodeOfferFragmentPayload(raw.slice(marker + 7)));
+  if (offer.v !== 3) return false;
+  prepareTaskOffer(offer);
+  return true;
+}

+import { EventEmitter } from "node:events";
+import { describe, test, expect } from "vitest";
+import {
+  createDaemonChannel,
+  generateKeyPair,
+  exportPublicKey,
+  type Transport,
+} from "@getpaseo/relay/e2ee";
+import { createTaskDeviceTransport } from "@getpaseo/client/internal/task-device-transport";
+import type { DaemonTransportFactory } from "@getpaseo/client/internal/daemon-client-transport-types";
+import { createEncryptedRelaySocket } from "../websocket/encrypted-relay-socket.js";
+import type { SessionAdmission } from "../websocket-server.js";
+import { TaskDeviceAdmission } from "./device-admission.js";
+import { attachEncryptedTaskDevice } from "./device-transport.js";
+
+function fixture() {
+  const binding = { workspaceId: "workspace-a", agentId: "agent-a", generation: "generation-a" };
+  const authority = new TaskDeviceAdmission(
+    "synthetic-host",
+    (b) => b.agentId === binding.agentId && b.generation === binding.generation,
+  );
+  const hostKey = generateKeyPair(),
+    invitation = authority.issueOffer(binding);
+  const wire: string[] = [],
+    admissions: SessionAdmission[] = [],
+    sockets: Array<{ close: () => void }> = [];
+  const baseFactory: DaemonTransportFactory = () => {
+    const client = new EventEmitter(),
+      host = new EventEmitter();
+    let closed = false;
+    const close = () => {
+      if (closed) return;
+      closed = true;
+      client.emit("close", { code: 1000 });
+      host.emit("close", 1000, "");
+    };
+    sockets.push({ close });
+    const hostTransport: Transport = {
+      send: (data) => {
+        wire.push(typeof data === "string" ? data : Buffer.from(data).toString("base64"));
+        queueMicrotask(() => client.emit("message", data, data instanceof ArrayBuffer));
+      },
+      close,
+      onmessage: null,
+      onclose: null,
+      onerror: null,
+    };
+    host.on("close", () => hostTransport.onclose?.(1000, ""));
+    const emitter = new EventEmitter(),
+      pending: Array<string | ArrayBuffer> = [];
+    let attached = false;
+    void createDaemonChannel(hostTransport, hostKey, {
+      onmessage: (data) => {
+        if (attached) emitter.emit("message", data);
+        else pending.push(data);
+      },
+      onclose: (code, reason) => {
+        emitter.emit("close", code, reason);
+        close();
+      },
+    })
+      .then((channel) => {
+        if (closed) {
+          channel.close();
+          return null;
+        }
+        const socket = createEncryptedRelaySocket({
+          channel,
+          emitter,
+          getTransportBufferedAmount: () => 0,
+          terminateTransport: close,
+        });
+        attachEncryptedTaskDevice({
+          socket,
+          metadata: { transport: "relay" },
+          authority,
+          attach: async (admission) => {
+            admissions.push(admission);
+            socket.on("message", (data) => {
+              if (data === "selected-task-plaintext-sentinel") socket.send("selected-task-ack");
+            });
+          },
+        });
+        attached = true;
+        for (const data of pending) emitter.emit("message", data);
+        return null;
+      })
+      .catch(() => close());
+    queueMicrotask(() => client.emit("open"));
+    return {
+      send: (data) => {
+        wire.push(
+          typeof data === "string"
+            ? data
+            : Buffer.from(data instanceof ArrayBuffer ? data : data.buffer).toString("base64"),
+        );
+        queueMicrotask(() =>
+          hostTransport.onmessage?.({ data, isBinary: typeof data !== "string" }),
+        );
+      },
+      close,
+      onOpen: (fn) => {
+        client.on("open", fn);
+        return () => client.off("open", fn);
+      },
+      onMessage: (fn) => {
+        client.on("message", fn);
+        return () => client.off("message", fn);
+      },
+      onClose: (fn) => {
+        client.on("close", fn);
+        return () => client.off("close", fn);
+      },
+      onError: (fn) => {
+        client.on("error", fn);
+        return () => client.off("error", fn);
+      },
+    };
+  };
+  const offer = {
+    v: 3 as const,
+    serverId: "synthetic-host",
+    daemonPublicKeyB64: exportPublicKey(hostKey.publicKey),
+    relay: { endpoint: "unused.test:443", useTls: true },
+    task: binding,
+    invitation,
+  };
+  return {
+    authority,
+    offer,
+    wire,
+    admissions,
+    baseFactory,
+    close: () => {
+      for (const socket of sockets) socket.close();
+      authority.close();
+    },
+  };
+}
+function connect(factory: DaemonTransportFactory) {
+  const transport = factory({ url: "unused://in-memory" });
+  const opened = new Promise<void>((resolve, reject) => {
+    transport.onOpen(resolve);
+    transport.onError(reject);
+    transport.onClose(() => reject(new Error("CLOSED")));
+  });
+  return { transport, opened };
+}
+describe("encrypted task-device transport", () => {
+  test("real E2EE and mobile signing enroll, prove, reconnect without replaying invitation or plaintext", async () => {
+    const f = fixture(),
+      identity = createTaskDeviceTransport({
+        offer: f.offer,
+        clientId: "volatile-phone",
+        baseFactory: f.baseFactory,
+      });
+    try {
+      const first = connect(identity.factory);
+      await first.opened;
+      const response = new Promise<unknown>((resolve) => first.transport.onMessage(resolve));
+      first.transport.send("selected-task-plaintext-sentinel");
+      expect(await response).toBe("selected-task-ack");
+      const deviceId = f.admissions[0].taskScope!.deviceId;
+      expect(f.admissions[0].expectedClientId).toBe("volatile-phone");
+      await identity.disconnect();
+      const second = connect(identity.factory);
+      await second.opened;
+      expect(f.admissions[1].taskScope!.deviceId).toBe(deviceId);
+      expect(f.wire.join("\n")).not.toContain(f.offer.invitation.token);
+      expect(f.wire.join("\n")).not.toContain("selected-task-plaintext-sentinel");
+      second.transport.close();
+      f.authority.revoke(deviceId);
+      await expect(connect(identity.factory).opened).rejects.toThrow();
+    } finally {
+      identity.destroy();
+      f.close();
+    }
+  }, 5000);
+  test("a second phone cannot reuse a consumed invitation", async () => {
+    const f = fixture(),
+      a = createTaskDeviceTransport({
+        offer: f.offer,
+        clientId: "phone-a",
+        baseFactory: f.baseFactory,
+      }),
+      b = createTaskDeviceTransport({
+        offer: f.offer,
+        clientId: "phone-b",
+        baseFactory: f.baseFactory,
+      });
+    try {
+      const first = connect(a.factory);
+      await first.opened;
+      first.transport.close();
+      await expect(connect(b.factory).opened).rejects.toThrow();
+      expect(f.admissions).toHaveLength(1);
+    } finally {
+      a.destroy();
+      b.destroy();
+      f.close();
+    }
+  }, 5000);
+});
diff --git a/packages/server/src/server/authorization/device-transport.ts b/packages/server/src/server/authorization/device-transport.ts

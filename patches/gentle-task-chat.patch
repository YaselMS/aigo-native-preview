+    },
+  });
+  expect(mapper.map(input)).toEqual([]);
+  for (const [status, expected] of [
+    ["completed", "completed"],
+    ["failed", "failed"],
+    ["cancelled", "canceled"],
+    ["timed_out", "failed"],
+  ]) {
+    expect(
+      mapper.map({
+        role: "custom",
+        customType: "gentle-agents.result",
+        details: { gentleAgents: { ...task, status } },
+        content: "Result",
+      })[0],
+    ).toMatchObject({ event: { status: expected } });
+  }
+  expect(
+    mapper.map({
+      role: "custom",
+      customType: "gentle-agents.stale-result",
+      details: { gentleAgents: task },
+      content: "Stale",
+    }),
+  ).toEqual([]);
+});
diff --git a/packages/server/src/server/agent/providers/gentle-live/subagent-mapper.ts b/packages/server/src/server/agent/providers/gentle-live/subagent-mapper.ts
new file mode 100644
index 0000000..8846f66
--- /dev/null
+++ b/packages/server/src/server/agent/providers/gentle-live/subagent-mapper.ts
@@ -0,0 +1,95 @@
+import { z } from "zod";
+import type { AgentStreamEvent } from "../../agent-sdk-types.js";
+
+// Gentle 4.0.0 extensions/gentle-agents.ts taskDetails(), persisted by Pi in
+// subagent tool results and gentle-agents.result custom messages. No text inference,
+// presence listener, child launch authority or invented child session handle.
+const detailsSchema = z.object({
+  gentleAgents: z.object({
+    taskId: z.string().min(1),
+    agent: z.string(),
+    mode: z.string(),
+    cwd: z.string(),
+    status: z.enum([
+      "queued",
+      "running",
+      "waiting",
+      "completed",
+      "failed",
+      "cancelled",
+      "timed_out",
+    ]),
+  }),
+});
+const messageSchema = z.object({
+  role: z.enum(["custom", "toolResult"]),
+  customType: z.string().optional(),
+  toolName: z.string().optional(),
+  details: detailsSchema,
+  content: z.union([z.string(), z.array(z.object({ type: z.literal("text"), text: z.string() }))]),
+});
+const toolNames = new Set([
+  "subagent_run",
+  "subagent_status",
+  "subagent_result",
+  "subagent_continue",
+]);
+
+export class GentleSubagentMapper {
+  private seen = new Set<string>();
+  map(input: unknown): AgentStreamEvent[] {
+    const parsed = messageSchema.safeParse(input);
+    if (!parsed.success) return [];
+    const message = parsed.data;
+    if (
+      message.role === "custom"
+        ? message.customType !== "gentle-agents.result"
+        : !toolNames.has(message.toolName ?? "")
+    )
+      return [];
+    const task = message.details.gentleAgents;
+    const text =
+      typeof message.content === "string"
+        ? message.content
+        : message.content.map((b) => b.text).join("\n");
+    const fingerprint = JSON.stringify([task, text]);
+    if (this.seen.has(fingerprint)) return [];
+    this.seen.add(fingerprint);
+    const statuses = {
+      queued: "running",
+      running: "running",
+      waiting: "running",
+      completed: "completed",
+      failed: "failed",
+      cancelled: "canceled",
+      timed_out: "failed",
+    } as const;
+    const status = statuses[task.status];
+    const id = `gentle:${task.taskId}`;
+    const events: AgentStreamEvent[] = [
+      {
+        type: "provider_subagent",
+        provider: "pi",
+        event: {
+          type: "upsert",
+          id,
+          title: task.agent,
+          cwd: task.cwd,
+          status,
+          subtitle: `${task.mode} · ${task.status}${task.status === "waiting" ? " · answer on PC" : ""}`,
+        },
+      },
+    ];
+    if (text)
+      events.push({
+        type: "provider_subagent",
+        provider: "pi",
+        event: {
+          type: "timeline",
+          id,
+          item: { type: "assistant_message", text },
+        },
+      });
+    return events;
+  }
+}
diff --git a/packages/server/src/server/agent/providers/gentle-live/transport.ts b/packages/server/src/server/agent/providers/gentle-live/transport.ts
new file mode 100644
index 0000000..f7af667
--- /dev/null
+++ b/packages/server/src/server/agent/providers/gentle-live/transport.ts
@@ -0,0 +1,131 @@
+import { readFile } from "node:fs/promises";
+import { createConnection } from "node:net";
+import { isAbsolute, resolve } from "node:path";
+import { z } from "zod";
+
+export const liveBridgeParams = z
+  .object({
+    liveBridge: z
+      .object({
+        descriptorPath: z.string().min(1),
+        allowUnqualifiedLocalIpc: z.literal(true),
+      })
+      .strict(),
+  })
+  .strict();
+
+export const identitySchema = z.object({
+  sessionId: z.string().min(1),
+  generation: z.string().uuid(),
+  pid: z.number().int().positive(),
+});
+export const descriptorSchema = identitySchema.extend({
+  pipe: z.string().regex(/^\\\\\.\\pipe\\aigo-proof-[a-f0-9-]+$/),
+  launchOrigin: z.enum(["aigo-background", "attached-process"]).optional(),
+});
+const choiceSchema = z.object({ label: z.string(), description: z.string(), value: z.string() });
+const questionnaireSchema = z.object({
+  questions: z
+    .array(
+      z.object({
+        question: z.string(),
+        header: z.string(),
+        multiSelect: z.boolean().optional(),
+        options: z
+          .array(
+            z.object({
+              label: z.string(),
+              description: z.string(),
+              preview: z.string().optional(),
+            }),
+          )
+          .min(2)
+          .max(4),
+      }),
+    )
+    .min(1)
+    .max(4),
+});
+export const snapshotSchema = identitySchema.extend({
+  ok: z.literal(true),
+  closed: z.boolean(),
+  sequence: z.number().int().nonnegative(),
+  cwd: z.string().min(1),
+  idle: z.boolean(),
+  messages: z.array(z.object({ id: z.string(), message: z.unknown() })),
+  pending: z.array(
+    z.object({
+      requestId: z.string(),
+      toolCallId: z.string(),
+      params: z.union([
+        z.object({ question: z.string(), options: z.array(choiceSchema).min(2).max(4) }),
+        questionnaireSchema,
+      ]),
+    }),
+  ),
+  events: z.array(
+    z
+      .object({ sequence: z.number().int(), type: z.string(), event: z.unknown().optional() })
+      .passthrough(),
+  ),
+});
+export type LiveIdentity = z.infer<typeof identitySchema>;
+export type LiveDescriptor = z.infer<typeof descriptorSchema>;
+export type LiveSnapshot = z.infer<typeof snapshotSchema>;
+
+export function sameIdentity(a: LiveIdentity, b: LiveIdentity): boolean {
+  return a.sessionId === b.sessionId && a.generation === b.generation && a.pid === b.pid;
+}
+
+export function developmentGate(): void {
+  if (process.env.PASEO_NODE_ENV !== "development")
+    throw new Error(
+      "Live Gentle attachment is limited to the development host until IPC access is qualified.",
+    );
+}
+
+export async function readDescriptor(file: string): Promise<LiveDescriptor> {
+  developmentGate();
+  if (!isAbsolute(file)) throw new Error("Live bridge descriptor must be an absolute path.");
+  return descriptorSchema.parse(JSON.parse(await readFile(file, "utf8")));
+}
+
+export function localRequest(descriptor: LiveDescriptor, message: object): Promise<unknown> {
+  return new Promise((fulfill, reject) => {
+    const socket = createConnection(descriptor.pipe);
+    socket.setEncoding("utf8");
+    socket.setTimeout(5000, () =>
+      socket.destroy(new Error("Live bridge request outcome is uncertain.")),
+    );
+    let data = "";
+    socket.on("error", () =>
+      reject(new Error("Live Gentle connection unavailable; no input was replayed.")),
+    );
+    socket.on("connect", () => socket.end(JSON.stringify(message) + "\n"));
+    socket.on("data", (chunk: string) => {
+      data += chunk;
+      if (data.length > 8 * 1024 * 1024) socket.destroy(new Error("Live snapshot exceeds limit."));
+    });
+    socket.on("end", () => {
+      try {
+        fulfill(JSON.parse(data));
+      } catch {
+        reject(new Error("Invalid live bridge reply."));
+      }
+    });
+  });
+}
+
+export async function readSnapshot(descriptor: LiveDescriptor): Promise<LiveSnapshot> {
+  const snapshot = snapshotSchema.parse(await localRequest(descriptor, { op: "snapshot" }));
+  if (!sameIdentity(descriptor, snapshot))
+    throw new Error("Live bridge incarnation changed; attach explicitly again.");
+  if (snapshot.closed) throw new Error("Live Gentle session is closed.");
+  return snapshot;
+}
+
+export function sameDirectory(a: string, b: string): boolean {
+  const normalize = (value: string) =>
+    process.platform === "win32" ? resolve(value).toLowerCase() : resolve(value);
+  return normalize(a) === normalize(b);
+}

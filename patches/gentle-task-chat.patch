@@ -0,0 +1,90 @@
+import { TaskDeviceClientFrameSchema } from "@getpaseo/protocol/task-device";
+import type { RelaySocketLike } from "../relay-transport.js";
+import type { ExternalSocketMetadata, SessionAdmission } from "../websocket-server.js";
+import type { TaskDeviceAdmission } from "./device-admission.js";
+
+/** Only call with the decrypted socket produced by the existing E2EE channel. */
+export function attachEncryptedTaskDevice(args: {
+  socket: RelaySocketLike;
+  metadata: ExternalSocketMetadata;
+  authority: TaskDeviceAdmission;
+  attach: (admission: SessionAdmission) => Promise<void>;
+}) {
+  const { socket, authority } = args;
+  let state: "identity" | "proof" | "attaching" | "ready" | "closed" = "identity";
+  let deviceId = "",
+    clientId = "",
+    challengeId = "";
+  let lease: ReturnType<typeof setInterval> | undefined;
+  const deadline = setTimeout(() => fail(), 15000);
+  const fail = () => {
+    if (state === "closed") return;
+    state = "closed";
+    clearTimeout(deadline);
+    if (lease) clearInterval(lease);
+    socket.close(1008, "Task device authentication failed");
+  };
+  socket.on("close", () => {
+    state = "closed";
+    clearTimeout(deadline);
+    if (lease) clearInterval(lease);
+  });
+  socket.on("message", (...data) => {
+    if (state === "ready" || state === "closed") return;
+    try {
+      if (state === "attaching") throw new Error("HANDSHAKE_IN_PROGRESS");
+      const raw = data[0];
+      if (typeof raw !== "string" || raw.length > 4096) throw new Error("INVALID_FRAME");
+      const frame = TaskDeviceClientFrameSchema.parse(JSON.parse(raw));
+      if (state === "identity") {
+        if (frame.type === "task_device_proof") throw new Error("IDENTITY_REQUIRED");
+        clientId = frame.clientId;
+        deviceId =
+          frame.type === "task_device_enroll"
+            ? authority.enrollRaw(frame.token, frame.publicKeyB64).deviceId
+            : frame.deviceId;
+        const c = authority.challenge(deviceId, clientId);
+        challengeId = c.id;
+        state = "proof";
+        socket.send(JSON.stringify({ type: "task_device_challenge", ...c }));
+        return;
+      }
+      if (frame.type !== "task_device_proof" || frame.challengeId !== challengeId)
+        throw new Error("PROOF_REQUIRED");
+      const scope = authority.authenticate(challengeId, deviceId, clientId, frame.signature);
+      state = "attaching";
+      void args
+        .attach({
+          expectedClientId: clientId,
+          principalId: `task-device:${deviceId}`,
+          permissions: ["workspace.read", "workspace.write"],
+          taskScope: scope,
+        })
+        .then(() => {
+          if (state === "closed") return null;
+          state = "ready";
+          clearTimeout(deadline);
+          lease = setInterval(() => {
+            if (!scope.isActive()) fail();
+          }, 1000);
+          lease.unref();
+          socket.send(
+            JSON.stringify({
+              type: "task_device_ready",
+              deviceId,
+              expiresAt: authority.expiresAt(deviceId),
+              binding: {
+                workspaceId: scope.workspaceId,
+                agentId: scope.agentId,
+                generation: scope.generation,
+              },
+            }),
+          );
+          return null;
+        })
+        .catch(fail);
+    } catch {
+      fail();
+    }
+  });
+}

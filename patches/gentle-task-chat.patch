+import { createServer } from "node:net";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { randomUUID } from "node:crypto";
+import { afterEach, expect, onTestFinished, test, vi } from "vitest";
+import { GentleLiveAgentClient, nativeTurnFailure } from "./agent.js";
+import {
+  descriptorSchema,
+  liveBridgeParams,
+  sameIdentity,
+  type LiveSnapshot,
+} from "./transport.js";
+import type { AgentStreamEvent } from "../../agent-sdk-types.js";
+
+afterEach(() => vi.unstubAllEnvs());
+async function fixture() {
+  vi.stubEnv("PASEO_NODE_ENV", "development");
+  const cwd = await mkdtemp(path.join(tmpdir(), "gentle-live-"));
+  const descriptorPath = path.join(cwd, "descriptor.json");
+  const identity = { sessionId: randomUUID(), generation: randomUUID(), pid: process.pid };
+  const descriptor = { ...identity, pipe: `\\\\.\\pipe\\aigo-proof-${randomUUID()}` };
+  const snapshot: LiveSnapshot = {
+    ...identity,
+    ok: true,
+    cwd,
+    closed: false,
+    idle: false,
+    sequence: 1,
+    messages: [{ id: "user-entry", message: { role: "user", content: "Original task" } }],
+    pending: [
+      {
+        requestId: "question",
+        toolCallId: "choice",
+        params: {
+          question: "Pick one",
+          options: [
+            { label: "Same", description: "first", value: "opaque-a" },
+            { label: "Same", description: "second", value: "opaque-b" },
+          ],
+        },
+      },
+    ],
+    events: [],
+  };
+  const sent: Record<string, unknown>[] = [];
+  let resolutions = 0;
+  const receipts = new Map<string, object>();
+  const server = createServer((socket) => {
+    socket.setEncoding("utf8");
+    let data = "";
+    socket.on("data", (chunk) => {
+      data += chunk;
+      if (!data.includes("\n")) return;
+      const m = JSON.parse(data) as Record<string, unknown>;
+      sent.push(m);
+      if (m.op === "snapshot") {
+        socket.end(JSON.stringify(snapshot) + "\n");
+        return;
+      }
+      if (m.generation !== identity.generation) {
+        socket.end('{"ok":false,"error":"stale_identity"}\n');
+        return;
+      }
+      if (m.op === "answer") {
+        const old = receipts.get(String(m.answerId));
+        if (old) {
+          socket.end(JSON.stringify(old) + "\n");
+          return;
+        }
+        if (!snapshot.pending.length) {
+          socket.end('{"ok":false,"error":"already_resolved"}\n');
+          return;
+        }
+        resolutions++;
+        if (m.cancel === true)
+          snapshot.events.push({
+            sequence: ++snapshot.sequence,
+            type: "question_resolved",
+            requestId: m.requestId,
+            result: { cancelled: true },
+          });
+        snapshot.pending = [];
+        snapshot.idle = true;
+        const reply = { ok: true };
+        receipts.set(String(m.answerId), reply);
+        socket.end(JSON.stringify(reply) + "\n");
+        return;
+      }
+      socket.end('{"ok":true}\n');
+    });
+  });
+  await new Promise<void>((resolve) => server.listen(descriptor.pipe, resolve));
+  await writeFile(descriptorPath, JSON.stringify(descriptor));
+  const client = new GentleLiveAgentClient({
+    liveBridge: { descriptorPath, allowUnqualifiedLocalIpc: true },
+  });
+  onTestFinished(async () => {
+    await client.shutdown();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+    await rm(cwd, { recursive: true, force: true });
+  });
+  return {
+    client,
+    descriptor,
+    descriptorPath,
+    snapshot,
+    cwd,
+    sent,
+    resolutions: () => resolutions,
+  };
+}
+
+test("requires explicit local-development opt-in and rejects non-pipe descriptors", () => {
+  expect(() => liveBridgeParams.parse({ liveBridge: { descriptorPath: "x" } })).toThrow();
+  expect(() =>
+    descriptorSchema.parse({
+      sessionId: "s",
+      generation: randomUUID(),
+      pid: 1,
+      pipe: "tcp://host",
+    }),
+  ).toThrow();
+});
+

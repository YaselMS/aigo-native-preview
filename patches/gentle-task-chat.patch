+      this.schedule();
+    }
+  }
+  async *streamHistory() {
+    for (const event of this.history) yield event;
+  }
+  async getRuntimeInfo() {
+    return {
+      provider: this.provider,
+      sessionId: this.id,
+      model: "attached-live",
+      extra: {
+        pid: this.identity.pid,
+        generation: this.identity.generation,
+        attachment: "live",
+        connection: this.connection,
+        launchOrigin: this.identity.launchOrigin ?? "attached-process",
+      },
+    };
+  }
+  async getAvailableModes() {
+    return [];
+  }
+  async getCurrentMode() {
+    return null;
+  }
+  async setMode() {
+    throw new Error("Change the mode in the original Gentle session.");
+  }
+  getPendingPermissions() {
+    return [...this.pending.values()];
+  }
+  private async send(message: object) {
+    if (this.detached) throw new Error("Live attachment is detached; attach explicitly again.");
+    const descriptor = await readDescriptor(this.descriptorPath);
+    if (!sameIdentity(this.identity, descriptor))
+      throw new Error("Stale live session; answer was not sent.");
+    const reply = replySchema.parse(
+      await localRequest(this.identity, {
+        ...message,
+        sessionId: this.id,
+        generation: this.identity.generation,
+      }),
+    );
+    if (!reply.ok) throw new Error(`Live Gentle rejected input: ${reply.error ?? "unknown"}`);
+  }
+  async respondToPermission(id: string, response: AgentPermissionResponse) {

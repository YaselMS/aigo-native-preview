+  const failure = nativeTurnFailure({
+    role: "assistant",
+    stopReason: "error",
+    errorMessage: "OAuth auth derivation failed: Cannot find module X:/private/runtime.js",
+  });
+  expect(failure).toContain("local Pi runtime");

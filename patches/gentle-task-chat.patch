+      (r) => publicPermissionId(this.identity, r.requestId) === id,
+    );
+    if (!request) throw new Error("Question is no longer pending.");
+    if (response.behavior === "deny") {
+      await this.send({
+        op: "answer",
+        requestId: request.requestId,
+        answerId: `aigo:${id}`,
+        cancel: true,
+      });
+      return;
+    }
+    if ("questions" in request.params) {
+      const answers = z
+        .array(
+          z
+            .object({
+              questionIndex: z.number().int().nonnegative(),
+              optionIndices: z.array(z.number().int().nonnegative()).optional(),
+              custom: z.string().max(4096).optional(),
+            })
+            .strict(),
+        )
+        .length(request.params.questions.length)
+        .parse(response.updatedInput?.answerDetails);
+      await this.send({
+        op: "answer",
+        requestId: request.requestId,
+        answerId: `aigo:${id}`,
+        answers,
+      });
+      return;
+    }
+    const answers = response.updatedInput?.answers;
+    const value =
+      typeof answers === "object" && answers !== null
+        ? Reflect.get(answers, "Response")
+        : undefined;
+    if (typeof value !== "string" || !request.params.options.some((o) => o.value === value))
+      throw new Error("Select an exact option using the updated AiGo client.");
+    await this.send({
+      op: "answer",
+      requestId: request.requestId,
+      answerId: `aigo:${id}`,
+      optionValue: value,
+    });
+    // Host polling reconciles both remote and competing local answers. No optimistic dismissal.
+  }
+  async startTurn(prompt: AgentPromptInput, options?: AgentRunOptions) {
+    if (typeof prompt !== "string" || !prompt.trim())
+      throw new Error("Live Gentle currently accepts text messages only.");
+    const turnId = randomUUID();
+    this.turnId = turnId;
+    if (options?.clientMessageId)
+      this.submittedEcho = { text: prompt, clientMessageId: options.clientMessageId, turnId };
+    await this.send({ op: "prompt", promptId: options?.clientMessageId ?? turnId, text: prompt });
+    return { turnId };
+  }
+  async run(prompt: AgentPromptInput, options?: AgentRunOptions): Promise<AgentRunResult> {
+    let unsubscribe = () => {};
+    const completion = new Promise<AgentRunResult>((fulfill, reject) => {
+      unsubscribe = this.subscribe((event) => {
+        if (event.type === "turn_completed")
+          fulfill({
+            sessionId: this.id,
+            finalText: "",
+            timeline: this.history.flatMap((e) => (e.type === "timeline" ? [e.item] : [])),
+          });
+        if (event.type === "turn_failed") reject(new Error(event.error));
+      });
+    });
+    try {
+      await this.startTurn(prompt, options);
+      return await completion;
+    } finally {
+      unsubscribe();
+    }
+  }
+  describePersistence(): AgentPersistenceHandle {
+    return {
+      provider: this.provider,
+      sessionId: this.id,
+      nativeHandle: `${this.id}:${this.identity.generation}`,
+      metadata: { config: this.config },
+    };
+  }
+  async interrupt() {
+    await this.send({ op: "abort" });
+    const deadline = Date.now() + 5000;
+    while (Date.now() < deadline) {
+      if ((await readSnapshot(this.identity)).idle) return;
+      await new Promise((resolve) => setTimeout(resolve, 50));
+    }
+    throw new Error("Original Gentle turn cancellation is uncertain.");
+  }
+  async close() {
+    this.detached = true;
+    if (this.connection !== "stale") this.connection = "detached";
+    if (this.timer) clearTimeout(this.timer);
+    this.listeners.clear();
+  }
+}

+import { afterEach, describe, expect, test } from "vitest";
+import { generateKeyPair, exportPublicKey } from "@getpaseo/relay/e2ee";
+import {
+  getTaskChatSession,
+  clearTaskChatSession,
+  prepareTaskOffer,
+  routeTaskOfferUrl,
+  subscribeTaskChatSession,
+} from "./session";
+import type { TaskConnectionOffer } from "@getpaseo/protocol/connection-offer";
+
+function offer(): TaskConnectionOffer {
+  return {
+    v: 3,
+    serverId: "synthetic-host",
+    daemonPublicKeyB64: exportPublicKey(generateKeyPair().publicKey),
+    relay: { endpoint: "relay.invalid:443", useTls: true },
+    task: { workspaceId: "workspace-a", agentId: "agent-a", generation: "g-a" },
+    invitation: {
+      token: "synthetic-invitation-token-for-unit-test-only",
+      expiresAt: Date.now() + 60000,
+    },
+  };
+}
+afterEach(() => {
+  const session = getTaskChatSession();
+  if (session) clearTaskChatSession(session);
+});
+describe("volatile task pairing entry", () => {
+  test("duplicate delivery reuses the idle identity and never submits an initial prompt", () => {
+    const link = offer(),
+      a = prepareTaskOffer(link),
+      b = prepareTaskOffer({ ...link, task: { ...link.task } });
+    expect(b).toBe(a);
+    expect(a.getSnapshot()).toMatchObject({
+      connection: "idle",
+      entries: [],
+      agent: null,
+      busy: false,
+    });
+    expect(JSON.stringify(a.getSnapshot())).not.toContain(link.invitation.token);
+  });
+  test("replacing a task notifies the screen and old cleanup cannot remove the new task", () => {
+    let changes = 0;
+    const unsubscribe = subscribeTaskChatSession(() => changes++);
+    try {
+      const a = prepareTaskOffer(offer()),
+        next = offer();
+      next.task = { ...next.task, agentId: "agent-b" };
+      next.invitation.token += "-second";
+      const b = prepareTaskOffer(next);
+      expect(b.viewId).not.toBe(a.viewId);
+      clearTaskChatSession(a);
+      expect(getTaskChatSession()).toBe(b);
+      expect(changes).toBe(2);
+      clearTaskChatSession(b);
+      expect(getTaskChatSession()).toBeNull();
+      expect(changes).toBe(3);
+    } finally {
+      unsubscribe();
+    }
+  });
+  test("expired and non-TLS remote invitations fail before creating a session", () => {
+    const expired = offer();
+    expired.invitation.expiresAt = Date.now() - 1;
+    expect(() => prepareTaskOffer(expired)).toThrow(/expired/);
+    const insecure = offer();
+    insecure.relay.useTls = false;
+    expect(() => prepareTaskOffer(insecure)).toThrow(/TLS/);
+    expect(getTaskChatSession()).toBeNull();
+  });
+  test("v3 links use volatile entry; v2 remains outside it", () => {
+    const link = offer(),
+      url = (value: unknown) =>
+        `https://app.paseo.sh/#offer=${Buffer.from(JSON.stringify(value)).toString("base64url")}`;
+    expect(routeTaskOfferUrl(url({ ...link, v: 2 }))).toBe(false);
+    expect(getTaskChatSession()).toBeNull();
+    expect(routeTaskOfferUrl(url(link))).toBe(true);
+    expect(getTaskChatSession()?.task.agentId).toBe("agent-a");
+  });
+});

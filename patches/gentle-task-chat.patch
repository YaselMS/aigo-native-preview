@@ -0,0 +1,94 @@
+import type { TaskPairingStatus } from "@getpaseo/protocol/messages";
+import type { TaskBinding, TaskDeviceAdmission } from "./device-admission.js";
+
+type SelectedTask = TaskBinding & { title: string };
+/** Explicit local-owner control. No persistence and no networking until enable. */
+export class TaskPairingController {
+  static optional(
+    authority: TaskDeviceAdmission | undefined,
+    getSelected: (() => SelectedTask | null) | undefined,
+    setRelayEnabled: (enabled: boolean) => void,
+  ): TaskPairingController | undefined {
+    if (!authority || !getSelected) return undefined;
+    return new TaskPairingController({
+      getSelected,
+      setRelayEnabled,
+      revokeAll: () => authority.close(),
+    });
+  }
+  private selected: SelectedTask | null = null;
+  private deadline = 0;
+  private timer: ReturnType<typeof setTimeout> | undefined;
+  constructor(
+    private readonly dependencies: {
+      getSelected: () => SelectedTask | null;
+      setRelayEnabled: (enabled: boolean) => void;
+      revokeAll: () => void;
+      now?: () => number;
+    },
+  ) {}
+  private now() {
+    return this.dependencies.now?.() ?? Date.now();
+  }
+  status(): TaskPairingStatus {
+    const current = this.dependencies.getSelected();
+    if (
+      this.deadline &&
+      (this.deadline <= this.now() ||
+        !current ||
+        current.agentId !== this.selected?.agentId ||
+        current.workspaceId !== this.selected.workspaceId ||
+        current.generation !== this.selected.generation)
+    )
+      this.disable();
+    return {
+      enabled: this.deadline > this.now(),
+      expiresAt: this.deadline || null,
+      task: current
+        ? { agentId: current.agentId, workspaceId: current.workspaceId, title: current.title }
+        : null,
+      durationSeconds: 3600,
+    };
+  }
+  enable(): TaskPairingStatus {
+    if (this.status().enabled) return this.status();
+    const selected = this.dependencies.getSelected();
+    if (!selected) throw new Error("TASK_PAIRING_NO_LIVE_TASK");
+    this.selected = { ...selected };
+    this.deadline = this.now() + 3_600_000;
+    try {
+      this.dependencies.setRelayEnabled(true);
+    } catch {
+      this.disable();
+      throw new Error("TASK_PAIRING_RELAY_UNAVAILABLE");
+    }
+    this.timer = setTimeout(() => this.disable(), 3_600_000);
+    this.timer.unref?.();
+    return this.status();
+  }
+  binding(): TaskBinding {
+    if (!this.status().enabled || !this.selected) throw new Error("TASK_PAIRING_DISABLED");
+    return {
+      agentId: this.selected.agentId,
+      workspaceId: this.selected.workspaceId,
+      generation: this.selected.generation,
+    };
+  }
+  disable(): TaskPairingStatus {
+    if (this.timer) clearTimeout(this.timer);
+    this.timer = undefined;
+    this.deadline = 0;
+    this.selected = null;
+    this.dependencies.revokeAll();
+    this.dependencies.setRelayEnabled(false);
+    const current = this.dependencies.getSelected();
+    return {
+      enabled: false,
+      expiresAt: null,
+      durationSeconds: 3600,
+      task: current
+        ? { agentId: current.agentId, workspaceId: current.workspaceId, title: current.title }
+        : null,
+    };
+  }
+}

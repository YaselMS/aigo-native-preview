@@ -0,0 +1,180 @@
+import { generateKeyPairSync, sign } from "node:crypto";
+import { describe, expect, test } from "vitest";
+import { TaskDeviceAdmission } from "./device-admission.js";
+import { SessionAuthorization, OWNER_PERMISSIONS } from "./index.js";
+import {
+  SessionInboundMessageSchema,
+  SessionOutboundMessageSchema,
+  type SessionInboundMessage,
+  type SessionOutboundMessage,
+} from "../messages.js";
+
+function fixture() {
+  let now = 1000000,
+    current = true;
+  const binding = { workspaceId: "workspace-a", agentId: "agent-a", generation: "generation-a" };
+  const host = new TaskDeviceAdmission(
+    "synthetic-server",
+    (b) =>
+      current &&
+      b.workspaceId === binding.workspaceId &&
+      b.agentId === binding.agentId &&
+      b.generation === binding.generation,
+    () => now,
+  );
+  const keys = generateKeyPairSync("ed25519");
+  const offer = host.issueOffer(binding);
+  const device = host.enroll(
+    offer.token,
+    keys.publicKey.export({ type: "spki", format: "pem" }).toString(),
+  );
+  const prove = () => {
+    const c = host.challenge(device.deviceId, "phone-a");
+    const signature = sign(null, Buffer.from(c.payload), keys.privateKey).toString("base64url");
+    return {
+      c,
+      signature,
+      scope: () => host.authenticate(c.id, device.deviceId, "phone-a", signature),
+    };
+  };
+  return {
+    host,
+    binding,
+    offer,
+    device,
+    keys,
+    prove,
+    advance: (ms: number) => (now += ms),
+    changeGeneration: () => (current = false),
+  };
+}
+describe("in-memory task device admission (synthetic keys only)", () => {
+  test("unpaired, mismatched identity and replay cannot authenticate; reconnect needs a new proof", () => {
+    const f = fixture();
+    expect(() => f.host.challenge("unpaired", "phone-a")).toThrow("DEVICE_ACCESS_DENIED");
+    const a = f.prove();
+    expect(() =>
+      f.host.authenticate(a.c.id, f.device.deviceId, "another-phone", a.signature),
+    ).toThrow("DEVICE_ACCESS_DENIED");
+    expect(a.scope).toThrow("DEVICE_ACCESS_DENIED");
+    const b = f.prove();
+    expect(b.scope().agentId).toBe("agent-a");
+    expect(b.scope).toThrow("DEVICE_ACCESS_DENIED");
+    expect(f.prove().scope().isActive()).toBe(true);
+  });
+  test("invalid signature consumes challenge and another device key is rejected", () => {
+    const f = fixture(),
+      a = f.prove(),
+      other = generateKeyPairSync("ed25519");
+    const bad = sign(null, Buffer.from(a.c.payload), other.privateKey).toString("base64url");
+    expect(() => f.host.authenticate(a.c.id, f.device.deviceId, "phone-a", bad)).toThrow(
+      "DEVICE_ACCESS_DENIED",
+    );
+    expect(a.scope).toThrow("DEVICE_ACCESS_DENIED");
+  });
+  test("offers are single use and expired offers/challenges fail", () => {
+    const f = fixture(),
+      publicKey = f.keys.publicKey.export({ type: "spki", format: "pem" }).toString();
+    expect(() => f.host.enroll(f.offer.token, publicKey)).toThrow("PAIRING_OFFER_INVALID");
+    const second = f.host.issueOffer(f.binding),
+      c = f.prove();
+    f.advance(120001);
+    expect(c.scope).toThrow("DEVICE_ACCESS_DENIED");
+    expect(() => f.host.enroll(second.token, publicKey)).toThrow("PAIRING_OFFER_INVALID");
+  });
+  test("revocation, generation change, expiry and shutdown invalidate already-open authority", () => {
+    for (const mode of ["revoke", "generation", "expire", "close"]) {
+      const f = fixture(),
+        scope = f.prove().scope();
+      expect(scope.isActive()).toBe(true);
+      if (mode === "revoke") f.host.revoke(f.device.deviceId);
+      if (mode === "generation") f.changeGeneration();
+      if (mode === "expire") f.advance(3600001);
+      if (mode === "close") f.host.close();
+      expect(scope.isActive()).toBe(false);
+      const auth = new SessionAuthorization(OWNER_PERMISSIONS, scope);
+      expect(
+        auth.allowsInbound({ type: "fetch_agent_request", agentId: "agent-a", requestId: "r" }),
+      ).toBe(false);
+    }
+  });
+  test("scoped authority allows exact chat only; permissions cannot widen it", () => {
+    const f = fixture(),
+      auth = new SessionAuthorization(["workspace.read", "workspace.write"], f.prove().scope());
+    expect(
+      auth.allowsInbound({ type: "fetch_agent_request", agentId: "agent-a", requestId: "r" }),
+    ).toBe(true);
+    expect(
+      auth.allowsInbound({ type: "fetch_agent_request", agentId: "agent-b", requestId: "r" }),
+    ).toBe(false);
+    expect(
+      auth.allowsInbound({ type: "fetch_agent_request", agentId: "agent", requestId: "r" }),
+    ).toBe(false);
+    expect(
+      auth.allowsInbound({
+        type: "agent.timeline.set_subscription.request",
+        agentIds: ["agent-a", "agent-b"],
+        requestId: "r",
+      }),
+    ).toBe(false);
+    auth.replacePermissions(OWNER_PERMISSIONS);
+    for (const type of [
+      "file_explorer_request",
+      "file_download_token_request",
+      "create_terminal_request",
+      "checkout_push_request",
+      "fetch_agents_request",
+      "fetch_workspaces_request",
+      "create_agent_request",
+      "daemon.get_pairing_offer.request",
+    ] as const)
+      expect(auth.allowsInbound({ type, agentId: "agent-a" } as SessionInboundMessage), type).toBe(
+        false,
+      );
+    expect(auth.allowsPermission("workspace.write")).toBe(false);
+    expect(auth.allowsBinary()).toBe(false);
+  });
+  test("outbound scope denies foreign observations, lists, project placement and unknown types", () => {
+    const f = fixture(),
+      auth = new SessionAuthorization(OWNER_PERMISSIONS, f.prove().scope());
+    const outbound = (message: unknown) => auth.allowsOutbound(message as SessionOutboundMessage);
+    expect(
+      outbound({
+        type: "agent_status",
+        payload: { agentId: "agent-a", info: { id: "agent-a", workspaceId: "workspace-a" } },
+      }),
+    ).toBe(true);
+    expect(outbound({ type: "agent_status", payload: { agentId: "agent-b" } })).toBe(false);
+    expect(
+      outbound({
+        type: "fetch_agent_response",
+        payload: { agent: { id: "agent-a", workspaceId: "workspace-b" } },
+      }),
+    ).toBe(false);
+    expect(
+      outbound({
+        type: "fetch_agent_response",
+        payload: {
+          agent: { id: "agent-a", workspaceId: "workspace-a" },
+          project: { projectKey: "private" },
+        },
+      }),
+    ).toBe(false);
+    expect(
+      outbound({
+        type: "fetch_agent_response",
+        payload: { agent: { id: "agent-a", workspaceId: "workspace-a" }, project: null },
+      }),
+    ).toBe(true);
+    for (const schema of SessionInboundMessageSchema.options)
+      expect(auth.allowsInbound({ type: schema.shape.type.value } as SessionInboundMessage)).toBe(
+        false,
+      );
+    for (const schema of SessionOutboundMessageSchema.options)
+      expect(
+        outbound({ type: schema.shape.type.value, payload: {} }),
+        schema.shape.type.value,
+      ).toBe(false);
+    expect(outbound({ type: "rpc_error", payload: { code: "access_denied" } })).toBe(true);
+  });
+});
diff --git a/packages/server/src/server/authorization/device-admission.ts b/packages/server/src/server/authorization/device-admission.ts
new file mode 100644
index 0000000..eefe3e7
--- /dev/null
+++ b/packages/server/src/server/authorization/device-admission.ts
@@ -0,0 +1,163 @@
+import { createHash, createPublicKey, randomBytes, randomUUID, verify } from "node:crypto";
+import type { TaskChatScope } from "./task-scope.js";
+
+export interface TaskBinding {
+  workspaceId: string;
+  agentId: string;
+  generation: string;
+}
+interface DeviceRecord {
+  binding: Readonly<TaskBinding>;
+  publicKey: string;
+  expiresAt: number;
+  revoked: boolean;
+}
+export interface DeviceChallenge {
+  id: string;
+  deviceId: string;
+  clientId: string;
+  expiresAt: number;
+  payload: string;
+}
+
+/** In-memory protocol engine. No file, credential-store or network side effects.
+ * Enrollment is deliberately not enabled by bootstrap or the normal launcher.
+ * A future authorized host must persist/revoke grants and deliver this exchange
+ * only inside its authenticated encrypted transport, before creating a Session.
+ */
+export class TaskDeviceAdmission {
+  private offers = new Map<string, { binding: Readonly<TaskBinding>; expiresAt: number }>();
+  private devices = new Map<string, DeviceRecord>();
+  private challenges = new Map<string, DeviceChallenge>();
+  constructor(
+    private readonly serverId: string,
+    private readonly bindingIsCurrent: (binding: Readonly<TaskBinding>) => boolean,
+    private readonly now: () => number = Date.now,
+  ) {}
+
+  private prune() {
+    for (const [id, item] of this.offers) if (item.expiresAt <= this.now()) this.offers.delete(id);
+    for (const [id, item] of this.challenges)
+      if (item.expiresAt <= this.now()) this.challenges.delete(id);
+  }
+  issueOffer(binding: TaskBinding): { token: string; expiresAt: number } {
+    this.prune();
+    if (
+      !binding.workspaceId ||
+      !binding.agentId ||
+      !binding.generation ||
+      !this.bindingIsCurrent(binding)
+    )
+      throw new Error("PAIRING_SCOPE_UNAVAILABLE");
+    if (this.offers.size >= 32) throw new Error("PAIRING_OFFER_LIMIT");
+    const token = randomBytes(32).toString("base64url"),
+      expiresAt = this.now() + 120000;
+    this.offers.set(this.digest(token), { binding: Object.freeze({ ...binding }), expiresAt });
+    return { token, expiresAt };
+  }
+  enroll(token: string, publicKey: string): { deviceId: string; expiresAt: number } {
+    this.prune();
+    const hash = this.digest(token),
+      offer = this.offers.get(hash);
+    this.offers.delete(hash); // An invitation is consumed even on a failed exchange.
+    if (!offer || !this.bindingIsCurrent(offer.binding)) throw new Error("PAIRING_OFFER_INVALID");
+    if (this.devices.size >= 32 || publicKey.length > 1024) throw new Error("PAIRING_DEVICE_LIMIT");
+    const parsed = createPublicKey(publicKey);
+    if (parsed.asymmetricKeyType !== "ed25519") throw new Error("PAIRING_DEVICE_KEY_INVALID");
+    const deviceId = randomUUID(),
+      expiresAt = this.now() + 3600000;
+    this.devices.set(deviceId, {
+      binding: offer.binding,
+      publicKey: parsed.export({ type: "spki", format: "pem" }).toString(),
+      expiresAt,
+      revoked: false,
+    });
+    return { deviceId, expiresAt };
+  }
+  enrollRaw(token: string, publicKeyB64: string) {
+    const key = Buffer.from(publicKeyB64, "base64");
+    if (key.length !== 32 || key.toString("base64") !== publicKeyB64)
+      throw new Error("PAIRING_DEVICE_KEY_INVALID");
+    const pem = createPublicKey({
+      key: Buffer.concat([Buffer.from("302a300506032b6570032100", "hex"), key]),
+      format: "der",
+      type: "spki",
+    })
+      .export({ type: "spki", format: "pem" })
+      .toString();
+    return this.enroll(token, pem);
+  }
+  expiresAt(deviceId: string): number {
+    return this.devices.get(deviceId)?.expiresAt ?? 0;
+  }
+  challenge(deviceId: string, clientId: string): DeviceChallenge {
+    this.prune();
+    if (!clientId || clientId.length > 256 || !this.active(deviceId))
+      throw new Error("DEVICE_ACCESS_DENIED");
+    if (this.challenges.size >= 64) throw new Error("DEVICE_CHALLENGE_LIMIT");
+    const id = randomUUID(),
+      expiresAt = this.now() + 30000;
+    const payload = JSON.stringify([
+      "aigo-task-device-v1",
+      this.serverId,
+      deviceId,
+      clientId,
+      id,
+      randomBytes(32).toString("base64url"),
+      expiresAt,
+    ]);
+    const challenge = Object.freeze({ id, deviceId, clientId, expiresAt, payload });
+    this.challenges.set(id, challenge);
+    return challenge;
+  }
+  authenticate(
+    challengeId: string,
+    deviceId: string,
+    clientId: string,
+    signature: string,
+  ): TaskChatScope {
+    this.prune();
+    const challenge = this.challenges.get(challengeId);
+    this.challenges.delete(challengeId); // No signature or connection replay.
+    const device = this.devices.get(deviceId);
+    if (
+      !challenge ||
+      challenge.deviceId !== deviceId ||
+      challenge.clientId !== clientId ||
+      !device ||
+      !this.active(deviceId) ||
+      signature.length > 128 ||
+      !verify(
+        null,
+        Buffer.from(challenge.payload),
+        device.publicKey,
+        Buffer.from(signature, "base64url"),
+      )
+    )
+      throw new Error("DEVICE_ACCESS_DENIED");
+    return Object.freeze({ ...device.binding, deviceId, isActive: () => this.active(deviceId) });
+  }
+  revoke(deviceId: string): void {
+    const device = this.devices.get(deviceId);
+    if (device) device.revoked = true;
+    for (const [id, item] of this.challenges)
+      if (item.deviceId === deviceId) this.challenges.delete(id);
+  }
+  close(): void {
+    this.offers.clear();
+    this.devices.clear();
+    this.challenges.clear();
+  }
+  private active(deviceId: string): boolean {
+    const device = this.devices.get(deviceId);
+    return (
+      !!device &&
+      !device.revoked &&
+      device.expiresAt > this.now() &&
+      this.bindingIsCurrent(device.binding)
+    );
+  }
+  private digest(value: string): string {
+    return createHash("sha256").update(value).digest("hex");
+  }
+}

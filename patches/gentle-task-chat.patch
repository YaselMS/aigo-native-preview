+          isDefault: true,
+        },
+      ],
+      modes: [],
+    };
+  }
+  async listImportableSessions(options?: { cwd?: string; limit?: number }) {
+    const { descriptor, snapshot } = await this.current();
+    if (options?.cwd && !sameDirectory(options.cwd, snapshot.cwd)) return [];
+    const firstPrompt = snapshot.messages
+      .map((entry) => entry.message as PiAgentMessage)
+      .find((message) => message.role === "user");
+    const preview =
+      firstPrompt && firstPrompt.role === "user"
+        ? getUserMessageText(firstPrompt.content)
+        : "Gentle Shell task";
+    let status = snapshot.idle ? "Ready" : "Running";
+    if (snapshot.pending.length) status = "Waiting for your answer";
+    return [
+      {
+        providerHandleId: `${descriptor.sessionId}:${descriptor.generation}`,
+        cwd: snapshot.cwd,
+        title: `${descriptor.launchOrigin === "aigo-background" ? "AiGo-started session (background)" : "Live Gentle Shell"} · ${hostname()} · PID ${descriptor.pid}`,
+        firstPromptPreview: preview.slice(0, 160),
+        lastPromptPreview: `${status} · Session ${descriptor.sessionId.slice(0, 12)} · ${preview.slice(0, 120)}`,
+        lastActivityAt: new Date(),
